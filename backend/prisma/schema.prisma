generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Pooler de transacciones de Supabase (puerto 6543, IPv4) — la usa la app en tiempo de ejecución.
  // No usamos la conexión directa (db.xxxxx.supabase.co): esa solo tiene IPv6 en el tier
  // gratuito y no era alcanzable desde esta red.
  url       = env("DATABASE_URL")
  // Pooler de sesión (puerto 5432, IPv4) — el que necesitan las migraciones de Prisma.
  directUrl = env("DIRECT_URL")
  // NOTA: la extensión `vector` se habilitó a mano con `prisma db execute` (ver decisión RAG,
  // 2026-07-17), no vía `extensions = [...]` aquí — Supabase ya trae varias extensiones propias
  // preinstaladas (pgcrypto, uuid-ossp, pg_stat_statements, supabase_vault) que Prisma no gestiona;
  // declarar `extensions` activa el preview feature postgresqlExtensions y hace que Prisma detecte
  // esas extensiones ajenas como "drift" y pida resetear la base de datos entera. Mejor no declararla.
}

enum Lethality {
  BAJA
  MEDIA
  ALTA
}

/// docs/14-combate-y-muerte.md § 1. CONVALECIENTE != MUERTO: convaleciente es "fuera de la acción
/// actual" (inconsciente, inmovilizado) pero recuperable sin la Entidad; MUERTO dispara § 4.
/// Renombrado desde INCAPACITADO (2026-08-17, petición explícita, "cambiar INCAPACITADO a
/// CONVALECIENTE") — mismo valor semántico, solo cambia el nombre. Ortografía corregida a
/// CONVALECIENTE (con N): "combaleciente" no es una palabra real en castellano.
enum CondicionFisica {
  ILESO
  HERIDO
  GRAVE
  CONVALECIENTE
  MUERTO
}

/// docs/14-combate-y-muerte.md § 4.2 — elegida al crear la partida, determina el límite de
/// muertes antes del fin de partida real (ver limiteMuertes() en services/death.ts).
enum Dificultad {
  NOVATO
  MEDIO
  AVANZADO
}

enum LogChannel {
  CHARACTER
  WORLD
  // Log que podremos alternar con el de mundo, siendo posible revisar o uno u otro, nunca los dos a la vez
  KINGDOM
}

/// Decisión de producto 2 (02-decisiones.md): sin login real por ahora,
/// pero la tabla existe desde ya para no remodelar `Save` cuando se añada auth de verdad.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  saves Save[]
}

/// Plantilla de mundo del catálogo (distinta de la instancia jugada — ver WorldState).
model World {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  tagline   String
  synopsis  String
  tone      String
  lethality Lethality
  /// Tema de color por mundo (accent300-600, accent2 300-600) — mismo shape que WorldTheme en el frontend.
  theme     Json
  createdAt DateTime  @default(now())

  saves            Save[]
  loreChunks       LoreChunk[]
  locations        Location[]
  npcs             Npc[]
  itemCatalog      ItemCatalog[]
  harvestYields    HarvestYield[]
  imagePrompts     ImagePrompt[]
  worldPopulations WorldPopulation[]
  factionCatalog   Faction[]
  historiaEntries  HistoriaEntry[]
  factionBuildings FactionBuilding[]
}

/// Una partida: mundo elegido + personaje (copia editable, no referencia viva a la plantilla) + su WorldState.
model Save {
  id                      String  @id @default(cuid())
  userId                  String
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldId                 String
  world                   World   @relation(fields: [worldId], references: [id])
  /// Id suelto (String, sin FK real) del personaje pregenerado que el FRONTEND ofreció al crear —
  /// referencia su propia lista hardcodeada (`frontend/src/data/mock.ts`), nunca la tabla
  /// `PregeneratedCharacter` que existió en este schema (quitada en la auditoría de elementos
  /// desconectados, 2026-08-23: cero filas sembradas, cero consumidores). Se escribe al crear la
  /// partida, nunca se vuelve a leer.
  pregeneratedCharacterId String?

  characterName       String
  /// Nombre editable de la partida (2026-09-06, "poder nombrar las partidas con nombres custom
  /// para diferenciarlas") — null = usa el título por defecto "characterName — worldName" en el
  /// frontend, nunca se sobrescribe `characterName` en sí (ese sigue siendo el personaje real).
  saveName            String?
  characterArchetype  String
  characterOrigin     String
  characterMotivation String
  /// AttributeBlock, copiado al crear la partida (independiente de la plantilla a partir de aquí)
  attributes          Json
  /// SecondaryAttributeBlock (sesión de diseño 2026-07-23) — Inteligencia/Magia/Poder de Semilla/
  /// Moral/4 Resistencias, ya existían como columnas narrativas en personajes.md pero el motor no
  /// las usaba. Nunca se pasan a rollCheck (dice.ts) — solo alimentan comprobaciones de UMBRAL
  /// (requisitos de objetos/construcciones), nunca una tirada nueva. Default "{}" para no romper
  /// partidas ya creadas antes de esta migración; el código trata las claves ausentes como 0.
  secondaryAttributes Json    @default("{}")
  portraitInitial     String

  /// Niveles/XP (docs/10-niveles-xp-reino.md, reversión 2026-07-18 de la decisión de mecánicas 4).
  level                  Int @default(1)
  xp                     Int @default(0)
  pendingAttributePoints Int @default(0)
  /// Goirnos que lleva el jugador (2026-08-31, "Trabajador de Reino" — sistema de moneda de
  /// Berig) — moneda única, acuñada por los Goirntes, aceptada también por orcos y Nabieus (que
  /// prefieren el trueque si el jugador no lleva Goirnos encima; los Goirntes prefieren cobrar en
  /// su propia moneda). Campo plano en `Save`, mismo criterio que `xp` — no hay varias monedas
  /// distintas en Berig, no hace falta una tabla aparte.
  goirnos                Int @default(0)

  /// Nombre del reino/dominio si el jugador lo bautiza — null = aún sin reino (docs/10 § 5.1).
  kingdomName String?

  /// Slug de BERIG_RAZAS (berigLore.ts) — igual que `Npc.raza`, string libre sin FK (contenido
  /// de diseño estático, no una tabla). 2026-07-29, sistema de habilidades por arma/raza: hasta
  /// ahora el personaje jugable no tenía raza estructurada en ningún sitio — su habilidad racial
  /// nunca se le mostraba, solo se calculaba para NPCs. Null = personaje sin raza asignada
  /// todavía (partidas previas a este campo).
  raza            String?
  /// Clase de combate (2026-08-24, Grupo 3 § Sistema de clases, ver docs/rpgtarkor/clases.md) —
  /// mismo `Clase` que `Npc.clase`, ahora un enum real en vez de string libre. Null = sin clase
  /// asignada todavía. Flujo in-game para fijarla, UNA sola vez: `PATCH /saves/:id/clase`
  /// (progression.ts, 2026-08-29) — `classAbilityUnlocksFor` (classAbilities.ts) la lee como
  /// fuente real, con fallback a `characterName` solo para partidas creadas antes de este fix.
  clase           Clase?
  /// Especialización dentro de `clase`, elegida a nivel 10 (ver clases.md § Cómo funciona el
  /// sistema). Null = tronco común todavía, o clase sin especialización elegida. Sin flujo
  /// in-game para elegirla, igual que `clase` — de partida.
  especializacion Especializacion?

  createdAt    DateTime @default(now())
  lastPlayedAt DateTime @default(now())

  /// Ubicación actual en el grafo (null = partidas antiguas sin posición todavía; se
  /// rellena con la ubicación inicial al migrar). Durante un viaje NO cambia: sigue
  /// siendo el origen hasta que worldTick resuelve el CharacterTransit — "dónde estoy"
  /// nunca es ambiguo, y "hacia dónde voy" vive en el tránsito.
  currentLocationId String?
  currentLocation   Location?       @relation("CurrentLocation", fields: [currentLocationId], references: [id])
  locationVisits    LocationVisit[]

  /// Punto del jugador en el mapa SVG de Zona (2026-09-04, "punto del jugador") — píxeles del
  /// lienzo 800×600 de `ZonaPanel.tsx`, misma convención que `ZonePoint.x/y`. Null = partida
  /// previa a esta pieza, o Location actual sin zona explorable — el frontend no pinta el
  /// marcador. Se mueve SOLO por acciones deterministas (viajar/cazar/recolectar/combatir/hablar/
  /// construir/huir), nunca por interpretación de narración libre (services/zonaPosicion.ts).
  zonaPosX        Float?
  zonaPosY        Float?
  /// Punto de ENTRADA a la Location actual (borde del lienzo por el que se llegó, ver
  /// `cardinalDirectionBetween`, travel.ts) — al que el jugador vuelve si huye de un combate.
  /// Se fija UNA vez, en el mismo turno que cambia `currentLocationId`; moverse dentro de la
  /// misma zona (cazar/recolectar/hablar) actualiza `zonaPosX/Y` pero nunca estos dos.
  zonaPosEntradaX Float?
  zonaPosEntradaY Float?
  /// Sistema de movimiento por cuadrícula (2026-09-08) — camino pendiente hacia el destino que el
  /// jugador pulsó en el lienzo (`services/zonaPosicion.ts § calcularCamino`), lista de celdas
  /// `{x,y}[]` en el MISMO píxel/convención que `zonaPosX/Y`, sin incluir la celda actual. Se
  /// consume una celda por cada movimiento (`POST /saves/:id/zona/mover`) — vacío/null = sin
  /// movimiento en curso. Se vacía también si una colisión detiene el avance antes de llegar.
  zonaCaminoPendiente Json?

  /// Condición física (docs/14-combate-y-muerte.md § 1, decisión de mecánicas 3 nunca
  /// implementada hasta ahora). La narración de combate es la vía principal para cambiarla;
  /// descansar/curar la vía principal para mejorarla — el modelo nunca la baja fuera de combate.
  condicionFisica CondicionFisica @default(ILESO)
  /// Salud/PV visible (0-100), instrucción explícita de la usuaria 2026-07-19 — v1 conservador:
  /// se DERIVA de `condicionFisica` (ILESO=100, HERIDO=75, GRAVE=50, CONVALECIENTE=25, MUERTO=0,
  /// ver saludForCondicion en death.ts), no cambia el motor de combate ya calibrado, solo lo
  /// expone como número/barra en vez de solo una etiqueta. Sin daño variable todavía (v2).
  salud           Int             @default(100)
  /// Fatiga/energía (2026-07-29, "que las habilidades no sean de uso ilimitado") — valor ACTUAL,
  /// topado a `energiaMaxFor(constitucion)` (energy.ts) en cada turno, nunca al tope fijo de aquí:
  /// el máximo real escala con Constitución, no es una constante persistida. Se inicializa al
  /// máximo real en POST /saves (mismo criterio que condicionFisica arranca en ILESO).
  energia         Int             @default(100)
  /// Fase 2 de efectos de clase (2026-08-26, docs/21-roadmap.md) — buffs/debuffs con duración real
  /// (`AUMENTO`/`DEBILIDAD`) activos sobre la jugadora ahora mismo. `ActiveEffect[]`
  /// (`services/activeEffects.ts`): `{ attribute, magnitude (con signo), turnsRemaining,
  /// sourceAbility }`. Mismo criterio de reset que `NpcState.abilityUsesThisEncounter`: se vacía
  /// en cuanto `condicionFisica` vuelve a ILESO (descanso/curación real entre combates).
  activeEffects   Json            @default("[]")

  /// Último `Location` de kind refugio/asentamiento donde se descansó con éxito — punto de
  /// reaparición al morir (§ 4.1). Null = todavía no ha descansado en un sitio válido; el
  /// flujo de muerte cae entonces al `Location` inicial del personaje, nunca deja al jugador
  /// sin dónde aparecer.
  lastRestLocationId String?
  lastRestLocation   Location? @relation("LastRestLocation", fields: [lastRestLocationId], references: [id])

  /// Cooldown de Descansar (2026-09-06, hallazgo 11 de la sesión de pruebas: "+30 fijo de energía,
  /// cooldown de 3h de ficción") — minutos de ficción de la última vez que Descansar SE APLICÓ de
  /// verdad (no cada intento; solo cuando de verdad repuso energía). Mismo patrón exacto que
  /// `WorldPopulation.dispersadoDesdeMinutes` (cazar.ts): tiempo de FICCIÓN, nunca reloj real —
  /// comparado contra `WorldState.fictionalMinutes` del turno actual. Null = nunca ha descansado
  /// en esta partida, sin cooldown que aplicar.
  lastRestAtMinutes Int?

  /// Muerte permanente (2026-08-31, petición explícita) — true en cuanto el jugador derrota de
  /// verdad (mata) al Orco Enfurecido del tutorial (services/quests.ts, ORCO_ENFURECIDO_QUEST_TITLE),
  /// nunca antes. Sirve de "primer punto de guardado implícito": antes de este hito, morir sin
  /// haber descansado nunca en construcción propia (`lastRestLocationId` null) ya no reaparece con
  /// el progreso intacto — reinicia la partida entera, igual que `/saves/:id/restart` (decisión
  /// explícita: reinicio total temprano es duro pero coherente con "no hay nada real que
  /// preservar todavía"; tras el tutorial, SIEMPRE hay al menos este hito como red de seguridad).
  tutorialCompletedAt DateTime?

  /// Muerte pendiente de resolución (2026-08-31, petición explícita: "te pondra un boton tipo
  /// Aceptar o Reintentar en la narracion, si le das vuelve al punto de guardado") — el turno que
  /// mata al jugador persiste HASTA AQUÍ y se detiene: `condicionFisica` ya es MUERTO, el susurro
  /// de la Entidad ya se narró (LogEntry), pero el respawn/reinicio real NO se aplica todavía.
  /// Bloquea /turn/classify y /turn/narrate (mismo 409 que `endedAt`/`characterTransit.busyUntil`)
  /// hasta que POST /saves/:id/death/resolve lo consume — ahí se decide, con el estado REAL de la
  /// partida en ese momento (no uno guardado aparte, que podría quedar obsoleto), si toca
  /// reaparecer en `lastRestLocationId` o reiniciar del todo (`tutorialCompletedAt` null Y sin
  /// punto de guardado). Sin datos propios a propósito — todo lo necesario para resolver
  /// (`deathCount`, `dificultad`, `lastRestLocationId`, `tutorialCompletedAt`) ya vive en sus
  /// propias columnas de `Save`.
  pendingDeathResolution Boolean @default(false)

  /// Nº de veces que ha muerto esta partida — determina cuándo se dispara el fin de partida
  /// según `dificultad` (§ 4.2). No se resetea salvo por `/saves/:id/restart`.
  deathCount Int        @default(0)
  /// Elegida al crear la partida (§ 4.2): determina el límite de muertes antes del fin de
  /// partida real. NOVATO = sin límite; MEDIO = 4; AVANZADO = 2.
  dificultad Dificultad @default(MEDIO)
  /// No nulo = partida cerrada por muerte definitiva (§ 4.4): bloquea `/turn/classify` (409,
  /// mismo patrón que CharacterTransit) hasta que se reinicia. No es lo mismo que borrar.
  endedAt    DateTime?
  /// No nulo = la jugadora salió de la vista de juego con un tránsito en curso (roadmap
  /// 2026-07-20, petición explícita: "quiero que la partida se pause si salgo de ella"). Mientras
  /// esté puesto, `resolveDueTransits` (worldTick.ts) se salta esta partida aunque su
  /// `CharacterTransit.busyUntil` ya haya vencido — al volver (`POST /saves/:id/resume`),
  /// `busyUntil` se alarga exactamente lo que ha durado la pausa, así que ni se pierde tiempo de
  /// espera ni se resuelve de golpe por haber estado fuera. Nulo = partida activa (comportamiento
  /// de siempre).
  pausedAt   DateTime?

  /// Slugs de Npc en combate detectado por el último turno resuelto (bug real, 2026-07-23,
  /// "revisar partida" — este campo transitorio SOLO viajaba en la respuesta directa de
  /// `/turn/narrate`, nunca se guardaba: si el turno tardaba tanto que el sondeo de reconexión
  /// del cliente tenía que recuperar la partida vía `GET /saves/:id`, el combate se calculaba
  /// bien en el backend pero se perdía en la recuperación — el jugador nunca veía el botón de
  /// "Combatir"). Se sobrescribe en cada turno (vacío si no hay combate ese turno), para que
  /// `GET /saves/:id` pueda reconstruir el mismo aviso de combate tras cualquier resincronización.
  pendingCombatNpcSlugs Json @default("[]")

  /// Recetas de crafteo desbloqueadas por recompensa de misión (2026-08-17, ver
  /// Quest.rewardRecipeKeys) — solo importa para recetas marcadas `requiresUnlock: true`
  /// (crafting.ts); el resto del catálogo sigue disponible para cualquiera sin este campo.
  unlockedRecipeKeys String[] @default([])

  /// "Cinturón de combate" (2026-08-28, pendiente 2026-08-27 punto 3, "selección de habilidades de
  /// clase activas en combate") — hasta ACTIVE_COMBAT_ABILITIES_MAX (6, ver combatAbilities.ts)
  /// habilidades de combate NO genéricas, en el orden que el jugador elija (drag-and-drop en el
  /// frontend). Solo estas + las 3 genéricas (Ataque Básico/Defenderse/Esquivar, siempre
  /// disponibles, nunca ocupan slot) aparecen como opción real en CombatPanel durante un
  /// enfrentamiento — el resto de habilidades aprendidas sigue existiendo (consultable en
  /// Habilidades → Combate), simplemente no se ofrece para pulsar en plena pelea.
  ///
  /// Se identifica por NOMBRE de `SavedAction`, no por id — las raciales/de arma
  /// (`SavedAction.isDynamic`) se BORRAN y RECREAN cada vez que cambia el equipo/nivel (id nuevo
  /// cada vez), así que un id guardado aquí quedaría huérfano al instante. Si el nombre cambia
  /// (p.ej. cambiar de espada a hacha), ese hueco del cinturón queda vacío hasta que el jugador
  /// elija de nuevo — decisión explícita: más predecible que intentar adivinar qué sustituye a qué.
  activeCombatAbilityNames           String[] @default([])
  /// false = el jugador nunca ha guardado el cinturón todavía — `resolveActiveCombatAbilityNames`
  /// (combatAbilities.ts) cae al comportamiento por defecto (todas activas mientras quepan) en vez
  /// de mostrar un cinturón vacío sin motivo aparente. true en cuanto el jugador guarda una vez
  /// (aunque sea un cinturón vacío a propósito) — a partir de ahí se respeta tal cual, para siempre.
  activeCombatAbilityNamesConfigured Boolean  @default(false)

  /// Barras de habilidades múltiples fuera de combate (2026-09-04, v2 de la SkillBar única de
  /// 2026-08-29 — v1 quedó explícitamente "sin rotar entre varias barras... decisión de alcance"),
  /// General/Profesión/Reino, hasta 3 cada una — ver modelo `SkillBar` abajo. Combate NO participa
  /// aquí: sigue con `activeCombatAbilityNames` de arriba, sistema ya maduro y separado.
  skillBars        SkillBar[]
  /// Qué barra se ve ahora mismo en el HUD del composer — `null` = texto libre. Igual que
  /// `activeCombatAbilityNames`, esto es preferencia de UI persistida, no estado de partida.
  activeSkillBarId String?
  /// Grupos de combate (2026-09-08) — ver modelo `CombatGroup` abajo.
  combatGroups     CombatGroup[]

  /// Bug real (revisión de partida en 5 fases, 2026-08-27, cerrado 2026-08-28) — slugs de Npc que
  /// se despidieron "para siempre" con guion (hoy solo Gistera Koh, al aceptar su misión) —
  /// `detectNpcsInScene` (npcScene.ts) los excluye SIEMPRE de `npcsInScene`, aunque un sessionFact
  /// que los menciona ("...no volverá a aparecer") contenga su nombre literal — sin esto, el
  /// matcher determinista los reintroducía como candidatos legítimos, camino distinto (y sin
  /// cubrir) de los guards `hasFalseGisteraNamedReturn`/`hasGisteraReencuentroSinNombrar`
  /// (narrador.ts), que solo comprueban la narración YA generada, no el propio `npcsInScene` antes
  /// de narrar. Generaliza el parche hardcodeado por slug que ya existía
  /// (`turnResolution.ts` § `gisteraSeHaMarchado`) para cualquier NPC futuro con guion similar.
  npcsRetiredForever String[] @default([])

  /// Rediseño del turno de combate (2026-07-28, petición explícita: "se tiran dados y se ve
  /// quien ataca primero... el otro entra en un turno de defensa"). Cuando la iniciativa de un
  /// intercambio favorece al NPC, aquí se guarda su ataque YA decidido (oculto al frontend) —
  /// qué habilidad/atributo usa y contra qué NPC — a la espera de que el jugador elija su
  /// defensa a ciegas en su próxima sumisión. Null = le toca atacar al jugador (caso normal de
  /// siempre). Se limpia dentro de la misma transacción que resuelve ese intercambio — nunca
  /// sobrevive más de un turno sin resolverse.
  pendingNpcAttack Json?

  /// CANALIZAR real (2026-09-09, cierre de hueco de motor — bloqueaba 5+ capstones nivel 40 de
  /// Tirador/Rúnico/Convocador/Maestro Arquero/Maestro Ballestero/Berserker en clases.md, todas
  /// `ATAQUE`+`CANALIZAR`+`LETAL`). Diseño confirmado por la usuaria: "CANALIZAR no da nada por sí
  /// solo, solo implica que la habilidad tarda X turnos en completarse — si te golpean se corta la
  /// canalización; si la ficha no especifica turnos, es 1; el bonus a la tirada final solo viene
  /// de un AUMENTO explícito combinado en la misma ficha, nunca de CANALIZAR en sí". El turno en
  /// que el jugador usa una habilidad con `CANALIZAR` no tira dados ni ataca — se siembra aquí
  /// `{ savedActionId, npcSlug, turnosRestantes }` y el turno queda consumido sin más. En el turno
  /// siguiente: si el jugador NO recibió un golpe decisivo (`golpe_pleno`) mientras canalizaba, el
  /// ataque real se dispara automáticamente (tirada normal, con los efectos propios de la ficha,
  /// p.ej. LETAL); si sí lo recibió, se cancela sin más — mismo criterio de "se pierde en
  /// silencio" que el resto de efectos sin candidato válido del motor. Null = sin canalización en
  /// curso (caso normal de siempre). Nunca sobrevive fuera de combate (se limpia si el combate
  /// termina antes de completarse).
  pendingCanalizacion Json?

  /// Tirada de Explorar/Desollar YA congelada (rediseño de recolección, 2026-08-22, petición
  /// explícita de la usuaria: "para poder ver algo siempre deberías pasar por esta tirada... al
  /// menos una vez y ya se guarda" — sin esto, reabrir el pop-up tras localizar algo enseñaba la
  /// lista cruda sin recortar por grado, ignorando la tirada por completo, y Desollar volvía a
  /// tirar en CADA apertura del panel, dejando "pescar" un resultado mejor cerrando y reabriendo).
  /// `{ oficio, locationId, sources }` — `sources` es el resultado YA filtrado/recortado por
  /// `applyGatheringRoll` (recolectar.ts), nunca los candidatos crudos. Solo válida mientras
  /// `locationId` coincida con `Save.currentLocationId`; cambiar de zona la vuelve irrelevante sin
  /// necesidad de borrarla a mano (mismo criterio laxo que otros campos "pending" de este modelo).
  harvestRollCache Json?

  /// "Modo dinámico" (2026-08-27, Pieza 4 de "Dinamismo del mundo") — mini-flujo acotado ofrecido
  /// AL FINAL de un turno normal (nunca lo interrumpe), donde el JUEGO toma la iniciativa (un NPC
  /// quiere hablar, hay fauna cerca, etc.) y el jugador responde vuelta a vuelta. El motor decide
  /// determinista CUÁNDO ofrecerlo y QUÉ candidato es (`dynamicMode.ts`, a partir de `ZonePoint` de
  /// la Pieza 3) — el LLM solo narra cada vuelta ya elegida, nunca decide libremente que "toca
  /// algo", mismo principio que el resto de "Mundo determinista". `{ tipo, targetSlug, targetName,
  /// vuelta, iniciadoAtMinutes }` mientras está activo — null si no hay ninguna interacción en
  /// curso. Se limpia al resolverse (aplicar la decisión final) o al cancelarse, nunca sobrevive
  /// a un cambio de `currentLocationId` (mismo criterio laxo que `harvestRollCache`).
  pendingDynamicMode Json?

  /// Oferta de modo dinámico SIN aceptar todavía (bug real 2026-08-28, "oferta de modo dinámico no
  /// sobrevive a una recarga" — a diferencia de `pendingDynamicMode` de arriba, que SÍ se
  /// reconstruye bien tras F5 una vez la jugadora ya pulsó "Interactuar", el momento previo (el
  /// botón "Interactuar"/"Ignorar" en sí) solo vivía en `characterLog` efímero de React). `{ tipo,
  /// targetSlug, targetName }` mientras el botón sigue visible sin decidir — null si no hay ninguna
  /// oferta pendiente. Se limpia al pulsar "Interactuar" (pasa a `pendingDynamicMode` real) o
  /// "Ignorar", igual de laxo que el resto de campos "pending" de este modelo.
  pendingDynamicModeOffer Json?

  /// Cooldown real de ofertas de modo dinámico (bug real jugando en vivo, 2026-08-27: "interactuar
  /// me está saliendo en la gran mayoría de turnos" — con 35% de probabilidad por turno y CERO
  /// cooldown, en varios turnos seguidos en la misma zona la sensación era de spam constante).
  /// `fictionalMinutes` de la última vez que se ofreció/resolvió/ignoró una interacción — mismo
  /// criterio "comparado en vivo contra el reloj" que `pendingDynamicMode`/`lastFedAtMinutes`, no
  /// un contador que decrece. Null = nunca se ofreció una en esta partida, sin cooldown que aplicar.
  lastDynamicModeOfferAtMinutes Int?

  /// Oferta de misión SIN aceptar todavía (bug real jugando en vivo, 2026-09-03: "misión de
  /// apertura no sobrevive a un F5" — `newQuestOfferInfo` de turnResolution.ts solo viajaba en la
  /// respuesta directa del turno; recargar en el momento equivocado la perdía sin ningún aviso).
  /// Mismo patrón exacto que `pendingDynamicModeOffer`: `{ title, description }` mientras la
  /// tarjeta "MISIÓN PROPUESTA" sigue visible sin decidir — null si no hay ninguna oferta
  /// pendiente. Se limpia con `Prisma.JsonNull` al pulsar "Aceptar" (POST /quests/aceptar) o
  /// "Cancelar" (POST /quests/cancelar, nuevo), igual de laxo que el resto de campos "pending".
  pendingQuestOfferInfo Json?

  /// Oferta de menú de interacción con NPC SIN resolver todavía (2026-09-06, "Aprender oficio" deja
  /// de ser una habilidad suelta — al hablar con un NPC con `interactionTypes` no vacío se ofrece un
  /// menú contextual). Mismo patrón exacto que `pendingDynamicModeOffer`/`pendingQuestOfferInfo`
  /// (tarjeta que CONVIVE con el resto de la UI, no bloquea el composer — a diferencia de
  /// `pendingDeathResolution`): `{ npcSlug, npcName, options: string[] }` mientras el menú sigue
  /// visible sin elegir — null si no hay ninguna oferta pendiente. Se limpia con `Prisma.JsonNull`
  /// al elegir cualquier opción (incluida "Salir"), igual de laxo que el resto de campos "pending".
  pendingNpcInteractionOffer Json?

  /// Viaje truncado por un evento de interrupción (ronda de correcciones 2026-08-28, P3.2 —
  /// hallazgo real: "el viaje se trunca sin recordar el destino, el jugador queda varado en el
  /// punto de interrupción"). `pickTravelInterruption` (turn.ts) ya recorta el tránsito a la
  /// parada intermedia real donde entra el NPC en escena — este campo guarda el `Location.id`
  /// ORIGINAL al que iba el jugador, para poder retomar el viaje solo. Se rellena al truncar; se
  /// limpia al disparar la continuación automática (turnResolution.ts, tras resolver el turno que
  /// sigue a la llegada al punto intermedio, sin combate activo y con el jugador vivo) o si el
  /// jugador cambia de destino por su cuenta antes de que eso ocurra.
  pendingTravelResumeDestinationId String?

  /// Hambre/Sed del propio personaje (Grupo 3 § Compañeros y supervivencia, 2026-08-25, ver
  /// docs/rpgtarkor/companeros-y-supervivencia.md § 5) — `WorldState.fictionalMinutes` de la
  /// última vez que comió/bebió, mismo patrón "comparado en vivo contra el reloj" que
  /// `Companion.lastFedAtMinutes`/`NpcState.condicionFisicaSinceMinutes` (nunca un contador que se
  /// decrementa aparte). Null = todavía no ha comido/bebido nunca en esta partida — sembrado al
  /// reloj de ficción inicial en la creación de personaje, para que un personaje recién creado no
  /// arranque ya hambriento.
  lastAteAtMinutes   Int?
  lastDrankAtMinutes Int?

  /// Cooldown de "pescador" (2026-09-02, Pieza 1) — DISTINTO del cooldown estándar de recolección
  /// (`RECOLECCION_COOLDOWN_MS`/`WorldPopulation.lastHarvestedAt`, recolectar.ts: "1 uso, luego 30
  /// min"): Pescar/Buscar admiten 3 usos SEGUIDOS antes de entrar en el mismo cooldown de 30 min.
  /// Real (no de ficción), reloj de pared — mismo criterio ya aceptado para `lastHarvestedAt`
  /// (population.ts): no depende del reloj de ficción de la partida, que puede saltar de golpe
  /// tras un viaje largo. `pescaUsosSeguidos` cuenta 0-3, se resetea a 0 en cuanto pasan los 30 min
  /// desde `pescaCooldownDesde` (o si es null, nunca ha pescado, sin cooldown activo). Campo en
  /// `Save` (no en `WorldPopulation`, a diferencia del resto de recolección): el límite es POR
  /// JUGADOR ("te cansas de pescar"), no por fuente/población del mundo — Pescar/Buscar no
  /// depletan ninguna `WorldPopulation` propia, son peces/marisco de una costa que no se agota así.
  pescaUsosSeguidos  Int       @default(0)
  pescaCooldownDesde DateTime?

  worldState         WorldState?
  logEntries         LogEntry[]
  characterTransit   CharacterTransit?
  sessionSummaries   SessionSummary[]
  inventoryItems     InventoryItem[]
  droppedItems       DroppedItem[]
  companions         Companion[]
  territories        Territory[]
  buildings          Building[]
  subjects           Subject[]
  almacenItems       AlmacenItem[]
  plantillasEquipo   PlantillaEquipo[]
  combatEncounters   CombatEncounter[]
  savedActions       SavedAction[]
  quests             Quest[]
  npcStates          NpcState[]
  professionProgress ProfessionProgress[]
  kingdomStats       KingdomStats?
  discoveredEntities DiscoveredEntity[]
  sessionFacts       SessionFact[]
  foundedFactions    Faction[]

  @@index([userId])
}

/// Ubicación conocida del mundo (catálogo, no estado de partida). Se siembra desde
/// backend/src/scripts/worldCatalog.ts (mismo patrón que loreChunks.ts + reindex-lore):
/// la fuente de verdad editorial sigue siendo docs/rpgtarkor/areas.md.
model Location {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// Clave estable para seeds, aliases y referencias cruzadas ("hondonada-del-eco")
  slug        String
  name        String
  /// Nombre de región del lore — string libre, no FK (misma razón que Territory.region:
  /// el lore vive en .md)
  region      String
  /// Tipo libre ("refugio", "hito", "punto de agua", "cruce", "ruinas", "asentamiento") —
  /// no enum cerrado, misma razón que Companion.role
  kind        String
  /// Descripción de LLEGADA: lo que se inyecta al Narrador cuando el personaje llega aquí
  /// o está aquí — redactada con vocabulario de jugador (lección RAG 2026-07-18)
  description String
  /// Nombres con los que un jugador se refiere de verdad al sitio ("los pilares", "el pozo") —
  /// para que el matcher DETERMINISTA de destinos resuelva sin pasar por el modelo
  aliases     String[]
  /// Coordenadas cartográficas reales en km, origen Los Pilares Rotos, +x=este/+y=norte (2026-08-15,
  /// necesarias para que la Aguja de Cardo Brújula calcule dirección cardinal). Opcionales: no toda
  /// Location las tiene todavía — ver comentario de LocationInput en worldCatalog.ts.
  x           Float?
  y           Float?
  createdAt   DateTime @default(now())

  linksFrom    LocationLink[]  @relation("linkFrom")
  linksTo      LocationLink[]  @relation("linkTo")
  visits       LocationVisit[]
  saves        Save[]          @relation("CurrentLocation")
  restingSaves Save[]          @relation("LastRestLocation")
  buildings    Building[]
  zonePoints   ZonePoint[]
  droppedItems DroppedItem[]

  @@unique([worldId, slug])
}

/// Grupo 3 § Mundo determinista (docs/rpgtarkor/mundo-determinista.md, 2026-08-25) — Capa 1: zonas
/// navegables. Prototipo en UNA sola zona (Hondonada del Eco) antes de repetir en el resto, mismo
/// criterio que el Mapa de Cristal Helado ("un nodo a la vez, calibrado en vivo"). Posición LOCAL
/// dentro del lienzo de la zona — no confundir con `Location.x`/`y`, que es la posición GLOBAL en
/// km reales de la propia Location dentro del mundo (solo para la Brújula). Deliberadamente
/// ACOTADO en esta pasada: solo representa DÓNDE vive algo dentro de la zona — no cambia todavía
/// cómo se resuelve cazar/recolectar/combate (eso es trabajo de las Capas 2-3 del documento,
/// construidas ENCIMA de esto, no aquí).
/// Dinamismo del mundo, Pieza 3 (2026-08-27, docs/21-roadmap.md) — `ZonePoint` pasa de catálogo
/// estático (solo "aquí PUEDE aparecer esta especie/recurso") a INSTANCIA VIVA: cada fila
/// representa lo que hay realmente ahora mismo en ese punto, con estado que cambia con el tiempo de
/// ficción. El seed de `worldCatalog.ts` pasa a ser el ESTADO INICIAL de cada punto curado a mano,
/// no una plantilla reutilizable separada — decisión explícita (más simple, una sola tabla, en vez
/// de una tabla de "catálogo de spawns" + otra de "instancia en vivo").
model ZonePoint {
  id                   String        @id @default(cuid())
  locationId           String
  location             Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// Píxeles del lienzo de la zona (convención 800×600, misma que ya usa el mapa de mundo —
  /// `frontend/src/data/map.ts` — para que el frontend pueda reutilizar el mismo sistema de
  /// overlay SVG). Calibrado a mano contra el PNG real de la zona — sigue siendo la POSICIÓN
  /// ACTUAL real (Pieza 3, sistema de movimiento por cuadrícula 2026-09-08, `services/
  /// zonaPosicion.ts`): se sobrescribe un paso cada vez que el jugador se mueve una celda (ruta
  /// artesanal en bucle, o paseo aleatorio corto si no hay ruta definida). `origenX/Y` guarda el
  /// dato de catálogo original SIN TOCAR, necesario para que el paseo aleatorio nunca se aleje de
  /// su territorio real.
  x                    Float
  /// Posición de catálogo ORIGINAL — nunca se sobrescribe (a diferencia de `x`/`y` arriba). Null =
  /// partida/fila sembrada antes de esta pieza; el caller trata ese caso como "origen = x/y
  /// actual" (comportamiento idéntico a antes: sin movimiento todavía, x/y sigue siendo el mismo
  /// punto de siempre).
  origenX              Float?
  origenY              Float?
  y                    Float
  /// Determina la FORMA del icono en el frontend (regla fija, sin campo aparte): FAUNA=círculo,
  /// NPC=triángulo (identidad única, incluye Companion), EDIFICIO=cuadrado, RECURSO=rombo (inerte:
  /// flora/materiales/minerales).
  tipo                 ZonePointTipo
  /// Slug del Npc (FAUNA/NPC) o de HarvestYield.sourceSlug (RECURSO) que puede aparecer aquí —
  /// string libre, no FK (mismo criterio que el resto del catálogo: el contenido real vive en
  /// worldCatalog.ts, esto solo referencia por slug).
  targetSlug           String
  /// Etiqueta corta para el marcador del mapa — null = el frontend cae al nombre real de catálogo.
  label                String?
  /// Agrupación dinámica por cantidad real (Pieza 3) — cuántos individuos representa este punto
  /// AHORA MISMO (nunca una marca fija de catálogo por especie). 1 = punto individual sin contador
  /// visible; >1 = el frontend muestra "×N". Un `tipo: NPC` (identidad única) siempre vale 1, nunca
  /// se agrupa. Default 1 — cualquier punto sembrado antes de esta migración se trata como
  /// individual, comportamiento idéntico al de siempre.
  cantidad             Int           @default(1)
  /// Vivo/agotado (Pieza 3) — un punto FAUNA/NPC "muerto" o un RECURSO "agotado" deja de mostrarse
  /// como activo (mismo vocabulario que el resto del motor de combate/recolección) hasta que el
  /// recalculo determinista lo reponga o lo elimine. `true` = activo/visible con normalidad.
  activo               Boolean       @default(true)
  /// Color del icono por reputación con SU facción (Pieza 3) — null = sin facción asociada (fauna
  /// salvaje, recursos, seres inertes sin dueño), el frontend pinta naranja de fondo en ese caso.
  /// String libre (mismo criterio que `Npc.faction`), no FK.
  factionSlug          String?
  /// `WorldState.fictionalMinutes` de la ÚLTIMA vez que este punto se recalculó — comparado contra
  /// el valor actual para saber cuánto tiempo de ficción pasó y así recalcular proporcionalmente
  /// (mismo patrón que `condicionFisicaSinceMinutes`/`lastFedAtMinutes`, nunca un contador que
  /// decrementa). Null = nunca recalculado todavía (recién sembrado o recién creado por el motor).
  lastUpdatedAtMinutes Int?
  /// Sistema de movimiento por cuadrícula (2026-09-08, diseño confirmado con la usuaria, referencia
  /// explícita "estilo Mount & Blade") — secuencia de celdas `{x,y}[]` (misma convención de píxeles
  /// que `x`/`y` arriba, redondeados al centro de cada celda de `CELL_SIZE_PX`,
  /// `services/zonaPosicion.ts`) que este punto recorre EN BUCLE, un paso cada vez que el jugador se
  /// mueve una celda — nunca tiempo real de pared, mismo criterio "solo avanza con el turno/acción
  /// del jugador" que `recalcularZonePointsDeLocation`. `null`/`[]` = sin ruta artesanal definida
  /// todavía (la inmensa mayoría del catálogo al principio) — cae al fallback determinista de paseo
  /// aleatorio corto alrededor de `x`/`y` (nunca completamente estático, pero sin exigir diseñar las
  /// rutas de golpe). Rutas reales se añaden progresivamente en `worldCatalog.ts`, mismo criterio
  /// que el resto del catálogo curado a mano (bio/lore/habilidades).
  ruta                 Json?
  /// Índice del paso actual dentro de `ruta` (o de la posición aleatoria acumulada del fallback) —
  /// 0 = en `x`/`y` original. Se incrementa en cada paso del jugador; al llegar al final de `ruta`
  /// vuelve a 0 (bucle). Sin relación con `lastUpdatedAtMinutes` (ese es tiempo de ficción para
  /// cantidad/actividad; esto es "turnos de movimiento", un concepto distinto y más frecuente).
  pasoRuta             Int           @default(0)
  createdAt            DateTime      @default(now())

  @@index([locationId])
}

enum ZonePointTipo {
  FAUNA
  RECURSO
  NPC
  /// Dinamismo del mundo, Pieza 3 (2026-08-27) — edificios construidos ahora sí tienen
  /// representación espacial dentro del lienzo de zona (antes solo existían como fila de BD con
  /// icono en el mapa de MUNDO/macro, invisibles en el mapa de ZONA/micro).
  EDIFICIO
}

/// "Tirar" objetos al suelo de la Zona (2026-09-06, hallazgo 8 de la sesión de pruebas: "Recoger"
/// debe ser solo para ítems sueltos, incluidos los que el propio jugador tire — no recursos
/// naturales, eso es "Recolectar"). A diferencia de `ZonePoint` (catálogo fijo por `Location`,
/// compartido entre partidas), esto es una INSTANCIA por partida (`saveId`), con posición fija
/// desde que se creó (= `Save.zonaPosX/Y` del jugador en el momento de tirarlo — nunca aleatoria,
/// decisión explícita de la usuaria) — persiste para siempre hasta que alguien lo recoja, no
/// expira ni se dispersa como la fauna dinámica.
///
/// Mismo subconjunto de campos que `NpcState.givenItems`/`entrega.ts` ya congela al entregar un
/// objeto a un NPC (name/description/catalogSlug/statBonuses) — `equipSlot`/`effectKey`/
/// `category`/`tipoArma`/`tipo` se re-derivan por join a `ItemCatalog` vía `catalogSlug` en el
/// momento de recoger, no se duplican aquí.
model DroppedItem {
  id          String   @id @default(cuid())
  saveId      String
  save        Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// Mismo lienzo 800×600 que ZonePoint — posición del jugador en el momento de tirarlo, fija.
  x           Float
  y           Float
  name        String
  description String
  catalogSlug String?
  statBonuses Json?
  createdAt   DateTime @default(now())

  @@index([saveId, locationId])
}

/// Ruta directa entre dos ubicaciones. Se guarda UNA fila por pareja y el grafo se trata
/// como bidireccional (ir y volver cuestan lo mismo en v1 — si algún día una ruta es
/// asimétrica, se añade la fila inversa con otro coste y gana la específica).
model LocationLink {
  id     String   @id @default(cuid())
  fromId String
  from   Location @relation("linkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Location @relation("linkTo", fields: [toId], references: [id], onDelete: Cascade)

  /// Minutos de viaje BASE (a pie, sin modificador). Es exactamente el `base` de la fórmula
  /// YA existente en timedActions.ts — minutos = base / (1 + destreza/20). No se toca la
  /// fórmula: solo se le da un `base` determinista sacado del grafo en vez de la estimación
  /// libre del clasificador.
  minutosBase Int
  /// Terreno libre ("llanura abierta", "arcilla agrietada", "senda de pastoreo") — color
  /// concreto para narrar el trayecto sin inventar
  terreno     String
  /// Riesgo conocido de la ruta ("nidos de Espina del Viento", "paso de patrullas de la
  /// Concordia") — material para el Narrador; null = sin riesgo señalado
  riesgo      String?

  @@unique([fromId, toId])
}

/// Primera visita de una partida a una ubicación — habilita el hito "descubrimiento"
/// (50 XP, tabla de docs/10 § 3.2) de forma DETERMINISTA: lo emite el backend al llegar
/// por primera vez, sin que el modelo tenga que proponerlo.
model LocationVisit {
  id             String   @id @default(cuid())
  saveId         String
  save           Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  firstVisitedAt DateTime @default(now())

  @@unique([saveId, locationId])
}

/// Enciclopedia progresiva (sesión de diseño 2026-07-23, petición explícita de la usuaria a
/// partir de la "niebla de guerra" del mapa: "en vez de tener todo descubierto desde el inicio...
/// solo se verá una vez la AI lo mencione por primera vez en la narración, o sean objetos que ya
/// tenemos"). Una fila = esta partida ya conoce esta entidad — NPC/fauna/objeto mencionado en
/// narración o `new_facts` (o, para objetos, presente en el inventario), detectado en
/// `services/discovery.ts` tras persistir cada turno. Lugares NO usan esta tabla: se gatean con
/// `LocationVisit` (ya existía, visita física real). Razas/clases/personajes/atributos/
/// construcciones quedan siempre visibles a propósito — son "cómo funciona el juego", no lore
/// narrativo que se descubre jugando.
model DiscoveredEntity {
  id           String            @id @default(cuid())
  saveId       String
  save         Save              @relation(fields: [saveId], references: [id], onDelete: Cascade)
  /// 'npc' | 'fauna' | 'item' | 'faction' | 'historia' (2026-08-06) — mismo vocabulario que
  /// ImagePromptEntityType, pero sin los tipos siempre-visibles de arriba.
  entityType   String
  entitySlug   String
  discoveredAt DateTime          @default(now())
  /// Enciclopedia en 3 fases (2026-09-08, rediseño de Álvaro: "no descubierto, citado o
  /// avistado") — CITADO = mencionado en narración/lore, información mínima (nombre+región);
  /// DESCUBIERTO = visto realmente en escena (o desbloqueado por un objeto de lore específico),
  /// ficha completa con imagen. Esta fila solo EXISTE si al menos CITADO ya ocurrió (misma
  /// semántica que antes: "sin fila = NO_DESCUBIERTO" sigue vigente) — el campo nuevo distingue
  /// las dos fases donde antes solo había una. Default CITADO: cualquier `createMany` viejo (sin
  /// tocar) que siga escribiendo sin este campo se interpreta como el estado más conservador, no
  /// como si ya se hubiera visto en escena.
  fase         EntityDiscoveryFase @default(CITADO)

  @@unique([saveId, entityType, entitySlug])
  @@index([saveId])
}

enum EntityDiscoveryFase {
  CITADO
  DESCUBIERTO
}

/// La fuente de verdad de una partida — no es prosa, son hechos estructurados.
/// Se lee/escribe en cada llamada al Narrador/Cronista para que nunca se contradigan (ver 01-analisis-producto.md § 4).
model WorldState {
  id     String @id @default(cuid())
  saveId String @unique
  save   Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)

  fictionalDateLabel String @default("Día 1, mañana")
  /// Minutos ficticios totales transcurridos desde Día 1, 00:00 (480 = 08:00, el mismo origen que
  /// ya asumía `fictionalDateLabel` como placeholder). Avanza en narrateAndPersistTurn() según los
  /// minutos reales que cuesta cada turno (computeDuration/travel.minutos) — nunca lo decide el
  /// modelo. `fictionalDateLabel` se regenera a partir de este número cada vez que avanza, para no
  /// tener que tocar los muchos sitios que ya lo leen como string. Año todavía sin implementar
  /// (pendiente de que el flujo día/hora se demuestre estable jugando).
  fictionalMinutes   Int    @default(480)
  /// Hitos de mundo que avanzan solos con el tiempo de ficción (2026-08-24, ver worldAgenda.ts) —
  /// más allá de la ambientación pasiva de `entorno.ts`. Quitado en la auditoría de elementos
  /// desconectados 2026-08-23 por no tener productor, restaurado el mismo día y construido de
  /// verdad al día siguiente: el tick de fondo (`worldTick.ts`) siembra y avanza
  /// `AgendaEntry[]` (worldAgenda.ts) — hoy un único hito, el conflicto Serhu-Concordia contra
  /// Helsig/Goshg, que deplete población real de esos dos clanes si nadie interviene.
  agenda             Json   @default("[]")
  factionsStatus     Json   @default("{}")

  updatedAt DateTime @updatedAt
}

/// Hechos establecidos de la partida (2026-07-30, mejora de cohesión — "recuperación por
/// relevancia para sessionFacts, misma infraestructura que el RAG de lore"). Antes vivían en
/// `WorldState.facts` (Json, ventana rodante de los últimos 10 — ver worldFacts.ts/mergeFacts):
/// un hecho genuinamente importante de hace 15 turnos se perdía para siempre solo por antigüedad,
/// mientras uno reciente pero ya irrelevante seguía ocupando hueco en cada prompt. Ahora se
/// almacenan TODOS (con un tope generoso, ver `MAX_STORED_FACTS` en worldFacts.ts) con su propio
/// embedding — igual que `LoreChunk` — y la selección de qué mandar al Narrador cada turno mezcla
/// los más recientes (continuidad inmediata) con los más relevantes por similitud a la acción
/// actual (cohesión con hechos antiguos que vuelven a importar), sin aumentar el tamaño del
/// prompt frente a antes (mismo tope de 10 que se manda realmente).
model SessionFact {
  id        String                      @id @default(cuid())
  saveId    String
  save      Save                        @relation(fields: [saveId], references: [id], onDelete: Cascade)
  text      String
  /// Mismo patrón que LoreChunk.embedding — habilitado a mano vía `CREATE EXTENSION vector`, no
  /// gestionado por Prisma (preview feature postgresqlExtensions), ver comentario del datasource.
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())

  @@index([saveId, createdAt])
}

/// Entrada de log append-only. `roll` solo presente en entradas del canal CHARACTER que resuelven una tirada.
model LogEntry {
  id                String     @id @default(cuid())
  saveId            String
  save              Save       @relation(fields: [saveId], references: [id], onDelete: Cascade)
  channel           LogChannel
  text              String
  /// RollInfo: { attribute, value, difficulty, result, success } — null si la entrada no es una tirada
  roll              Json?
  isPlayerAction    Boolean    @default(false)
  /// Mensaje DETERMINISTA de sistema (2026-09-05, bug real: "Gorhorn asume su clase: GUERRERO."
  /// se guardaba igual que una narración normal del Narrador, isPlayerAction:false — el turno
  /// SIGUIENTE lo recibía como "TU PROPIA NARRACIÓN DEL TURNO ANTERIOR" y el modelo lo repitió
  /// literalmente al inicio de la narración nueva, sin ningún sentido). true en cualquier LogEntry
  /// construido a mano fuera de `narrateAndPersistTurn` (elegir clase, subir de nivel, descubrir
  /// una ubicación, etc. — texto fijo, nunca generado por el LLM) para excluirlo de
  /// `lastNarration` (turnResolution.ts) sin depender de reconocer el texto por coincidencia.
  isSystemMessage   Boolean    @default(false)
  timeLabel         String
  /// XP ganada en esta entrada, si alguna (docs/10-niveles-xp-reino.md § 6) — permite mostrar
  /// "+50 XP" en el Diario y auditar el nivel sumando el log.
  xpDelta           Int?
  /// Desglose de `xpDelta` (UX 2026-09-01, hallazgo jugando en vivo: un turno FALLIDO con un hito
  /// grande detrás — p.ej. "capitulo", 500 XP — se veía como un único "+500 XP" pegado a un
  /// "Fallo" en rojo, como si el juego premiara el fracaso). `xpHitoDelta` es la parte de
  /// `xpDelta` que vino de un hito/evento de Reino, no de la tirada normal del turno; el frontend
  /// la pinta en su propia línea ("📖 Capítulo completado (+500 XP)") separada del chip de XP
  /// normal. Ambos null si el turno no tuvo hito — mismo patrón que `combate`/`travelInterrupted`
  /// de más abajo: necesita su propia columna para sobrevivir a una recarga de partida.
  xpHitoDelta       Int?
  xpHitoLabel       String?
  /// Minuto de ficción real en el momento de crear esta entrada (WorldState.fictionalMinutes,
  /// petición explícita de la usuaria, 2026-07-24: "el log de personaje solo muestre 24h del
  /// mundo... el diario clasificado por días") — antes solo existía `timeLabel` (texto ya
  /// formateado, "Día 3, 14:20"), sin número real que permita filtrar por ventana de tiempo de
  /// juego ni agrupar por día sin parsear el string. `@default(0)` es solo para filas anteriores
  /// a esta migración (se leerán como "Día 1"), nunca se usa para filas nuevas.
  fictionalMinutes  Int        @default(0)
  /// Qué entidad de la Enciclopedia se mostró como banner bajo esta narración (rework 2026-07-24,
  /// "las imágenes que se muestran en la narración deben persistir de alguna forma") — el frontend
  /// ya decide cuál mostrar (mentionedEntityBanner.ts, con su propia deduplicación); esto solo
  /// guarda esa decisión para que sobreviva a una recarga dentro de la ventana de 24h. Se resuelve
  /// la imagen real en cada lectura (nunca se guarda la URL), igual que el resto de imágenes de la
  /// Enciclopedia — así una imagen subida más tarde para la misma entidad también se ve aquí.
  entityBannerType  String?
  entityBannerSlug  String?
  /// Rediseño de la vista de combate (2026-07-28): marca si esta entrada se generó durante un
  /// turno de combate (`enCombate: true` en turnResolution.ts) — el frontend la pinta con fondo
  /// rojo en el log de "Tu personaje". No se puede inferir esto de forma fiable a partir de otros
  /// campos ya existentes (`roll` también aparece en tiradas fuera de combate), así que necesita
  /// su propia columna para sobrevivir a una recarga de partida.
  combate           Boolean    @default(false)
  /// Eventos de viaje interactivos (2026-08-05): marca la entrada determinista (nunca narrada por
  /// el LLM) que avisa de que un viaje largo se interrumpió antes de llegar al destino pedido —
  /// el frontend la pinta con fondo ámbar en el log, igual que `combate` con el rojo. Sin esto, el
  /// jugador podía terminar en una ubicación distinta a la pedida sin ninguna señal visible más
  /// allá de la narración de llegada, que no sabe (ni debe saber) cuál era el destino original.
  travelInterrupted Boolean    @default(false)
  /// CombatExchangeDisplay (combatExchange.ts): las DOS tiradas reales de un intercambio de
  /// combate ("Tú"/"Enemigo") — bug real jugando en vivo, 2026-08-13: hasta ahora solo viajaba en
  /// la respuesta HTTP del turno recién resuelto (turn.ts), nunca se guardaba, así que recargar la
  /// partida perdía el lado del enemigo y el badge de dos filas colapsaba al de una sola tirada
  /// (`roll`, que solo guarda el lado del jugador). null si el turno no tuvo intercambio real.
  combatExchange    Json?
  /// { npcName, abilityName, rol } / { name, icon, description, rol } (turnResolution.ts) — mismo
  /// bug gemelo que `combatExchange` de arriba (2026-08-14, encontrado al pedir que
  /// CombatExchangeBadge mostrara el nombre real del NPC en vez de "el enemigo": tras recargar,
  /// el nombre desaparecía porque estos dos campos nunca se guardaban, solo viajaban en la
  /// respuesta HTTP del turno recién resuelto) — null si el turno no tuvo intercambio real.
  npcAbilityUsed    Json?
  playerAbilityUsed Json?
  /// InitiativeResult (combatExchange.ts): { ganador, jugadorTirada, npcTirada } — tercer bug
  /// gemelo de la misma familia que `combatExchange`/`npcAbilityUsed` de arriba (2026-08-21,
  /// jugando en vivo: "al recargar la página se está perdiendo el mensaje de la iniciativa y la
  /// tirada de los dados"). `turnResolution.ts` ya calculaba esta tirada para decidir quién actúa
  /// en el PRÓXIMO intercambio, pero solo viajaba en la respuesta HTTP del turno recién resuelto
  /// (routes/turn.ts) — nunca se guardaba, así que recargar la partida durante un combate abierto
  /// perdía el banner de iniciativa por completo. null si el turno no tuvo intercambio real.
  initiativeRoll    Json?
  createdAt         DateTime   @default(now())

  @@index([saveId, createdAt])
  @@index([saveId, fictionalMinutes])
}

/// Personaje "ocupado/en tránsito" durante una acción larga (viajar, descansar varios días...).
/// Como mucho una fila activa por partida — el personaje solo puede estar haciendo una cosa larga a la vez.
model CharacterTransit {
  id                 String    @id @default(cuid())
  saveId             String    @unique
  save               Save      @relation(fields: [saveId], references: [id], onDelete: Cascade)
  activity           String
  busyUntil          DateTime
  zoneContext        Json?
  createdAt          DateTime  @default(now())
  /// Espera de viaje precalculada (2026-08-13) — candado de reclamo SEPARADO de `busyUntil`
  /// (que sigue siendo puramente la cuenta atrás visible del jugador, nunca se toca para esto).
  /// `turn.ts` lo pone al arrancar un viaje sin evento, reclamando esta fila para la resolución
  /// anticipada (ver `startEagerTransitResolution`, workers/worldTick.ts) — mientras esté puesto,
  /// `resolveDueTransits` (el barrido periódico) la ignora aunque `busyUntil` ya haya vencido, para
  /// que las dos vías nunca narren la misma fila dos veces.
  narrationClaimedAt DateTime?
}

/// Los 13 huecos de equipo fijos que pidió la usuaria — puramente organizativo/narrativo, sin
/// bonificadores propios (mismo espíritu que el resto de InventoryItem). Como máximo un objeto
/// por hueco y por partida (@@unique en InventoryItem más abajo); Postgres trata cada NULL como
/// distinto, así que varios objetos sin equipar (slot = null) conviven sin problema.
enum EquipSlot {
  CASCO
  CAMISA
  ARMADURA_SUPERIOR
  GUANTES
  ARMADURA_INFERIOR
  ACCESORIO
  BOTAS
  ARMA_PRINCIPAL
  ARMA_SECUNDARIA
  ANILLO_1
  ANILLO_2
  CINTURON
  /// 6 ranuras de consumible (2026-07-30, petición explícita: "raciones y cataplasma catalogalo
  /// como Consumible que tendrá 6 slots en equipo donde podrás añadir los consumibles que quieres
  /// usar en el combate") — familia intercambiable entre sí (ver `equipSlotFamily`, equipment.ts),
  /// igual que ARMA_PRINCIPAL/ARMA_SECUNDARIA o ANILLO_1/ANILLO_2. `combatItems` (GameView.tsx)
  /// ahora sale de estas ranuras, no de "cualquier objeto sin ranura" — hay que EQUIPAR un
  /// consumible aquí a propósito para poder usarlo en combate.
  CONSUMIBLE_1
  CONSUMIBLE_2
  CONSUMIBLE_3
  CONSUMIBLE_4
  CONSUMIBLE_5
  CONSUMIBLE_6
  /// 3 ranuras de cosmético puro (2026-08-03, petición explícita: "crear dentro de los items
  /// equipables una categoría que es cosméticos... Espalda, Cabeza y Cintura") — sustituyen a
  /// ABALORIO (demasiado genérico, sin sitio anatómico propio). 1:1 exactas, sin familia
  /// compartida (a diferencia de ARMA_*/ANILLO_*/CONSUMIBLE_*): un cosmético de espalda nunca vale
  /// en el hueco de cintura. `category: 'cosmetico'` en ItemCatalog es la convención de catálogo
  /// que las acompaña (campo libre, no enum — ver comentario de `category`).
  COSMETICO_ESPALDA
  COSMETICO_CABEZA
  COSMETICO_CINTURA
}

/// Objeto que el personaje lleva encima o ha conseguido. Origen/descripción siguen siendo puro
/// contexto narrativo (decisión de mecánicas 6), pero desde 2026-07-19 (instrucción explícita de
/// la usuaria, reabriendo esa decisión — Gorhorn es guerrero primero, sin nada mágico todavía)
/// un objeto puede llevar un bonificador mecánico real a uno de los 6 atributos jugables,
/// aplicado solo mientras está EQUIPADO (ver effectiveAttributes en services/equipment.ts).
model InventoryItem {
  id                     String     @id @default(cuid())
  saveId                 String
  save                   Save       @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name                   String
  description            String
  /// De dónde salió (botín, inicial, regalo de un NPC...) — contexto narrativo, no categoría mecánica.
  origin                 String?
  /// Hueco de equipo asignado (null = en la mochila, sin equipar). La jugadora lo asigna a mano
  /// desde el panel "Equipo" — el modelo nunca lo decide.
  slot                   EquipSlot?
  /// Bonificadores mecánicos reales (solo cuentan mientras `slot` no es null) — mapa múltiple
  /// (2026-08-03, sustituye a statBonusAttribute/statBonusAmount) de cero o más de los 7
  /// atributos jugables más 'defensa' — nunca mágico por ahora (magia incluido en la lista pero
  /// sin usarlo todavía en objetos reales — Gorhorn es guerrero, sin nada mágico hasta que se
  /// decida introducirlo). Null = objeto puramente narrativo, como antes.
  /// Partial<Record<Attribute | 'defensa', number>> (ver StatBonusMap, equipment.ts).
  statBonuses            Json?
  /// Slug de ItemCatalog de origen (sesión de diseño 2026-07-23) — no es FK real (mismo criterio
  /// laxo que Quest.targetItemName): un objeto narrativo suelto (newItem del modelo) nunca tiene
  /// uno. Se rellena cuando se sabe el origen (saqueo/despiece/crafteo, ver turnResolution.ts) —
  /// permite mirar ItemCatalog.requisitos al equipar sin comparar por nombre (frágil, el nombre
  /// final puede personalizarse en el saqueo/crafteo).
  catalogSlug            String?
  createdAt              DateTime   @default(now())
  /// Equipo de compañero/súbdito (Grupo 3 § Compañeros y supervivencia, 2026-08-25, ver
  /// docs/rpgtarkor/companeros-y-supervivencia.md § 6) — ambos null = equipado en el propio
  /// personaje (comportamiento de siempre) o sin equipar; como mucho UNO de los dos con valor,
  /// nunca los dos a la vez (mismo campo `slot` reutilizado para las 3 posibilidades).
  /// `onDelete: SetNull` en ambos — si el compañero/súbdito se pierde, el objeto no desaparece,
  /// vuelve a la mochila sin equipar.
  companionId            String?
  companion              Companion? @relation(fields: [companionId], references: [id], onDelete: SetNull)
  /// Solo para el auto-equipo de súbditos por plantilla (§7) — nunca lo asigna la jugadora a mano
  /// como con `companionId`.
  subjectId              String?
  subject                Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /// Rediseño de captura (2026-08-28, docs/rpgtarkor/captura-rediseno-2026-08-28.md) — no null =
  /// esta fila ES una captura en tránsito (fauna o NPC atado, todavía sin depositar en Jaula/Celda
  /// de Retención), no un objeto normal. Reemplaza el viejo mecanismo donde la captura vivía
  /// in-situ en `NpcState.capturado` — eso rompía la caza en grupo (una sola fila `NpcState` por
  /// especie no podía ser "el individuo capturado en tameo" Y "el individuo activo para seguir
  /// cazando al resto" a la vez). Al materializarse como ítem, el `NpcState` de origen se resetea
  /// exactamente igual que `grupoContinua` (turnResolution.ts) — libre para que el grupo siga.
  capturaNpcId           String?
  capturaScope           String?
  /// `fictionalMinutes` en que esta captura se escapa sola si sigue en el inventario (no
  /// depositada en Jaula/Celda) — derivado del tier de la cuerda usada al atar
  /// (`plazoCapturaHorasForTier`, companionSupervivencia.ts). Null = tier 7 (cuerda que nunca se
  /// rompe, sin plazo) — todavía sin craftear ninguna cuerda de tier > 1 en el catálogo real.
  capturaExpiraAtMinutes Int?

  // `@@unique([saveId, slot])` retirado (2026-08-25): con `companionId`/`subjectId`, "un objeto
  // por hueco" ya no es un único par (saveId, slot) — el personaje Y cada compañero/súbdito
  // tienen su propio hueco ARMA_PRINCIPAL/CASCO/etc a la vez. Se sigue garantizando "como mucho un
  // objeto por hueco", pero a nivel de aplicación (mismo patrón `updateMany` + `update` en una
  // sola transacción que YA usaba este índice como respaldo, nunca como única garantía real — ver
  // PATCH /saves/:id/inventario/:itemId, inventario.ts), ahora también scopeado por el dueño real.

  @@index([saveId])
  @@index([companionId])
  @@index([subjectId])
}

/// Aliado, súbdito o acompañante del personaje. Hasta 2026-08-25 solo era estado narrativo (name/
/// role/notes, sin capa mecánica) — Grupo 3 § Compañeros y supervivencia
/// (docs/rpgtarkor/companeros-y-supervivencia.md) añade Felicidad/Comida/Agua reales para los que
/// vienen de captura+tameo/persuasión de verdad. Los `Companion` creados por quest/narración libre
/// (`newCompanion`, sin pasar por captura) se quedan con `tipo: NPC`/`sourceSlug: null` por
/// defecto — siguen siendo válidos, simplemente sin Felicidad/Comida/Agua que trackear (no
/// decaen, mismo comportamiento de siempre).
model Companion {
  id        String   @id @default(cuid())
  saveId    String
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name      String
  /// p. ej. "aliado", "súbdito", "compañero de viaje" — libre, no un enum cerrado todavía.
  role      String
  notes     String
  createdAt DateTime @default(now())

  /// FAUNA = tameado (jaula + tirada opuesta de atributo). NPC = persuadido (atar + tirada
  /// opuesta) O de quest/narración libre (`newCompanion`, comportamiento de siempre).
  tipo                 CompanionTipo    @default(NPC)
  /// Slug del Npc de catálogo (fauna o humanoide) del que viene este compañero — null para los de
  /// quest/narración libre, que no tienen una ficha de catálogo real detrás.
  sourceSlug           String?
  /// 0-100, sube/baja por el resultado de cada tirada de tameo/persuasión (§2/3) y por descuido de
  /// Comida/Agua (§4) — null para compañeros de quest/narración libre (sin capa mecánica).
  felicidad            Int?
  /// `WorldState.fictionalMinutes` de la última vez que comió/bebió — null = recién capturado, sin
  /// hambre/sed acumulada todavía (mismo criterio que dar de alta con reloj "a cero"). Comparado en
  /// vivo contra el reloj actual para saber el estado (nunca se decrementa un contador aparte,
  /// mismo patrón que `NpcState.condicionFisicaSinceMinutes`).
  lastFedAtMinutes     Int?
  lastWateredAtMinutes Int?
  /// true = ocupa el slot de mascota GARANTIZADO del Domador (companeros-y-supervivencia.md § 2),
  /// separado por completo de `companionSlotsForRecipeKey` — no compite contra Campamento/Choza.
  esSlotDomador        Boolean          @default(false)
  /// Alfa de la Manada real (2026-09-14, docs/rpgtarkor/clases.md — Domador 40, capstone) — con la
  /// habilidad desbloqueada (`save.level >= 40` y Domador), el jugador tiene 2 slots garantizados
  /// de Domador (`esSlotDomador: true` en ambos) y puede elegir UNO de los dos como Alfa, con un
  /// buff extra propio (+2 fuerza) por encima del buff pasivo compartido (+2 voluntad a ambas
  /// bestias si están equipadas — ese buff compartido no depende de `esAlfa`, solo de tener 2 slots
  /// de Domador ocupados). Como mucho un `Companion` por `saveId` puede tener `esAlfa: true` —
  /// invariante aplicado en la ruta que lo asigna, no a nivel de base de datos.
  esAlfa               Boolean          @default(false)
  /// Integración en el Reino (§2/§6-7) — 'guardia'/'trabajador'/'productor' (convención libre,
  /// mismo criterio que `role`), null = solo compañero personal, no integrado. Requiere Reino
  /// (con o sin slot de Domador/edificio ya resuelto aparte); el rol concreto depende de la
  /// especie, sin enum cerrado.
  rolReino             String?
  /// Plantilla de equipo asignada (§7) — solo relevante si `rolReino` no es null. Null = sin
  /// plantilla, se equipa a mano como cualquier compañero personal (`inventoryItems` abajo).
  plantillaEquipoId    String?
  plantillaEquipo      PlantillaEquipo? @relation(fields: [plantillaEquipoId], references: [id], onDelete: SetNull)
  inventoryItems       InventoryItem[]

  /// Combate múltiple (Grupo 3, 2026-08-25, docs/rpgtarkor/combate-multiple.md § 5: "Companion
  /// necesita atributos y vida propios") — null = compañero sin capa de combate todavía (de
  /// quest/narración libre, `newCompanion`, nunca pasó por captura+tameo/persuasión real). Al
  /// confirmar un tameo/persuasión (companeros.ts), se copia tal cual el `attributes` del `Npc`
  /// de catálogo origen — un compañero de combate real nunca es más fuerte que el individuo del
  /// que salió. AttributeBlock, mismo shape que `Save.attributes`/`Npc.attributes`.
  attributes         Json?
  /// Mismo enum que Save/NpcState — participa en `resolveExchange` exactamente igual que el
  /// jugador o un Npc. Arranca ILESO; nunca se inicializa junto a `attributes: null` (sin
  /// atributos no hay combate posible, el valor por defecto de aquí es irrelevante en ese caso).
  condicionFisica    CondicionFisica     @default(ILESO)
  /// Fase 3 § 3a de efectos de clase (2026-08-27, docs/21-roadmap.md) — mismo campo que
  /// `Save.activeEffects`/`NpcState.activeEffects` (`ActiveEffect[]`, `services/activeEffects.ts`),
  /// faltaba aquí porque `Companion` no participaba todavía en `combateMultipleOrquestacion.ts`
  /// cuando se construyó Fase 2. Mismo criterio de reset: se vacía en cuanto `condicionFisica`
  /// vuelve a ILESO.
  activeEffects      Json                @default("[]")
  combatParticipants CombatParticipant[]

  /// Grupos de combate (2026-09-08, diseño explícito de la usuaria: "grupos de 4 con los
  /// compañeros... el Grupo 1 siempre estará el PJ a la cabeza... podrás mover tus compañeros
  /// entre los diferentes grupos, un poco como las habilidades de combate") — mismo `slotIndex`
  /// que ya usa `SkillBar`, 0 = Grupo 1 (el que entra a combate en directo junto al jugador,
  /// nunca vacío de PJ aunque sí pueda estarlo de compañeros). Default 0: un compañero recién
  /// domesticado/reclutado empieza en el Grupo 1 sin que el jugador tenga que moverlo a mano.
  combatGroupSlotIndex Int @default(0)

  @@index([saveId])
  @@index([plantillaEquipoId])
  @@index([saveId, combatGroupSlotIndex])
}

/// Grupos de combate (2026-09-08) — solo METADATA (nombre) de cada grupo más allá del 0 (Grupo 1,
/// que siempre existe implícitamente, con el PJ a la cabeza, y no necesita fila propia salvo que
/// el jugador quiera renombrarlo). Mismo patrón que `SkillBar`: `slotIndex` + `name` renombrable.
/// La pertenencia real de cada Companion a un grupo vive en `Companion.combatGroupSlotIndex`, no
/// aquí — esta tabla solo decide qué grupos EXISTEN y cómo se llaman.
model CombatGroup {
  id        String   @id @default(cuid())
  saveId    String
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  slotIndex Int
  name      String
  createdAt DateTime @default(now())

  @@unique([saveId, slotIndex])
  @@index([saveId])
}

/// Combate múltiple (Grupo 3, 2026-08-25, diseño completo en docs/rpgtarkor/combate-multiple.md)
/// — sesión de combate persistida de verdad, sustituyendo el estado repartido en campos sueltos
/// (`Save.pendingNpcAttack`, el truco `NpcState.groupSize`/`groupDefeated`) que solo servía para
/// 1v1. Tope duro de 4 combatientes por bando (§3) — un enfrentamiento mayor se PARTE en varios
/// `CombatEncounter` (uno jugable, el resto resueltos deterministas de una sentada, ver
/// `combateMultiple.ts` § resolverEncounterDeterminista).
model CombatEncounter {
  id                        String                @id @default(cuid())
  saveId                    String
  save                      Save                  @relation(fields: [saveId], references: [id], onDelete: Cascade)
  estado                    CombatEncounterEstado @default(EN_CURSO)
  ronda                     Int                   @default(1)
  /// Índice del combatiente actual DENTRO de `ordenIniciativa` — no el `CombatParticipant.id`
  /// directamente, para poder avanzar con un simple `+1 % length` sin buscar posiciones.
  turnoActual               Int                   @default(0)
  /// `CombatParticipant.id[]` ya ordenados por iniciativa — recalculado solo al empezar el
  /// encuentro (§1: "cada combatiente presente tira su propia iniciativa... se ordenan todos en
  /// una única cola"), nunca se re-tira a media pelea.
  ordenIniciativa           String[]              @default([])
  /// true = este es el sub-combate que la jugadora juega en directo (§3/§4) — los demás
  /// (sub-combates 4v4 sobrantes de un choque más grande, o cualquier combate sin la jugadora
  /// presente, p. ej. Reino defendiéndose) se resuelven deterministas de una sentada, sin turno a
  /// turno real.
  jugable                   Boolean               @default(true)
  /// Objetivo individual real (2026-08-26, docs/21-roadmap.md § Fase 3) — true mientras la ronda
  /// ACTUAL todavía no tiene el enganche (duelo/golpe gratis) decidido del todo porque falta saber
  /// a quién quiere atacar la jugadora. Mientras esté a true, NINGÚN intercambio de la ronda puede
  /// resolverse en firme (ni el de la jugadora ni el de ningún NPC/compañero, aunque su turno vaya
  /// antes que el de ella en `ordenIniciativa`) — la cancelación de un enganche (`resolverEnganchesRonda`,
  /// combateMultiple.ts) puede "alcanzar hacia atrás" a alguien que ya habría actuado. Se pone a
  /// true al crear el encuentro y al empezar cada ronda nueva (si hay jugadora viva y todavía sin
  /// reclamar); se pone a false en cuanto su elección de esa ronda queda fija (reclamada por
  /// alguien, o elegida por ella).
  esperandoEleccionJugadora Boolean               @default(false)
  createdAt                 DateTime              @default(now())
  resolvedAt                DateTime?
  participantes             CombatParticipant[]

  @@index([saveId])
}

enum CombatEncounterEstado {
  EN_CURSO
  RESUELTO
}

/// Un combatiente real dentro de un `CombatEncounter` — solo referencia (bando/tipo/a quién
/// apunta), nunca duplica atributos/condición física: esos siguen viviendo en `Save`/`NpcState`/
/// `Companion` (la fuente de verdad de siempre), leídos en vivo en cada turno. Evita el bug real
/// de tener dos copias de "cuánta vida le queda a X" que puedan desincronizarse.
model CombatParticipant {
  id                        String                @id @default(cuid())
  encounterId               String
  encounter                 CombatEncounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  bando                     CombatBando
  tipo                      CombatParticipantTipo
  /// Exactamente uno de los 3 rellena según `tipo` — JUGADOR no necesita ninguno (ya es `save`,
  /// vía `encounter.saveId`).
  companionId               String?
  companion                 Companion?            @relation(fields: [companionId], references: [id], onDelete: Cascade)
  npcId                     String?
  npc                       Npc?                  @relation(fields: [npcId], references: [id], onDelete: Cascade)
  /// Scope real del Npc en ESTA escena (mismo criterio que `NpcState.scope`) — necesario para
  /// resolver la fila `NpcState` correcta cuando el Npc es `PLANTILLA` (varias apariciones
  /// posibles del mismo arquetipo). Vacío para JUGADOR/COMPANION.
  npcScope                  String                @default("")
  /// Otro `CombatParticipant.id` del bando contrario — el emparejamiento vivo de cada turno (§2),
  /// null si su bando contrario ya no tiene nadie vivo (combate a punto de cerrarse) o si el
  /// jugador todavía no ha elegido objetivo esta ronda.
  objetivoActualId          String?
  /// ÚNICA excepción al criterio de arriba ("nunca duplica atributos/condición", ver comentario
  /// del modelo) — solo para miembros reales de un grupo cazado (§3 de companeros-y-supervivencia
  /// no aplica aquí, esto es combate múltiple de verdad, no el truco antiguo de
  /// `NpcState.groupSize`/`groupDefeated` que este sistema sustituye). Varios lobos reales de la
  /// misma especie comparten el mismo `(npcId, npcScope)` de `NpcState` — esa fila es 1 por
  /// especie+ubicación, no puede guardar la condición de CADA individuo del grupo por separado.
  /// null = combatiente normal (JUGADOR/COMPANION/NPC solitario), su condición real sigue viviendo
  /// en Save/Companion/NpcState como siempre. Con valor = miembro de un grupo, este campo ES su
  /// única fuente de verdad real (NpcState de un miembro de grupo se queda en ILESO, sin usar).
  condicionFisicaGrupo      CondicionFisica?
  /// Fase 3 § 3a de efectos de clase (2026-08-27, docs/21-roadmap.md) — `CONTROL` real: cuántas
  /// rondas le quedan a este combatiente actuando contra su PROPIO bando en vez del contrario
  /// (`resolverTurnoAutonomo`/`resolverTurnoJugador`, combateMultipleOrquestacion.ts). Null/0 =
  /// combatiente normal. Se decrementa una vez por ronda (mismo punto donde avanza `ronda`), nunca
  /// dentro de la misma ronda en que se fija (mismo cuidado de orden que `ActiveEffect.
  /// turnsRemaining`, ver activeEffects.ts).
  controladoPorRondas       Int?
  /// Fase 3 § 3c de efectos de clase (2026-08-27, docs/21-roadmap.md) — `OCULTACION` real: cuántas
  /// rondas le quedan a este combatiente oculto (excluido de ser ELEGIDO como objetivo por el
  /// enganche, `resolverEnganchesRonda`, salvo que sea el único vivo de su bando — sigue pudiendo
  /// actuar con normalidad). Null/0 = no oculto. Se pierde de inmediato si el propio combatiente
  /// ataca mientras está oculto (ficha real de Camuflaje), y se decrementa igual que
  /// `controladoPorRondas` (una vez por ronda, nunca dentro de la misma ronda en que se fija).
  ocultoPorRondas           Int?
  /// Fase 3 § 3d de efectos de clase (2026-08-27, docs/21-roadmap.md) — `INVOCACION` real: solo
  /// relleno para `tipo: INVOCACION` (un tótem/elemental, nunca JUGADOR/COMPANION/NPC normal).
  /// Cuántos golpes recibidos más aguanta antes de desaparecer ("aguanta 1 golpe" en la ficha real
  /// de Tótem de Guerra) — al llegar a 0, se trata como derrotado (mismo criterio que
  /// CONVALECIENTE/MUERTO: fuera de `objetivosValidos`/enganches). Distinto de `condicionFisicaGrupo`
  /// (esto no tiene HERIDO/GRAVE intermedios, solo "aguanta N golpes más o desaparece").
  invocacionVidaRestante    Int?
  /// Cuántas rondas más ataca antes de desaparecer por tiempo agotado (aunque no haya recibido
  /// ningún golpe) — "ataca durante 2 turnos y desaparece" en la ficha real. Se decrementa en el
  /// mismo punto de cruce de ronda que `controladoPorRondas`/`ocultoPorRondas`; al llegar a 0 se
  /// retira del encuentro igual que si hubiera agotado `invocacionVidaRestante`.
  invocacionRondasRestantes Int?
  /// Quién la invocó (otro `CombatParticipant.id`, siempre del MISMO bando) — necesaria para el
  /// candado real de la ficha ("NO se puede invocar más de un tótem de este tipo a la vez": se
  /// consulta antes de crear una invocación nueva del mismo `npcId` para el mismo invocador) y para
  /// que el tótem ataque siempre al bando contrario del suyo, nunca al de su propio invocador.
  invocacionInvocadorId     String?
  /// Fase 3 § 3e de efectos de clase (2026-08-27, docs/21-roadmap.md) — `EXPULSAR` real: cuántas
  /// rondas le quedan a este combatiente expulsado del combate (excluido de ser ELEGIDO como
  /// objetivo por el enganche, `resolverEnganchesRonda`, salvo que sea el único vivo de su bando —
  /// misma excepción y mismo mecanismo exacto que `ocultoPorRondas`, columna separada a propósito:
  /// conceptualmente son cosas distintas — uno se esconde, al otro lo empujan fuera a la fuerza —
  /// aunque la lógica de exclusión sea idéntica). Simplificación consciente frente a la ficha real
  /// de Embate de Escudo (2 tramos por margen, 50% de volver, "no vuelve nunca" en el tramo alto):
  /// aquí un único margen decisivo dispara siempre "expulsa 2 rondas, vuelve solo al cumplirlas o
  /// antes si su bando se queda sin nadie más vivo" — sin tirada de 50%, sin caso "nunca vuelve"
  /// por separado (decisión explícita de la usuaria, "vamos con que expulse directamente y punto").
  /// Se decrementa igual que `ocultoPorRondas`/`controladoPorRondas` (una vez por ronda, nunca
  /// dentro de la misma ronda en que se fija).
  expulsadoPorRondas        Int?
  /// "Analizar Rival" real en combate múltiple (2026-08-27, bug real jugando junto al identificador
  /// de combatientes duplicados) — mismo criterio de columna separada que `condicionFisicaGrupo`:
  /// `NpcState.analizado` es compartido por `(npcId, scope)`, la fila de la ESPECIE, no de un
  /// individuo — marcarlo ahí al analizar a un solo buitre de un grupo desbloquearía la ficha de
  /// análisis para TODOS los buitres del grupo a la vez, un efecto colateral no pedido por ninguna
  /// habilidad real (no existe ninguna fila de `clases.md` que combine `ANALISIS`+`MULTIPLE`).
  /// null/false = miembro de grupo sin analizar (o combatiente solitario, que usa `NpcState.
  /// analizado` como siempre — este campo se queda `null` para él). Nunca se resetea a `false`
  /// (mismo criterio idempotente que `NpcState.analizado`/`saqueado`).
  analizadoGrupo            Boolean?
  /// Bug real jugando en vivo (2026-08-29, primer combate múltiple real: "la tarjeta MATAR/
  /// CLEMENTE reaparece tras recargar") — mismo criterio de columna separada que
  /// `condicionFisicaGrupo`/`analizadoGrupo`: Clemente/Capturar sobre un miembro de GRUPO solo
  /// podían escribir en `Save.pendingCombatNpcSlugs` (el campo que consume el motor 1v1 clásico) o
  /// en `NpcState` (compartido por toda la especie, sin noción de "cuál individuo concreto"), pero
  /// `GET /saves/:id` reconstruye la tarjeta de combate múltiple leyendo `CombatParticipant`, sin
  /// mirar ninguno de los dos — la decisión de la jugadora se perdía en cuanto recargaba. `true` =
  /// la jugadora ya decidió Clemente/Capturar sobre ESTE individuo concreto, se excluye de la
  /// tarjeta de decisión pendiente aunque su `condicionFisicaGrupo` siga CONVALECIENTE (Clemente no
  /// cambia la condición a propósito, ver el propio endpoint). Null/false = sin decidir todavía, o
  /// combatiente solitario (que no lo necesita — su `condicionFisica` real en Save/NpcState/
  /// Companion ya basta). Nunca se resetea a `false` (mismo criterio idempotente que el resto de
  /// estos campos "Grupo").
  dismissedGrupo            Boolean?
  /// `PROVOCACION` real (2026-09-14, docs/rpgtarkor/clases.md — Guardián 16/19, Lancero 32,
  /// Especialista 28, Caballero del Valor 12/28) — cuántas rondas le quedan a este combatiente
  /// PROVOCADO: mientras dure, si le toca ELEGIR objetivo en `resolverEnganchesRonda` (§2 de
  /// combate-multiple.md), no usa su IA normal — es forzado a reclamar a `provocadoPorId`. Mismo
  /// criterio de decremento que `ocultoPorRondas`/`expulsadoPorRondas` (una vez por ronda, nunca
  /// dentro de la misma ronda en que se fija). Null/0 = no provocado.
  provocadoPorRondas        Int?
  /// Quién provocó a este combatiente — otro `CombatParticipant.id`, siempre del bando CONTRARIO
  /// (nunca tiene sentido provocarte a ti mismo hacia tu propio bando). Se lee solo cuando
  /// `provocadoPorRondas > 0`; queda con el último valor tras expirar (no se limpia a propósito,
  /// mismo criterio que el resto de campos "PorRondas" de este modelo — nunca se lee sin comprobar
  /// primero el contador).
  provocadoPorId            String?
  /// `CANALIZAR` real en combate múltiple (2026-09-14, docs/rpgtarkor/clases.md — Tirador 24,
  /// Berserker 40, Convocador 40, Maestro Arquero/Ballestero) — mismo mecanismo ya construido para
  /// el 1v1 clásico (`Save.pendingCanalizacion`, turnResolution.ts), portado a `CombatParticipant`
  /// porque aquí el "objetivo" ya no es un único NPC fijo (`PendingCanalizacion.npcId`): en combate
  /// múltiple el objetivo real es quien te tenga enganchado esa ronda (`objetivoActualId`), así que
  /// no hace falta guardarlo aparte. Shape real: `{ abilityName, attribute, attributeBonus,
  /// effects }` (mismo shape que `PendingCanalizacion` menos `npcId`) — null = no canalizando.
  /// "CANALIZAR no da nada por sí solo, solo implica que la habilidad tarda X turnos (1 si la ficha
  /// no especifica) — si te golpean [con un golpe DECISIVO] se corta la canalización" (diseño
  /// confirmado por Álvaro, mismo criterio que el 1v1). Se limpia a `null` tanto al completarse
  /// (dispara el golpe diferido) como al cortarse (golpe decisivo recibido mientras canaliza).
  canalizando               Json?
  /// `MARCAR` real (2026-09-14, docs/rpgtarkor/clases.md — Domador 24, Concentración del Domador)
  /// — cuántas rondas le queda a ESTE combatiente (siempre un COMPANION) forzado a elegir
  /// `marcaObjetivoId` en vez de su IA normal de Inteligencia (`elegirObjetivo`,
  /// combateMultiple.ts). Mecanismo inverso a `provocadoPorRondas` (ahí el motor decide a quién te
  /// fuerzan a atacar A TI; aquí el jugador decide a quién fuerza a atacar SU COMPANION) — vive en
  /// el propio `CombatParticipant` del Companion, no del objetivo marcado, porque es él quien
  /// recibe la instrucción. Mismo criterio de decremento que `provocadoPorRondas` (una vez por
  /// ronda). Null/0 = sin marca activa, el Companion sigue su IA normal.
  marcaObjetivoRondas       Int?
  /// A quién debe atacar preferentemente — otro `CombatParticipant.id`, siempre del bando
  /// CONTRARIO al del Companion. Se lee solo cuando `marcaObjetivoRondas > 0`; si el objetivo
  /// marcado muere/deja de ser candidato válido antes de expirar la marca, el Companion cae de
  /// vuelta a su IA normal ese turno (mismo criterio de "sin candidato válido" del resto del motor
  /// — nunca fuerza un objetivo inválido).
  marcaObjetivoId           String?
  /// `AREA` real, variante DEFENSIVA (2026-09-14, docs/rpgtarkor/clases.md — Instintivo 28,
  /// Instinto de Reserva: "te defiende de TODOS los ataques dirigidos a ti") — cuántas rondas le
  /// queda a ESTE combatiente el efecto de área activo. A diferencia de un disparo único, esto NO
  /// se resuelve una vez al activarlo: mientras `areaDefensaPorRondas > 0`, CADA intercambio donde
  /// este combatiente defiende tira SU PROPIA tirada de defensa con el margen decisivo normal — si
  /// la gana, intercepta el golpe (mismo criterio que AGUANTE ya existente, pero repetido cada
  /// intercambio en vez de una sola vez). Null/0 = sin efecto activo, defensa normal.
  areaDefensaPorRondas      Int?
  /// `AREA` real, variante PERSISTENTE (2026-09-14, docs/rpgtarkor/clases.md — Supervivencia 32,
  /// Trampa Improvisada: "todo el que le ataque se queda aturdido", trampa que dura 2 turnos) —
  /// cuántas rondas le queda a la trampa de ESTE combatiente (quien la colocó, no el objetivo).
  /// Mientras `areaTrampaPorRondas > 0`, CUALQUIERA que ataque a este combatiente dispara su propia
  /// tirada (margen decisivo del propio combatiente, no del agresor) — si la gana, el agresor queda
  /// aturdido, sin importar quién sea (a diferencia de PROVOCACION/MARCAR, no fija un objetivo
  /// concreto de antemano). Null/0 = sin trampa activa.
  areaTrampaPorRondas       Int?
  createdAt                 DateTime              @default(now())

  @@index([encounterId])
}

enum CombatBando {
  JUGADOR
  ENEMIGO
}

enum CombatParticipantTipo {
  JUGADOR
  COMPANION
  NPC
  /// Fase 3 § 3d de efectos de clase (2026-08-27) — tótem/elemental invocado en combate, ver
  /// comentario de `CombatParticipant.invocacionVidaRestante`. Su ficha de catálogo vive en `Npc`
  /// como cualquier otro (reutiliza `npcId`), así queda reconocible en la Enciclopedia igual que
  /// fauna — se descubre solo la primera vez que aparece, mismo mecanismo que el resto del catálogo
  /// (`entityDiscovery.ts`), sin ningún campo de "temporalidad" nuevo: el tótem individual dura 1-2
  /// turnos en combate, pero su FICHA de catálogo (igual que cualquier fauna cazada) es permanente.
  INVOCACION
}

enum CompanionTipo {
  FAUNA
  NPC
}

enum LoreChunkType {
  FAUNA
  FLORA
  NPC
  CLAN
  REGION
  LOOT
  CULTURA
  PERSONAJE
  CONTRATO
  /// Gancho de aventura — material concreto para que el Narrador/entorno introduzcan un
  /// suceso o encuentro, no un hecho fijo del mundo (docs/rpgtarkor/personajes.md § Ganchos).
  GANCHO
}

/// Fragmento de lore indexado para recuperación semántica (RAG, decisión 2026-07-17: en vez de
/// que el frontend mande una lista fija de "hechos del mundo" o que un humano los cure a mano por
/// región, el backend embebe la acción del jugador + el resumen del personaje y recupera los
/// fragmentos más relevantes de esta tabla — así el tamaño del contexto que se manda a Ollama no
/// crece con el tamaño total del lore, solo con lo relevante a la situación actual.
/// Fuente de verdad editorial: sigue siendo `docs/rpgtarkor/*.md` (para humanos); estos fragmentos
/// se curan a partir de ahí y se reindexan con `npm run reindex-lore` cada vez que el lore cambia.
model LoreChunk {
  id        String                      @id @default(cuid())
  worldId   String
  world     World                       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  type      LoreChunkType
  title     String
  text      String
  /// Palabras clave sueltas (raza, región, clan...) — no se usan para filtrar la búsqueda semántica,
  /// solo como metadato de depuración/trazabilidad hacia el .md de origen.
  tags      String[]
  sourceDoc String
  /// nomic-embed-text produce vectores de 768 dimensiones. Tipo no soportado nativamente por
  /// Prisma Client — se escribe/lee con SQL crudo ($executeRaw/$queryRaw) en lib/embeddings.ts.
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())

  @@index([worldId])
}

/// Habilidad guardada: un prompt reutilizable que el jugador puede lanzar directo al chat.
/// Efecto mecánico de una habilidad de COMBATE (roadmap habilidades de clase, checklist
/// 2026-07-21/22 puntos 1-2) — enum cerrado en vez de leer la intención por regex sobre el
/// `promptText` (mismo error ya pagado con matchNpcAliases/erratas): el motor necesita un switch
/// determinista para decidir REMATE/ATURDIMIENTO/INTIMIDACION/AGUANTE, no adivinarlo del texto.
enum AbilityEffect {
  // Hace daño
  ATAQUE
  // Deja aturdido/dormido al enemigo 1 turno.
  ATURDIMIENTO
  // Tiene la posibilidad de cancelar la accion del enemigo.
  INTIMIDACION
  // Te defiende de un ataque
  AGUANTE
  // Analiza al enemigo para ofrecer sus habilidades y stats
  ANALISIS
  /// PENDIENTES en bloque (2026-08-17, auditoría de comentarios "para hacer cambios" — RECUPERACION
  /// arriba es el único de este lote ya implementado, ver su comentario): INVOCACION/MULTIPLE/
  /// DESVIAR/ATENCION/OCULTACION exigen combate multi-objetivo de verdad (hoy es estrictamente
  /// 1v1) — CONTROL/COMPANERO se implementaron 2026-08-26 sin esperar a esa infraestructura (ver
  /// sus propios comentarios más abajo). LIMPIAR/CANALIZAR/CURAZION/REFLEJAR/EXPULSAR exigen
  /// efectos con duración real (turnos que se cuentan y expiran) — no existe todavía en el motor.
  /// Nombre + comentario de diseño se quedan tal cual hasta que se aborden aparte.
  //Invocar ser o seres que duran una cantidad de turnos determinada y luego desaparecen. Apoyos en el combate, sin equipo
  INVOCACION
  //Sangrados, venenos, maldiciones o discapacidades. Reduce tus attrs temporalmente
  /// PENDIENTE (2026-08-17) — "temporalmente" implica varios turnos, y hoy no existe ningún
  /// sistema de duración/expiración en el motor (ver PENDIENTE de AUMENTO, mismo motivo).
  DEBILIDAD
  //Habilidades que aumentan los attrs temporalmente
  /// PENDIENTE (2026-08-17, evaluado y descartado por ahora) — a diferencia de ATAQUE/
  /// INTIMIDACION/ATURDIMIENTO (consecuencias DESPUÉS de una tirada ya resuelta), un bonus de
  /// atributo tendría que aplicarse ANTES de tirar — cronología distinta al resto de efectos de
  /// utilidad, que exige tocar dónde se llama a `resolveIndependentExchange`, no solo el bloque de
  /// consecuencias — y sigue sin resolver la duración real de "temporalmente" (no hay sistema de
  /// turnos/expiración). Se deja para una pasada aparte, no a medias.
  AUMENTO
  //Limpia un efecto adverso (DEBILIDAD) propio activo
  /// Renombrado de RETIRAR a LIMPIAR (2026-09-15) — el nombre original inducía a pensar en "huir
  /// del combate", pero nunca fue eso: limpia un efecto DEBILIDAD encima tuyo. El sistema de HUIDA
  /// real es independiente (combatLore.ts, tirada de Destreza), no pasa por este AbilityEffect.
  /// IMPLEMENTADO (2026-09-15, docs/rpgtarkor/clases.md — Caballero del Valor 16/32, Manto de
  /// Purificación/Purga de Honor) — limpia el DEBILIDAD de MAYOR magnitud negativa entre los
  /// activos (ninguna ficha real aclara el criterio si hay varios; sin ningún DEBILIDAD activo, el
  /// efecto se pierde en silencio, mismo criterio de "sin candidato válido" del resto del motor).
  LIMPIAR
  //Efecto de habilidad que requiere de un turno de recarga para utilizar su efecto
  CANALIZAR
  //Proporciona efectos de curacion y recupera estados
  CURAZION
  //Efecto que es capaz de reflejar el efecto de una habilidad, no refleja las de daño ni las de defensa..solo las de utilidad.
  REFLEJAR
  //Efecto de habilidad que es capaz de hacer que un enemigo se retire del combate
  EXPULSAR
  //Efecto de habilidad que permite "controlar" al rival haciando que actue sobre el resto de enemigos durante los turnos que indique la habilidad
  /// IMPLEMENTADO parcialmente (2026-08-26) — sin combate multi-objetivo real, se simplifica a
  /// robar la iniciativa un intercambio (mismo mecanismo que ATURDIMIENTO, turnResolution.ts), en
  /// vez de los "2 turnos" reales de controlar al rival contra un aliado suyo. Se deja tal cual
  /// hasta que exista un segundo rival real al que redirigir.
  CONTROL
  //Efecto que permite aplicar la habilidad sobre un enemigo y que su efecto se replique en otros enemigos
  MULTIPLE
  //Efecto que permite eliminar a un rival de 1 golpe
  LETAL
  //Efecto que permite desviar la habilidad de un enemigo sobre otro de tu eleccion
  DESVIAR
  //Efecto que obliga a el/los enemigo/enemigos seleccionados a atacarte los turnos que indique la habilidad
  PROVOCACION
  //Efecto que permite que durante los turnos que diga la habilidad no se le podra atacar, si no es el unico enemigo/aliado
  OCULTACION
  //Efecto que refleja el daño fisico
  /// IMPLEMENTADO (2026-08-26) — el motor sigue sin un tipo de daño real, pero usa el atributo de
  /// la tirada como proxy (magia = mágico, el resto = físico): CONTRA contragolpea cuando el
  /// golpe entrante NO fue de Magia. Reutiliza el margen decisivo ya existente
  /// (`defensor_contragolpea`, ±10) en vez de un umbral propio por habilidad, ver turnResolution.ts.
  CONTRA
  //Efecto que refleja el daño magico
  /// IMPLEMENTADO (2026-08-26) — mismo mecanismo que CONTRA, invertido: contragolpea solo cuando
  /// el golpe entrante SÍ fue de Magia. Sin ninguna habilidad de clases.md que lo use todavía.
  REFRACTAR
  //Efecto que sirve para recuperar la energia indicada por la habilidad
  /// IMPLEMENTADO (2026-08-17) — bonus de energía este intercambio (RECUPERACION_ENERGY_BONUS,
  /// turnResolution.ts) cuando el efecto se dispara, mismo patrón que ATAQUE/INTIMIDACION/
  /// ATURDIMIENTO/ANALISIS (ver UTILITY_EFFECT_NARRATION).
  RECUPERACION
  //Efecto que sirve para limpiarse las debilidades o efectos negativos
  /// PENDIENTE (2026-08-17) — encaja de forma natural en el mismo camino de curación que ya usan
  /// descanso/objetos médicos (healCeilingFor/nextCondicionFisica, death.ts), pero esa vía tiene
  /// mucho historial real de bugs de combinación (ver comentarios de condicionPropuestaCombinada,
  /// turnResolution.ts) — se deja para una pasada dedicada solo a eso, con sus propios tests.
  PURIFICAR
  //Permite convertir fauna en compañeros, desbloquea slots de compañero que no contabilizan sobre los slots de compañero...es decir desbloquea un slot o slots donde iran nuestra "mascota" o compañeros de fauna
  /// IMPLEMENTADO (2026-08-26) — pasiva pura, sin turno que resolver: reutiliza `esSlotDomador`
  /// (companeros.ts § POST /tameo-pendientes/:npcSlug/confirmar), ya construido de antes y gateado
  /// por clase/especialización (`esDomador`) — esta fila del enum solo documenta el efecto, el
  /// motor no lo lee directamente todavía (no hace falta: el gate real es por clase, no por
  /// SavedAction desbloqueada). Restringido a fauna combatible, un slot garantizado por Domador.
  COMPANERO
  // Marca que la habilidad tiene un tope de usos por combate (ver maxUsesPerCombat en el propio
  // dato de la habilidad, y NpcState.abilityUsesThisEncounter para el contador real) — se combina
  // con cualquier otro efecto de la lista, p.ej. [LETAL, LIMITADA] con maxUsesPerCombat: 1.
  LIMITADA
  /// Nuevo (2026-08-24, Grupo 3 § Sistema de clases, clases.md § Chamán) — el ataque de ESTE
  /// turno pasa a usar el atributo Magia en vez del que le tocaría normalmente (arma/rol). A
  /// diferencia de AUMENTO/DEBILIDAD, no depende de duración por turnos: se resuelve entero
  /// dentro del mismo intercambio, igual que ATAQUE/ATURDIMIENTO — solo hacía falta darlo de alta.
  CONVERSION
  //Efecto que marca a un objetivo para que tu compañero/presa lo ataque preferentemente durante los turnos que indique la habilidad
  /// IMPLEMENTADO (2026-09-14, docs/rpgtarkor/clases.md § Domador — Concentración del Domador,
  /// único efecto del documento sin dar de alta hasta esta fecha) — mecanismo inverso al de
  /// PROVOCACION (fuerza a un RIVAL a atacarte a ti): aquí se fuerza a TU COMPANION a elegir un
  /// objetivo concreto en vez de su IA normal de Inteligencia (`elegirObjetivo`,
  /// combateMultiple.ts). Ver `CombatParticipant.marcadoParaId`/`marcaObjetivoId`.
  MARCAR
  //Efecto que alcanza a TODOS los rivales/aliados de un bando a la vez (o a cuantos indique la
  //habilidad), distinto de MULTIPLE (siempre exactamente un objetivo extra puntual)
  /// IMPLEMENTADO (2026-09-14, docs/rpgtarkor/clases.md — Opresor 32/36, Instintivo 28,
  /// Supervivencia 32) — genuinamente distinto de MULTIPLE (`objetivoExtraFor`, exactamente 1 extra
  /// aleatorio): 3 variantes reales, todas con UNA sola tirada del jugador/atacante, nunca tirada
  /// individual por rival — (1) ofensivo: dispara con margen decisivo, alcanza a TODOS los vivos
  /// del bando contrario al defensor (`objetivosExtraFor`, generalización de `objetivoExtraFor` sin
  /// tope de cantidad); (2) defensivo (Instinto de Reserva): se resuelve por intercambio
  /// individual — cada vez que alguien ataca a quien lo activó, SU propia tirada de defensa decide
  /// si ese golpe concreto se intercepta, mientras el efecto siga vivo (columna de duración); (3)
  /// persistente (Trampa Improvisada): columna de duración sobre quien la colocó, aplica el efecto
  /// a cualquiera que la ataque mientras esté viva, sin importar quién sea.
  AREA
}

/// Rol mecánico de una habilidad (rediseño de combate, 2026-08-09, petición explícita: "una
/// habilidad defensiva o de utilidad nunca hará daño directo... las de ataque sí") — distinto de
/// `AbilityEffect` (que sigue describiendo el efecto narrativo/mecánico concreto: qué pasa si
/// conecta). `rol` decide DOS cosas: (1) si puede hacer daño incondicional al conectar (solo
/// 'ataque' — cierra el hueco de hoy donde una habilidad AGUANTE elegida para atacar igual hacía
/// daño), y (2) cómo se resuelve el intercambio (`combatExchange.ts`): ataque-vs-defensa cruza
/// una tabla de resultados conjunta; en cuanto CUALQUIER lado es 'utilidad', cada lado tira
/// independiente y su propio éxito/fallo decide solo su propio efecto, nunca el del rival.
/// Mismo shape que el `categoria` que YA existía (sin usarse en combate real) para las
/// habilidades raciales de fauna en `Npc.habilidadesRaciales` (worldCatalog.ts) — este enum lo
/// generaliza a TODA habilidad de combate (arma, clase, racial humanoide, genérica).
enum AbilityRol {
  ataque
  defensa
  utilidad
  pasiva
}

/// Categorización mecánica de objetos (2026-07-29, petición explícita: "separar los items por
/// categorías... recursos... materiales... equipables... consumibles"). Bucket amplio y estable
/// — `ItemCatalog.category` (String, sin cambios) sigue existiendo como subtipo FINO dentro de
/// cada tipo (p.ej. tipo=RECURSO, category='piel'/'madera'/'piedra'/'mena'; tipo=EQUIPABLE,
/// category='arma'/'herramienta'/'ropa', igual que siempre).
enum ItemTipo {
  /// Se obtiene directo de la naturaleza (caza/tala/minería/extracción) — nunca se fabrica.
  RECURSO
  /// Sale de un proceso de crafteo/profesión (ver CraftingRecipe) — nunca se encuentra suelto.
  MATERIAL
  EQUIPABLE
  CONSUMIBLE
  /// Documentos, objetos de valor/trueque — sin mecánica de combate/equipo/consumo.
  NARRATIVO
  /// Efecto real, pero ni de combate ni de equipo (2026-08-03, petición explícita: "los items de
  /// tipo Especial... tendrán un efecto que será más complejo o útil para la narración o las
  /// posibilidades de juego" — p.ej. el Mapa de las Llanuras, o un futuro diario que desbloquea
  /// flora de una zona). Ver `effectKey`/`effectDescription` más abajo — sustituye el patrón de
  /// mirar `item.name === '...'` a mano en el frontend (así vivía el Mapa hasta ahora) por una
  /// clave real que cualquier sistema puede consultar.
  ESPECIAL
}

/// Categoría de arma (2026-07-29, sistema de habilidades por arma — "dependiendo el arma que
/// lleves las habilidades se adapten... hacer un cuchillo con una lanza es imposible"): decide
/// QUÉ atributo usa la habilidad de ataque/defensa que ese hueco de equipo genera — ver
/// WEAPON_CATEGORY_ATTRIBUTE en weaponAbilities.ts. Solo con sentido en objetos `category: 'arma'`.
enum WeaponCategory {
  HACHA_1_MANO
  HACHA_2_MANO
  MAZA_1_MANO
  MAZA_2_MANO
  GARROTE_1_MANO
  GARROTE_2_MANO
  PICA
  LANZA
  CUCHILLO
  DAGA
  ESPADA_1_MANO
  ESPADA_2_MANO
  ESCUDO
  ARCO_CORTO
  ARCO_LARGO
  HONDA
  BALLESTA
  BACULO
  BASTON
  GRIMORIO
  GUANTES
  RED
  /// Nuevo (2026-08-24, Grupo 3 § Sistema de clases, clases.md § Restricción de armas) — bastón
  /// de combate cuerpo a cuerpo, el "bo" de las artes marciales (Domador/Supervivencia de
  /// Cazador). NO confundir con `BACULO`/`BASTON` (focos MÁGICOS, atributo Magia) — VARA
  /// es un arma física de golpear, sin canalización arcana. Primer hueco de arma-Voluntad del
  /// motor (`WEAPON_CATEGORY_ATTRIBUTE`, weaponAbilities.ts).
  VARA
}

/// Restricción de armadura por peso (2026-08-31, Grupo 3 § Sistema de clases, clases.md §
/// "Restricción de armadura por peso") — mismo espíritu que `WeaponCategory`/restricción de armas
/// por clase, pero cubre las 9 clases de una vez (categorización más plana, no necesita el mismo
/// nivel de detalle previo que las armas). Solo aplica a las 6 ranuras de armadura real (CASCO,
/// ARMADURA_SUPERIOR, ARMADURA_INFERIOR, GUANTES, BOTAS, CINTURON) — CAMISA (ropa interior) y
/// joyería (ACCESORIO/ANILLO_1/ANILLO_2) se quedan fuera, sin restricción de peso.
enum PesoArmadura {
  LIGERO
  MEDIO
  PESADO
}

/// Qué acción/verbo exige `harvest.ts` para dar este recurso concreto (2026-07-29, petición
/// explícita: "para conseguir estos recursos debes cazar... o talar... o picar... a veces al
/// explorar la zona me saca recursos que no tiene sentido obtener directamente"). `discovery.ts`
/// (revelado al explorar genérico) solo sortea `PASIVO` — el resto exige nombrar la fuente y usar
/// el verbo correspondiente (`CAZA` además sigue exigiendo presa ya derrotada, ver harvest.ts).
enum MetodoObtencion {
  /// De verdad ambiental (hierba/piedra ya suelta) — el único que puede salir en "Explorar la zona".
  PASIVO
  CAZA
  TALA
  MINERIA
  /// Recolección deliberada de algo delicado (raíces, venenos) — verbo propio, pero no caza/tala/mina.
  EXTRACCION
  /// Profesión "pescador" (2026-09-02, zona 15 "Playa de Ceniza Blanca") — peces de verdad
  /// (Jashil/Toluh/Negueo), atrapados sin combate, nunca vía Cazar (esos NPC son 'INOFENSIVO'/
  /// 'CAUTELOSO', "no ataca, huye"). Verbo propio "Pescar", exige caña + cebo, mismo criterio de
  /// herramienta requerida por oficio que minero/desollador.
  PESCA
  /// Segunda mitad de "pescador" (2026-09-02) — marisco/caracoles enterrados en la arena (Bulco de
  /// Arena), verbo "Buscar": sin herramienta, solo Voluntad para dar con ellos.
  BUSQUEDA
}

/// Nivel de oficio (sesión de diseño 2026-07-23) — eje independiente del nivel de personaje, uno
/// por profesión practicada alguna vez (professionProgress.ts). `professionId` es el id de
/// professions.ts (frontend), no FK real — mismo criterio laxo que Save.profession. Sube al
/// craftear/construir con éxito una receta que declara ese `oficio` (crafting.ts/construction.ts);
/// su nivel alivia SOLO los requisitos de recetas de ese mismo oficio (requisitos.ts).
model ProfessionProgress {
  id           String   @id @default(cuid())
  saveId       String
  save         Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  professionId String
  nivel        Int      @default(1)
  xp           Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([saveId, professionId])
}

/// Economía de Reino (sesión de diseño 2026-07-23, kingdomTick.ts) — 1:1 con Save, se crea al
/// fundar el primer Territory (turnResolution.ts) — "el vacío es un estado válido"
/// (docs/10-niveles-xp-reino.md § 5.1): sin fila, no hay reino todavía, nada que tiquear.
model KingdomStats {
  id                String   @id @default(cuid())
  saveId            String   @unique
  save              Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  poblacion         Int      @default(0)
  felicidad         Int      @default(50)
  comida            Int      @default(0)
  bebida            Int      @default(0)
  riqueza           Int      @default(0)
  soldados          Int      @default(0)
  trabajadores      Int      @default(0)
  visitantes        Int      @default(0)
  /// Rachas de días consecutivos de felicidad alta/baja (2026-08-23, Grupo 3 § Territory.control) —
  /// puro estado interno del tick, nunca se serializa al frontend. Se resetea a 0 en cuanto la
  /// felicidad sale de su banda (ver `tickKingdomOneDay`, kingdomTick.ts). Cruzar el umbral de días
  /// dispara consolidar/perder territorios — ver el bloque de `diasCruzados` en turnResolution.ts.
  diasFelicidadAlta Int      @default(0)
  diasFelicidadBaja Int      @default(0)
  updatedAt         DateTime @updatedAt
}

/// El cupo lo da el nivel (docs/10-niveles-xp-reino.md § 4.3): 3 + floor(nivel/2).
model SavedAction {
  id                      String          @id @default(cuid())
  saveId                  String
  save                    Save            @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name                    String
  promptText              String
  /// Un emoji — icono del botón en el panel de Habilidades.
  icon                    String          @default("✨")
  /// Texto corto para el tooltip al pasar el ratón — qué hace la habilidad, de cara al jugador.
  description             String          @default("")
  /// Habilidades "de serie" (creadas al iniciar la partida, ej. las de Gorhorn) no cuentan
  /// contra el cupo por nivel (habilidadSlotsForLevel) — ese cupo es solo para las que el
  /// jugador va creando él mismo. Ver docs/10-niveles-xp-reino.md § 4.3.
  isStarting              Boolean         @default(false)
  /// Libre, no enum cerrado (misma razón que Companion.role): "combate", "exploracion",
  /// "social" son las sugeridas en la UI, pero no hay lista cerrada de categorías posibles.
  /// Como en cualquier RPG: la barra de fuera de combate no es la misma que la de dentro.
  category                String          @default("general")
  /// Solo relevante para category:'combate' (nunca en habilidades creadas a mano por la
  /// jugadora — esas siguen siendo 'general', ver POST /saves/:id/abilities). Array vacío en
  /// partidas ya en curso hasta que se reinicien o suba de nivel de nuevo (mismo patrón
  /// aditivo/nullable que el resto del proyecto). Lista, no valor único (2026-08-15, petición
  /// explícita: "que una habilidad pueda tener múltiples AbilityEffects") — cada efecto de la
  /// lista se comprueba de forma independiente al resolver el intercambio (turnResolution.ts).
  effects                 AbilityEffect[] @default([])
  /// Tope de usos por combate (2026-08-15, junto a AbilityEffect.LIMITADA) — independiente de qué
  /// efectos lleve: null/undefined = sin tope. Ver NpcState.abilityUsesThisEncounter para el
  /// contador real.
  maxUsesPerCombat        Int?
  /// Rediseño de combate (2026-08-09) — ver comentario completo en `enum AbilityRol`. Mismo
  /// criterio nullable/aditivo que `effects`: solo relevante para category:'combate', null hasta
  /// que la partida se resincronice.
  rol                     AbilityRol?
  /// Atributo con el que se resuelve la tirada de esta habilidad — gana sobre la heurística de
  /// palabra clave de npcScene.ts (tabulatedAttackAttribute) cuando el turno manda `savedActionId`.
  preferredAttribute      String?
  /// Bonus de atributo fijo (2026-08-24, Grupo 3 § Sistema de clases, clases.md § "Habilidad de
  /// daño vs ataque básico") — se suma al valor CRUDO de `preferredAttribute` antes del
  /// multiplicador de tipo al resolver el intercambio (`ExchangeParticipant.attributeBonus`,
  /// combatExchange.ts), nunca un bono plano a la tirada. Null = sin bonus (Ataque Básico y el
  /// resto de habilidades genéricas).
  attributeBonus          Int?
  /// Fase 2 de efectos de clase (2026-08-26, docs/21-roadmap.md) — solo relevante si `effects`
  /// incluye `AUMENTO`/`DEBILIDAD`: cuánto sube/baja (con signo, positivo AUMENTO/negativo
  /// DEBILIDAD) el atributo `preferredAttribute` mientras dure el efecto. Simplificación
  /// consciente (mismo criterio ya usado para LETAL/CONTRA/REFRACTAR): una cifra fija por
  /// habilidad, no la escalada "+4 si diferencia 6, +6 si diferencia 10" que describen algunas
  /// filas de `clases.md` en texto libre. Null = sin efecto de duración (el resto de habilidades).
  durationEffectMagnitude Int?
  /// Turnos que dura el efecto de arriba — junto con `durationEffectMagnitude`, ambos null o
  /// ambos rellenos.
  durationEffectTurns     Int?
  /// A quién recae el efecto de arriba cuando la habilidad conecta de forma decisiva (2026-09-09,
  /// Domador — "Vínculo Salvaje"/"Adiestrar"/"Grito Animal"/"Manada Furiosa" dicen "aumenta a tu
  /// bestia", no al propio jugador) — null/'self' = comportamiento de siempre (recae en quien usó
  /// la habilidad, jugador o NPC/Companion autónomo); 'companion' = recae en el Companion activo
  /// del bando de quien la usó en vez de en sí mismo. Solo tiene sentido en combate múltiple (el
  /// 1v1 clásico no tiene ningún concepto de Companion) — se ignora sin más fuera de ahí.
  durationEffectTarget    String?
  /// Habilidad racial/de arma recalculada automáticamente (2026-07-29, sistema de habilidades por
  /// arma) — a diferencia de `isStarting` (fija de por vida), estas se BORRAN y se vuelven a crear
  /// cada vez que cambia el equipo o el nivel, para reflejar siempre el arma que llevas puesta
  /// ahora mismo. Nunca editable/borrable por la jugadora (mismo criterio visual que isStarting).
  isDynamic               Boolean         @default(false)
  /// Sistema de fatiga (2026-07-29) — coste fijo por tramo (energy.ts § ENERGY_COST_BASICA/
  /// AVANZADA/ATAQUE_BASICO). 'general' se queda en 0.
  energyCost              Int             @default(0)
  /// Rediseño 2026-07-31 (petición explícita: "ataque básico no es una habilidad como las demás,
  /// ni defenderse ni esquivar... son acciones que tienen todos los personajes") — marca los 3
  /// genéricos (Ataque Básico, Defenderse, Esquivar) para separarlos en su propio bloque en la UI
  /// y excluirlos del cupo de 10 habilidades (antes se usaba `energyCost === 0` para esto último,
  /// una heurística que dejó de servir en cuanto Ataque Básico pasó a costar 5 en vez de 0).
  isGeneric               Boolean         @default(false)
  /// Energía que RECUPERA usar esta habilidad en un intercambio de combate real (2026-07-31) —
  /// Defenderse=10/Esquivar=5, 0 en el resto (incluido Ataque Básico, que solo cuesta). Sustituye
  /// al viejo mecanismo de regen por ROL (¿el jugador atacó o se defendió este turno?) — ahora
  /// depende de LA HABILIDAD usada, no del rol, ver energy.ts § nextEnergia.
  energyRegen             Int             @default(0)
  /// Habilidad real por categoría exacta de arma (2026-07-31, petición explícita: "cada arma
  /// equipada te dará una habilidad de su tipo... si llevas 2 armas del mismo tipo tendrás solo 1
  /// habilidad de arma con doble efecto") — true cuando esta habilidad colapsó porque ARMA_
  /// PRINCIPAL y ARMA_SECUNDARIA llevan la MISMA categoría (ver weaponAbilities.ts §
  /// weaponAbilitiesFor). Se traduce en un bonus de dificultad al usarla (turnResolution.ts §
  /// DUAL_WIELD_DIFFICULTY_BONUS) — nunca en una segunda tirada real, decisión explícita para no
  /// duplicar el intercambio de combate en un mismo turno.
  dualWield               Boolean         @default(false)
  createdAt               DateTime        @default(now())

  @@index([saveId])
}

enum QuestStatus {
  ACTIVA
  COMPLETADA
  FALLIDA
}

/// Misión/objetivo narrativo (docs/09-panel-personaje.md § pestaña "Misiones", única pestaña
/// pendiente desde el diseño original). Mismo patrón que Territory/Building/Subject: el modelo
/// propone (newQuest/questProgress en narrador.ts), el backend valida y materializa — sin
/// bonificadores mecánicos propios, coherente con la decisión de mecánicas 6.
model Quest {
  id               String      @id @default(cuid())
  saveId           String
  save             Save        @relation(fields: [saveId], references: [id], onDelete: Cascade)
  /// Identificador estable de misión con lógica especial propia (roadmap 2026-09-03: "questSlug
  /// estructurado en Quest" — antes solo `ORCO_ENFURECIDO_QUEST_TITLE` en quests.ts comparaba por
  /// TÍTULO EXACTO, acoplando la mecánica al texto narrativo que se le muestra a la jugadora).
  /// null para cualquier misión genérica (la inmensa mayoría) — solo se rellena para las pocas con
  /// caso especial (objetivo/recompensa fija, condición de cierre propia), ver ORCO_ENFURECIDO en
  /// quests.ts. No es único por partida a propósito: no hay índice único, `findFirst` ya cubre la
  /// idempotencia real que hace falta (ver comentario de esa ruta).
  questSlug        String?
  title            String
  description      String
  status           QuestStatus @default(ACTIVA)
  /// Condición de cierre detectable por el backend (roadmap 2026-07-19, mecánicas): si esta
  /// misión se detecta como "derrotar a X" al crearse (match contra los NPCs del mundo, mismo
  /// matcher de npcScene.ts), aquí queda el id del Npc objetivo — sin FK real a propósito (mismo
  /// patrón laxo que CharacterTransit.zoneContext), porque un Npc de catálogo no pertenece a
  /// ninguna partida. En cuanto su NpcState pase a CONVALECIENTE/MUERTO en ESTA partida, el
  /// backend cierra la misión solo, sin depender de que el modelo repita el título EXACTO en
  /// "questProgress".
  targetNpcId      String?
  /// Mismo patrón que `targetNpcId` (roadmap 2026-07-20, P1 de Fable): si el título/descripción
  /// menciona una Location conocida del mundo (mismo `matchDestination` que usa `travel.ts` para
  /// resolver destinos), aquí queda su id — cierra sola la misión "llegar a Y" en cuanto se
  /// registra una `LocationVisit` nueva a este destino, sin que el modelo tenga que acertar el
  /// título EXACTO vía "questProgress".
  targetLocationId String?
  /// Mismo patrón: si el título/descripción menciona un objeto del catálogo (`ItemCatalog`), aquí
  /// queda su nombre (no id — se compara contra `InventoryItem.name`, que no siempre coincide con
  /// una fila de catálogo exacta: botín/despiece/crafteo pueden personalizar el nombre). Cierra
  /// sola la misión "conseguir Z" en cuanto se materializa un `InventoryItem` cuyo nombre lo
  /// menciona (loot, despiece, crafteo o "newItem" de la narración).
  targetItemName   String?
  /// Frase corta y accionable de qué hay que hacer (2026-07-25, petición explícita: "Objetivo"
  /// separado de `description`, que es texto narrativo/de trasfondo) — se muestra en el panel de
  /// Misiones. Nullable: las misiones ya existentes antes de este campo no tienen uno todavía.
  objetivo         String?
  /// Recompensa estática de la misión (petición explícita, 2026-07-25) — nunca decidida por el
  /// modelo, siempre fijada a mano al crear la misión (mismo criterio que loot de NpcItem: la
  /// única fuente de verdad es lo que el propio código define, nunca una invención libre). null =
  /// sin recompensa de XP definida todavía.
  rewardXp         Int?
  /// Nombres de objetos ya definidos como recompensa (solo texto para mostrar en el panel — la
  /// entrega real de esos objetos concretos sigue pasando por el mecanismo de loot/crafteo normal
  /// que ya exista; este campo no crea InventoryItem por sí solo, ver comentario de rewardXp).
  rewardItems      String[]    @default([])
  /// Recompensa no-objeto (2026-08-17, petición explícita: "añadir un reward que no sea item
  /// solo, sino también recetas, compañeros o pasivas temporales") — claves de `CraftingRecipe`
  /// (crafting.ts) que se desbloquean al completarse esta misión. Solo tiene efecto real en
  /// recetas marcadas `requiresUnlock: true` (ver comentario del campo en crafting.ts) — las 16
  /// recetas ya existentes no lo llevan, siguen disponibles para cualquiera exactamente como hoy.
  /// Entrega real en `grantQuestRewardRecipesAndCompanion` (questResolution.ts).
  rewardRecipeKeys String[]    @default([])
  /// Compañero de recompensa (2026-08-17) — plantilla fija {name, role, notes}, mismo shape que
  /// `Companion` sin el `id`/`saveId`. Sujeto al mismo tope real de slots que cualquier otro
  /// compañero (companionSlotsForRecipeKey) — si no hay hueco al completarse la misión, no se
  /// crea (nunca se pierde silenciosamente el resto de la recompensa por esto).
  rewardCompanion  Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([saveId])
}

enum TerritoryControl {
  RECLAMADO
  DISPUTADO
  CONSOLIDADO
  PERDIDO
}

/// Zona/territorio bajo control (o reclamación) del personaje (docs/10-niveles-xp-reino.md § 5.2).
model Territory {
  id          String           @id @default(cuid())
  saveId      String
  save        Save             @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name        String
  /// Nombre de región del lore (docs/rpgtarkor/areas.md) — string libre, no FK: el lore vive en .md
  region      String?
  description String
  control     TerritoryControl @default(RECLAMADO)
  /// Población anónima estimada — los súbditos SIN nombre son un número, no filas (ver Subject)
  population  Int              @default(0)
  acquiredAt  DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  buildings Building[]
  subjects  Subject[]

  @@index([saveId])
}

enum BuildingStatus {
  EN_CONSTRUCCION
  ACTIVO
  DANADO
  ABANDONADO
}

/// Edificio/estructura construida o tomada por el personaje (docs/10-niveles-xp-reino.md § 5.2).
model Building {
  id          String         @id @default(cuid())
  saveId      String
  save        Save           @relation(fields: [saveId], references: [id], onDelete: Cascade)
  /// Opcional: un refugio levantado en mitad del viaje no pertenece a ningún territorio
  territoryId String?
  territory   Territory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  /// Dónde se plantó de verdad (2026-08-04, primera construcción anclada al mapa: "el campamento")
  /// — opcional porque las construcciones libres del modelo (newBuilding, sin receta fija) no
  /// siempre tienen una Location real donde anclarse. Reutiliza el mismo nodo/Location que ya
  /// dibuja el mapa en vez de inventar coordenadas propias (el backend nunca las ha guardado).
  locationId  String?
  location    Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Clave de ConstructionRecipe (construction.ts: 'campamento'/'choza'/'ayuntamiento'...) si esta
  /// fila vino de una receta fija — null para construcciones libres que el modelo propuso vía
  /// `newBuilding` sin pasar por ninguna receta. Sirve para elegir el icono en el mapa y para
  /// enlazar con la ficha genérica de la Enciclopedia (misma `key` que ya usa esa ficha). El
  /// Ayuntamiento SIEMPRE guarda `'ayuntamiento'` aquí sin importar el tier — mejorarlo actualiza
  /// esta misma fila, nunca crea una nueva (docs/17-reglas-construcciones-reino.md).
  recipeKey   String?
  /// Nivel del Ayuntamiento (1=pequeño/2=mediano/3=grande) — null para el resto de construcciones,
  /// que no tienen niveles. Decide cuántos edificios de reino (choza...) puedes tener a la vez.
  /// OJO: NO es lo mismo que `ConstructionRecipe.tier` (construction.ts, dificultad "Craftable"
  /// 1-5 de la receta) — ese nunca se copia aquí, este campo solo lo rellena
  /// `ConstructionRecipe.ayuntamientoNivel` (docs/17-reglas-construcciones-reino.md).
  tier        Int?
  name        String
  /// Tipo libre ("refugio", "granja", "taller", "muralla", "monumento"...) — no enum cerrado,
  /// misma razón que Companion.role: no sabemos aún qué construirán los jugadores
  kind        String
  status      BuildingStatus @default(EN_CONSTRUCCION)
  description String
  /// Posición en el lienzo de Zona (2026-09-08, hallazgo real jugando en vivo: un campamento
  /// construido por el jugador nunca aparecía en el mapa de Zona, solo en el panel de Reino) —
  /// mismo lienzo 800×600 y mismo criterio que `DroppedItem.x/y` (POR PARTIDA, fija desde que se
  /// construyó). No se reutiliza `ZonePoint` para esto: ese modelo es catálogo COMPARTIDO por
  /// `locationId` (sin `saveId`), así que una fila ahí sería visible en TODAS las partidas de ese
  /// mundo, no solo en la que construyó el edificio — `Building` ya es por-partida, es el sitio
  /// correcto. Null = construcción libre sin posición conocida (p.ej. `newBuilding` del modelo, sin
  /// receta fija) o partida sembrada antes de esta pieza — el frontend simplemente no la pinta en
  /// el lienzo, sin romper nada (mismo criterio nullable que el resto del proyecto).
  x           Float?
  y           Float?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([saveId])
}

/// Súbdito CON NOMBRE — alguien que sigue/sirve al personaje ligado a su reino, no a su persona
/// (eso es Companion). Ver docs/10-niveles-xp-reino.md § 5.2/§ 5.3.
model Subject {
  id          String     @id @default(cuid())
  saveId      String
  save        Save       @relation(fields: [saveId], references: [id], onDelete: Cascade)
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  name        String
  /// "capataz", "guerrera", "consejera", "granjero"... — libre. Grupo 3 § Compañeros y
  /// supervivencia (2026-08-25) añade la convención 'guardia'/'trabajador'/'productor' para
  /// súbditos con `plantillaEquipoId` — sigue siendo texto libre, sin enum cerrado.
  role        String
  notes       String
  createdAt   DateTime   @default(now())

  /// Plantilla de equipo asignada (docs/rpgtarkor/companeros-y-supervivencia.md § 7) — null = sin
  /// auto-equipo, este súbdito no recibe nada del Almacén de Reino automáticamente.
  plantillaEquipoId String?
  plantillaEquipo   PlantillaEquipo? @relation(fields: [plantillaEquipoId], references: [id], onDelete: SetNull)
  inventoryItems    InventoryItem[]

  @@index([saveId])
  @@index([plantillaEquipoId])
}

/// Almacén de Reino (§6-7) — pool de objetos equipables a nivel de Reino, separado por completo
/// de la mochila personal (`InventoryItem.saveId`, que sigue siendo solo del propio personaje).
/// Solo entra por depósito manual (sin producción automática todavía) y solo sale por auto-equipo
/// hacia un `Subject`/`Companion` con `PlantillaEquipo` asignada (ver `companionSupervivencia.ts`).
model AlmacenItem {
  id          String   @id @default(cuid())
  saveId      String
  save        Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name        String
  description String
  /// Mismo shape que InventoryItem — se copian tal cual al depositar, y se restauran tal cual al
  /// auto-equiparse en un Subject/Companion (nunca se pierde el bonus real al pasar por el Almacén).
  statBonuses Json?
  catalogSlug String?
  createdAt   DateTime @default(now())

  @@index([saveId])
}

/// Plantilla de equipo (§7) — básica (`personalizada: false`, un puñado fijo por rol, no editable)
/// o personalizada (creada por la jugadora). Define qué ranuras rellenar con qué tipo de objeto;
/// el auto-equipo (`autoEquiparDesdeAlmacen`, companionSupervivencia.ts) la usa para decidir qué
/// coger del Almacén para cada Subject/Companion que la tenga asignada.
/// Barras de habilidades múltiples fuera de combate (2026-09-04) — hasta 3 por categoría
/// (General/Profesión/Reino), `slotIndex` fijo 0-2 (no se reordenan barras entre sí, solo su
/// contenido). `slotIndex: 0` es la barra base de cada categoría, nunca se puede borrar (mismo
/// criterio que `PlantillaEquipo.personalizada: false`). `abilityNames` identifica por NOMBRE de
/// `SavedAction`, no por id — mismo motivo que `Save.activeCombatAbilityNames`: habilidades
/// dinámicas se recrean con id nuevo, un id guardado aquí quedaría huérfano.
/// Rediseño (2026-09-06, hallazgo 10 de la sesión de pruebas) — antes 3 barras POR CADA categoría
/// (`general`/`profesion`/`reino`, 12 slots), ahora 3 barras EN GENERAL sin distinguir tipo (20
/// slots) — la categoría solo sigue existiendo como filtro de `SavedAction` para los 3 tabs del
/// editor (`SavedActionCategory`), ya no describe la barra en sí. Sin migración de datos desde el
/// esquema viejo (decisión explícita de la usuaria: "empezar de cero").
model SkillBar {
  id           String   @id @default(cuid())
  saveId       String
  save         Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  slotIndex    Int
  name         String   @default("Barra 1")
  abilityNames String[] @default([])
  createdAt    DateTime @default(now())

  @@unique([saveId, slotIndex])
  @@index([saveId])
}

model PlantillaEquipo {
  id            String      @id @default(cuid())
  saveId        String
  save          Save        @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name          String
  personalizada Boolean     @default(true)
  /// 'guardia' | 'trabajador' | 'productor' — mismo criterio de texto libre que Subject.role.
  rol           String
  /// Record<EquipSlot, { category?: string; catalogSlug?: string }> — un criterio de match por
  /// ranura a rellenar, mismo shape que `IngredientRequirement.match` (ingredients.ts) para no
  /// inventar un segundo lenguaje de matching.
  slots         Json
  /// Orden de servicio cuando el Almacén escasea y varias plantillas compiten por el mismo objeto
  /// — menor número = se sirve antes. Editable por la jugadora, sin jerarquía fija de rol.
  prioridad     Int         @default(0)
  createdAt     DateTime    @default(now())
  subjects      Subject[]
  companions    Companion[]

  @@index([saveId])
}

enum NpcKind {
  PRINCIPAL // individuo con nombre propio: stats y equipo FIJOS, nunca los inventa el modelo
  PLANTILLA // arquetipo instanciable ("guerrero orco rezagado"): statline canónica + rango de nivel
}

/// Menú contextual de interacción con NPC (2026-09-06, "hay que mirar bien cuándo y cómo lanzamos
/// el interactuar... en vez de depender de una habilidad suelta") — qué opciones ofrece ESTE NPC al
/// interactuar con él por diálogo. Ver `Npc.interactionTypes` (multivaluado a propósito, decisión
/// explícita de la usuaria: un mismo NPC puede ser varios tipos a la vez).
enum NpcInteractionType {
  MAESTRO_OFICIO // ofrece "Aprender profesión" si además tiene `teachesProfession`
  NPC_MISION // ofrece la opción de misión si tiene una oferta real pendiente para esta partida
  NPC_LORE // solo conversación — no añade ninguna opción mecánica más allá de Charlar
  // COMERCIANTE deliberadamente NO incluido todavía — sin mecánica real de comercio que lo
  // consuma; se añade cuando esa pieza se diseñe.
}

/// Disposición hacia el combate (2026-07-29, "si me encuentro un NPC 'Agresivo' me va a ser
/// imposible no acabar peleando"): hoy `shouldForceCombat` (turnResolution.ts) solo mira el VERBO
/// del jugador — un Aullador Rojo y un Corredor de Cauce reaccionan exactamente igual a "me
/// acerco y saludo".
///
/// Valor de CATÁLOGO fijo (orden de menos a más hostil, usado también como índice en
/// reputation.ts) — NO es lo que decide el motor en combate: la reputación de facción
/// (WorldState.factionsStatus) lo desplaza en caliente hacia un extremo u otro para calcular el
/// "temperamento efectivo" de esa partida concreta (effectiveTemperamento en reputation.ts). Un
/// NPC con `faction: null` (fauna, independientes) no tiene de qué reputación desplazarse —
/// se queda siempre en este valor de catálogo tal cual.
enum Temperamento {
  AMIGABLE // reputación excelente con su facción — nunca inicia combate, el más receptivo
  INOFENSIVO // nunca inicia combate — protegido de la red de seguridad de shouldForceCombat
  CAUTELOSO // depende de la acción del jugador — comportamiento actual, sin cambios
  AGRESIVO // casi cualquier interacción deriva en combate — fuerza combate en shouldForceCombat
  ENEMIGO // reputación pésima — fuerza combate igual que AGRESIVO; casi irrecuperable (ver reputation.ts)
}

/// "Interactuar" motor unificado de eventos de escena, gate de alcanzabilidad (2026-09-08) —
/// coherencia narrativa pedida explícitamente por la usuaria: "un cruzavientos sobrevuela la zona
/// buscando presa — como yo no puedo volar no debería poder 'atacar' a no ser que haga algo, o me
/// ataque él a mí". Volumen real en el catálogo hoy: muy pocas fichas (revisión 2026-09-08 sobre
/// las ~80 fichas de fauna existentes) — la mayoría es TERRESTRE por defecto, sin necesitar marcarse
/// explícitamente. Valor de CATÁLOGO fijo, igual que `Temperamento` — no lo decide el motor en
/// caliente, solo describe una capacidad física fija de la especie.
enum MedioMovimiento {
  TERRESTRE // por defecto — alcanzable sin ninguna condición narrativa extra
  AEREO // en vuelo/planeo — solo alcanzable si la narración describe una condición (posado, en nido, herido en tierra...)
  ACUATICO // en agua profunda — solo alcanzable con condición equivalente (en la orilla, varado, pescando desde tierra...)
}

/// Clase de combate (2026-08-24, Grupo 3 § Sistema de clases, diseño completo en
/// docs/rpgtarkor/clases.md) — 9 clases, 4 exclusivas de una raza jugable concreta (Chamán=orcos,
/// Caballero=goirntes, Segador=nabieus, Druida=faerus), el resto disponibles para cualquiera.
/// Esta pasada (2026-08-24) solo construye habilidades reales para GUERRERO/CAZADOR/CHAMAN — el
/// resto del enum existe porque sus nombres ya están cerrados en el doc, pero sus especializaciones
/// se quedan sin ninguna `ClassAbilityUnlock` todavía (mismo criterio "scaffolding sin habilidad"
/// que Domador/Totémico dentro de las 3 clases sí construidas, ver Especializacion abajo).
enum Clase {
  GUERRERO
  CAZADOR
  CHAMAN
  ARQUERO
  CABALLERO
  MAGO
  SEGADOR
  ASESINO
  DRUIDA
}

/// Especialización dentro de una `Clase`, elegida a nivel 10 (clases.md § Cómo funciona el
/// sistema). De las 31 aquí, solo 12 tienen alguna `ClassAbilityUnlock` real construida esta
/// pasada (Berserker/Guardián/Lancero/Especialista de Guerrero; Domador/Supervivencia/Tirador/
/// Instintivo de Cazador; Totémico/Rúnico/Convocador/Opresor de Chamán) — y de esas 12, Domador y
/// Totémico se quedan en 0 habilidades reales (bloqueadas por completo por compañeros/invocación,
/// infraestructura de combate multi-objetivo que todavía no existe, ver combate-multiple.md).
enum Especializacion {
  BERSERKER
  GUARDIAN
  LANCERO
  ESPECIALISTA
  DOMADOR
  SUPERVIVENCIA
  TIRADOR
  INSTINTIVO
  TOTEMICO
  RUNICO
  CONVOCADOR
  OPRESOR
  MAESTRO_ARQUERO
  MAESTRO_BALLESTERO
  CABALLERO_DEL_ORDEN
  CABALLERO_DEL_VALOR
  CABALLERO_DEL_DOLOR
  PODER_MAGIA
  PODER_SEMILLA
  PARCA
  MALDITO
  ILUSTRADO
  TRANSMUTADOR
  MAESTRO_ASESINO
  ASESINO_TOXICO
  ASESINO_DANZANTE
  ASESINO_SELECTO
  CAMBIAFORMAS
  AULLADOR
  SALVAJE
  ADAPTADO
}

/// NPC del catálogo de mundo (no estado de partida — qué ha hecho un NPC en UNA partida
/// sigue viviendo en WorldState.facts, igual que hasta ahora). Sembrado desde
/// worldCatalog.ts; la prosa larga vive en docs/rpgtarkor/npcs.md y en lore chunks SIN números.
model Npc {
  id                  String               @id @default(cuid())
  worldId             String
  world               World                @relation(fields: [worldId], references: [id], onDelete: Cascade)
  kind                NpcKind
  slug                String
  name                String
  /// Formas reales de referirse a él/ella ("torgash", "el jefe de guerra serhu", "la terk'ikar")
  /// — para la detección determinista de "NPC en escena" (§ 2.5)
  aliases             String[]
  /// Clan o facción, libre ("Clan Serhu", "Concordia de Hierro") — null para independientes
  faction             String?
  /// Rol corto ("Kort'ikar del Clan Serhu", "soldado de patrulla") — libre
  role                String
  /// Artículo determinado ("el"/"la") que necesita `name` al presentarse en el contexto del
  /// Narrador — null si es un nombre propio que no lleva artículo (2026-07-31, bug real jugando:
  /// "se gira hacia la orca enfurecida... el Orco Enfurecido salta hacia él" — el modelo confunde
  /// el género de nombres descriptivos/de rol en la MISMA frase, nunca en nombres propios como
  /// "Gorhorn" o "Gistera Koh"). Curado a mano en worldCatalog.ts, nunca derivado del string del
  /// nombre — adivinar género gramatical por heurística es el mismo tipo de detector de texto
  /// libre que ya ha dado falsos positivos en este proyecto (ver npcScene.ts § matchNpcAliases).
  /// Se usa para REFORZAR el nombre en el propio contexto ("el Orco Enfurecido"), no para corregir
  /// la prosa después — más seguro que un reemplazo de texto a ciegas, que podría corromper una
  /// mención legítima en femenino de otro NPC real (p.ej. Gistera Koh) en la misma escena.
  articulo            String?
  /// Género gramatical ("M"/"F"), distinto de `articulo` (2026-08-07, bug real jugando,
  /// 2026-07-30: Gistera Koh — orca, femenino, ya explícito como primera palabra de su `bio` —
  /// narrada como "el orco"). `articulo` solo ayuda cuando el NOMBRE del NPC es un rol/descripción
  /// ("Orco Enfurecido"); esto cubre el caso contrario, un nombre propio ("Gistera Koh") al que el
  /// modelo se refiere de forma genérica en prosa libre en vez de por su nombre, ignorando el
  /// género ya establecido en `bio`. Null = no reforzado explícitamente (el modelo usa `bio` tal
  /// cual, como siempre) — se puebla solo donde ya se ha visto el fallo en vivo, no en todo el
  /// catálogo de golpe.
  genero              String?
  /// Nivel en la MISMA escala de docs/10-niveles-xp-reino.md. Para PRINCIPAL es fijo; para
  /// PLANTILLA es el nivel canónico (levelMax acota el rango típico). Hoy el motor no hace
  /// tiradas opuestas: este nivel sirve para que el clasificador calibre la dificultad y el
  /// Narrador el tono (§ 2.5), no para un sistema de combate simétrico.
  level               Int
  levelMax            Int?
  /// AttributeBlock { fuerza, destreza, sigilo, voluntad, carisma, magia }, rango 4-18 —
  /// mismo shape que Save.attributes para poder reutilizar tipos y validaciones
  attributes          Json
  /// Biografía/descripción corta + personalidad: el resumen que se inyecta en el prompt.
  /// La versión larga y los ganchos viven en los .md y en lore chunks.
  bio                 String
  personality         String
  /// Dónde se le encuentra normalmente — slug de Location, string (no FK: una plantilla
  /// puede aparecer "en cualquier ruta"), null = itinerante
  homeLocationSlug    String?
  /// `professionId` que este NPC enseña (2026-08-31, "Trabajador de Reino" — ver
  /// `POST /saves/:id/npc/:slug/aprender-oficio`) — mismo string que `ProfessionProgress`. Null =
  /// no enseña ningún oficio (la inmensa mayoría de NPC). Solo tiene sentido en un Maestro
  /// PRINCIPAL protegido (`capturablePct: 0`), coherente con `FactionBuilding.profession` del
  /// edificio donde vive — no se valida en BD que ambos coincidan (mismo criterio laxo del resto
  /// del catálogo de mundo), pero deberían mantenerse en sincronía al sembrar.
  teachesProfession   String?
  /// Menú contextual de interacción (2026-09-06) — qué opciones ofrece este NPC al interactuar
  /// por diálogo (ver enum `NpcInteractionType` arriba). MULTIVALUADO a propósito (decisión
  /// explícita de la usuaria: "el campo nuevo de tipo debe poder tener múltiples valores, pudiendo
  /// ser un npc de varios tipos a la vez"). Vacío = sin menú contextual — interacción libre de
  /// siempre, sin este menú de por medio (la inmensa mayoría de NPC hoy).
  interactionTypes    NpcInteractionType[] @default([])
  /// Rediseño de la vista de combate (2026-07-28, petición explícita: "usa habilidades de la
  /// enciclopedia... si vas a añadir nuevas reflejalas con el resto de habilidades bajo su
  /// clase") — las habilidades que se ven en la ficha de un NPC NO son un campo suelto por NPC
  /// (esa fue la primera iteración, descartada): salen de los mismos catálogos que ya sirve la
  /// Enciclopedia (`classAbilities.ts`, `berigLore.ts`/`BERIG_RAZAS`), enganchados aquí solo por
  /// referencia (`raza`/`clase`).
  ///
  /// - `raza`: slug de `BERIG_RAZAS` (goirntes/orcos/nabieus/faerus) — solo humanoides. Un NPC
  ///   humanoide tiene como mucho 1 habilidad racial, la de `BERIG_RAZAS[raza].habilidadRacial`
  ///   (compartida por toda su raza, no duplicada por fila).
  /// - `clase`: enum `Clase` (2026-08-24, antes `String?` libre) — solo "seres inteligentes que
  ///   pueden portar equipo". Sus habilidades salen de `classAbilityUnlocksForClase(clase)`
  ///   filtradas por `level` y, desde el sistema de especializaciones, por `especializacion`.
  ///
  /// Nota: se descartó a propósito una tercera taxonomía de "habilidades de profesión" en la
  /// ficha de combate — resultó ser un concepto distinto (recetas de crafteo tipo "Crear cuchillo
  /// de hielo sílice" que se desbloquean subiendo de nivel de oficio, categoría 'general' del
  /// panel de Habilidades, no 'combate'), aplazado a otra sesión. `Npc` no necesita ningún campo
  /// para eso.
  raza                String?
  /// Clase de combate (2026-08-24, Grupo 3 § Sistema de clases, ver docs/rpgtarkor/clases.md) —
  /// antes `String?` libre (comentario de arriba ya avisaba que "debería" ser esto). Solo
  /// humanoides con equipo real la llevan, igual que antes.
  clase               Clase?
  /// Especialización dentro de `clase`, ver comentario de `Save.especializacion`. Null = sin
  /// especialización asignada (tronco común, o clase sin especializaciones construidas todavía).
  especializacion     Especializacion?
  /// Categorías de raza de fauna (2026-09-02, sistema paralelo a `Clase` — ver
  /// `services/faunaAbilities.ts`) — string libre en vez de enum Prisma propio, mismo criterio
  /// que `raza` (slug de `BERIG_RAZAS`, no un enum): así una categoría nueva no exige migración,
  /// solo tocar el catálogo TS. Valores reales hoy: los 13 literales de `FaunaCategoria`
  /// (faunaAbilities.ts) — GUELISES/ACECHANTES/CORVENES/ZANCUDOS/BESTIONES/RONDINES/QUITINOS/
  /// ESCAMADOS/NADANTES/ORDENADOS/UMBRIAS/MUDOS_SALVAJE/ROKRATS_ESTALLIDO. Solo fauna (sin
  /// `raza`/`clase`) la lleva — null en NPCs humanoides y en fauna sin categoría asignada
  /// todavía. Concede las 7 habilidades base de categoría vía
  /// `faunaCategoriaAbilityUnlocksFor(faunaCategoria, level)`, filtradas por nivel igual que
  /// `classAbilityUnlocksForClase` — ver `npcCombatAbilitiesFor` (npcCombatAbilities.ts).
  faunaCategoria      String?
  /// Fauna/monstruos (sin `raza` — cada fila de fauna en worldCatalog.ts YA es una especie
  /// entera, no un individuo, así que su racial vive aquí en vez de en un catálogo aparte):
  /// hasta 6 habilidades raciales propias, `{ icon, name, description, categoria:
  /// 'ataque'|'defensa'|'utilidad', preferredAttribute }` (2 de cada, orientativo). Vacío en NPCs
  /// humanoides (su racial sale de `raza` en vez de este campo).
  ///
  /// Sistema de categorías de raza de fauna (2026-09-02) — cada entrada ahora lleva también
  /// `level` (int) y `effects` (AbilityEffect[]) reales, mismo shape que las habilidades de
  /// clase: son las 3 habilidades ESPECÍFICAS de este animal individual, encima de las 7 de su
  /// `faunaCategoria`, filtradas por nivel igual que esas — ver comentario actualizado en
  /// `NpcCombatAbility.effects` (npcCombatAbilities.ts) sobre el cambio de comportamiento. Sigue
  /// siendo Json libre (no un modelo/tipo Prisma propio) — mismo criterio que siempre, catálogo
  /// de seed, no estado de partida.
  habilidadesRaciales Json                 @default("[]")
  /// Frase corta del ataque natural (solo fauna, sin arma en su `loadout`) — alimenta el
  /// "Ataque base" calculado (baseAttack.ts) cuando no hay arma que describir. Null en NPCs
  /// humanoides (su Ataque base describe el arma de su `loadout` en su lugar).
  ataqueNatural       String?
  /// Disposición al combate, ver enum `Temperamento`. Default CAUTELOSO = comportamiento actual
  /// (depende del verbo del jugador), así que sembrar sin asignar esto explícitamente no cambia
  /// nada del comportamiento existente.
  temperamento        Temperamento         @default(CAUTELOSO)
  /// Medios de movimiento POSIBLES de la especie, ver enum `MedioMovimiento` — array, no valor
  /// único (2026-09-08, precisión de la usuaria: un anfibio real es TERRESTRE cuando se presenta en
  /// tierra Y ACUATICO cuando se presenta sumergido, "no puedo interactuar en agua sumergido
  /// lógicamente" — el mismo individuo cambia de medio ALCANZABLE según la escena, no según una
  /// propiedad fija). Este array solo declara qué medios existen para la especie en el catálogo;
  /// EN QUÉ MEDIO está un individuo/recurso concreto EN ESE TURNO (posado vs. sumergido) es estado
  /// dinámico de escena, no de catálogo — pieza sin diseñar todavía, ver plan de "Interactuar".
  /// Default `[TERRESTRE]` = comportamiento actual (alcanzable sin condición), así que sembrar sin
  /// asignar esto explícitamente no cambia nada. Solo relevante para fauna con `ZonePoint` tipo
  /// FAUNA — el gate real vive en el disparador de "Interactuar"/Cazar (turnResolution.ts/cazar.ts).
  medio               MedioMovimiento[]    @default([TERRESTRE])
  /// Capacidades de interacción (2026-07-29, "no siempre puedes domesticar a un animal de la misma
  /// raza... quiero que sea dinámico"): % (0-100) de que ESTA especie/individuo tenga la capacidad
  /// en absoluto, no un booleano fijo — un Aullador Rojo hambriento no siempre es domesticable.
  /// Deliberadamente solo datos de catálogo por ahora: la resolución real (tirada única por
  /// instancia de partida, persistida en NpcState, con el mismo rollCheck de dice.ts) se monta
  /// cuando exista una mecánica real de comerciar/reclutar/domesticar/capturar/cortejar que la
  /// consuma — hasta entonces sería estado sin ningún caller.
  comerciablePct      Int                  @default(0)
  reclutablePct       Int                  @default(0)
  domesticablePct     Int                  @default(0)
  capturablePct       Int                  @default(0)
  cortejablePct       Int                  @default(0)
  /// Atributo de resistencia (Grupo 3 § Compañeros y supervivencia, 2026-08-25, ver
  /// docs/rpgtarkor/companeros-y-supervivencia.md § 2/3) — CUÁL de los 7 atributos propios de este
  /// NPC/fauna (`attributes`, ya sembrado) se usa como resistencia en la tirada opuesta de
  /// tameo/persuasión. Reutiliza el valor YA existente en `attributes`, no un número nuevo
  /// paralelo — coherente con "cada fauna ya tiene rasgos/personalidad propios en su ficha". Solo
  /// calibrado a mano en NPC/fauna con `domesticablePct`/`reclutablePct` > 0; null en el resto
  /// (nada que tamear/persuadir).
  atributoResistencia String?
  /// Núcleo jugable actual (auditoría 2026-08-14, bug real jugando en vivo: "Sella Marn" — Nabieus
  /// de El Margen Silencioso, región marcada "fuera del núcleo jugable actual" en decenas de
  /// sitios del catálogo, pero solo como texto — apareció en combate real de todas formas).
  /// `npcScene.ts` da por candidato de escena a CUALQUIER NPC `kind: PRINCIPAL` sin mirar región
  /// ("personajes únicos pueden aparecer en cualquier sitio por guion"); este campo es lo que ese
  /// filtro comprueba ahora para las excepciones. Default `true` — solo se pone `false` en
  /// PRINCIPAL de regiones todavía no jugables (worldCatalog.ts).
  nucleoJugable       Boolean              @default(true)
  /// Compañero de fauna con nombre propio de OTRO Npc de catálogo (auditoría de lore 2026-09-13,
  /// hallazgo C10: "Gogorath"/"Gisoki" existían solo como texto libre en el `bio` de sus dueños,
  /// sin ficha real ni nivel ni equipo propios). Slug del Npc dueño, referencia laxa sin FK —
  /// mismo criterio que `homeLocationSlug`/`faction` (el catálogo entero usa strings libres para
  /// relaciones blandas, nunca fuerza una FK sobre datos de seed). Solo tiene sentido en una fila
  /// de fauna (`faunaCategoria`/`ataqueNatural` no-null, `clase`/`raza` null) — un compañero con
  /// nombre reutiliza exactamente el mismo shape que cualquier otra fila de fauna del catálogo
  /// (ver `gargantua-de-ceniza`/`aullador-rojo`), solo que `kind: PRINCIPAL` (individuo con
  /// nombre, no especie genérica) y protegido (`capturablePct`/`domesticablePct`/`reclutablePct:
  /// 0` — ya pertenece a su dueño, el jugador no puede cazarlo/domesticarlo/reclutarlo aparte).
  /// Null = NPC sin compañero (la inmensa mayoría). El enganche a combate múltiple vive en
  /// `turnResolution.ts` (ver comentario junto a `resolveCombatSlugsAndPersist`).
  companionOfNpcSlug  String?

  items              NpcItem[]
  npcStates          NpcState[]
  combatParticipants CombatParticipant[]

  @@unique([worldId, slug])
}

/// Facción/clan que el jugador puede descubrir (sección "Facciones" de la Enciclopedia,
/// 2026-08-06) — formaliza en tabla lo que hasta ahora era solo `Npc.faction` (string libre, sin
/// FK; el catálogo suelto `World.factions`, sin relación con esto, se quitó del schema en la
/// auditoría de elementos desconectados 2026-08-23). `raza` es también texto libre (uno de
/// BERIG_RAZAS, berigLore.ts — NO es una tabla, igual que `Npc.raza`), no una FK real. El enganche
/// con `Npc.faction` es por IGUALDAD EXACTA de `name` (ver entityDiscovery.ts) — no hay FK entre
/// Npc y Faction a propósito, mismo criterio que el resto del catálogo (Npc.raza tampoco
/// referencia BERIG_RAZAS con FK).
///
/// `saveId` (2026-08-06, "fundar tu reino ya fundaba tu facción, solo faltaba conectarlo" — ver
/// reino.ts): null = fila de catálogo de mundo (las sembradas en worldCatalog.ts, compartidas por
/// cualquier partida). Relleno = facción fundada DENTRO de esa partida al fundar el reino
/// (Ayuntamiento tier 1) — invisible para el resto de partidas del mismo mundo. El `@@unique`
/// sigue siendo `[worldId, slug]` sin cambios: el `slug` de una facción fundada incluye el
/// `save.id`, así que nunca choca ni con el catálogo ni con la de otra partida.
model Faction {
  id          String  @id @default(cuid())
  worldId     String
  world       World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  saveId      String?
  save        Save?   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  raza        String
  description String

  @@unique([worldId, slug])
}

/// Edificio de FACCIÓN AJENA (2026-08-31, "Trabajador de Reino" — Karot Veku) — deliberadamente
/// distinto de `Building` (que es 100% del Reino del JUGADOR: siempre `saveId`, se construye/
/// mejora gastando materiales por turno, protegido por `KingdomStats` 1:1). Este modelo es
/// CATÁLOGO DE MUNDO puro (`worldId`, nunca `saveId`) — existe igual en cualquier partida, el
/// jugador nunca lo construye ni lo mejora, solo lo visita. Sembrado a mano en `worldCatalog.ts`,
/// mismo criterio que `Npc`/`Location`. `profession: null` marca el edificio "sede" del
/// asentamiento (equivalente al Ayuntamiento del jugador — lo que "establece que existe" como
/// tribu/ciudad real) en vez de un edificio de oficio concreto.
model FactionBuilding {
  id           String  @id @default(cuid())
  worldId      String
  world        World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  /// String libre, no FK — mismo criterio que `Npc.faction` (comparación por igualdad exacta de
  /// nombre, no de slug).
  factionSlug  String
  /// Location EXTERIOR donde vive (p. ej. `campamento-serhu`) — el `ZonePoint` tipo EDIFICIO que
  /// lo representa en el mapa de Zona vive ahí, referenciando `slug` como `targetSlug`.
  locationSlug String
  /// `professionId` real (p. ej. `herrero-orco-llanuras`), mismo string que `ProfessionProgress`
  /// — null = este edificio es la SEDE del asentamiento (ver comentario del modelo), no un oficio.
  profession   String?
  /// 1=pequeño (1 trabajador) / 2=mediano (3) / 3=grande (6) — mismo espíritu de tiers que
  /// `ConstructionRecipe`, pero fijo de catálogo, nunca mejorable por el jugador.
  tier         Int
  description  String

  @@unique([worldId, slug])
  @@index([locationSlug])
}

/// Entrada de lore descubrible como objeto físico (libro/diario/nota) — sección "Historia" de la
/// Enciclopedia (2026-08-06). Dos eras: 'comun' (desde el año 0, `year` relleno, se agrupa en la
/// Enciclopedia por bloques de 500 años) y 'semillas' (mítica, anterior al año 0 — `year` siempre
/// null, lista plana sin bloques por lo disperso e impreciso del periodo). `documentoItemSlug` es
/// el objeto físico (`ItemCatalog.slug`, normalmente `category: 'documento'`) que desbloquea esta
/// entrada al descubrirse — mismo eje que el resto de `DiscoveredEntity`. `requiresTranslation` +
/// `translatorNpcSlug` (mecanismo "escrito en el idioma de las Semillas", petición explícita de la
/// usuaria): cuando es true, el TEXTO real (`text`) solo se sirve al frontend si el NPC traductor
/// referenciado también está descubierto — ver `/world/:slug/enciclopedia` (routes/world.ts) para
/// el cómputo real de `unlocked`, siempre en tiempo de lectura, nunca almacenado.
model HistoriaEntry {
  id                  String  @id @default(cuid())
  worldId             String
  world               World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  slug                String
  title               String
  era                 String
  year                Int?
  text                String
  requiresTranslation Boolean @default(false)
  documentoItemSlug   String
  translatorNpcSlug   String?

  @@unique([worldId, slug])
}

/// Estado de un NPC EN UNA PARTIDA CONCRETA (roadmap 2026-07-19 "roadmap 3", hallazgo de Fable):
/// antes no existía — cada escena leía siempre el Npc estático (nivel/atributos de catálogo), así
/// que "Torgash resucita" cada vez que aparece en escena, y el saqueo en combate se podía repetir
/// pulsando "Registrar" tantas veces como se quisiera. Determinista, sin IA — el modelo nunca
/// decide si un NPC está derrotado ni si ya se le saqueó.
model NpcState {
  id                          String          @id @default(cuid())
  saveId                      String
  save                        Save            @relation(fields: [saveId], references: [id], onDelete: Cascade)
  npcId                       String
  npc                         Npc             @relation(fields: [npcId], references: [id], onDelete: Cascade)
  /// Ámbito del estado (roadmap 2026-07-20, bug real P0): un Npc `PLANTILLA` es una única fila
  /// de catálogo compartida por TODAS sus apariciones en el mundo ("rezagado", "corredor de
  /// cauce"...) — sin esto, derrotar/saquear UNA aparición marcaba la plantilla entera como
  /// derrotada para siempre en la partida, rompiendo el combate contra la misma clase de NPC una
  /// segunda vez y reabriendo el farmeo infinito (el despiece exige presa previa, pero la presa
  /// nunca volvía a "no estar ya derrotada"). Para `PRINCIPAL` siempre "" (una sola fila global,
  /// mismo comportamiento que antes de este cambio — Torgash sigue siendo el mismo Torgash en
  /// cualquier escena). Para `PLANTILLA`, el `Location.id` donde ocurre ESTE encuentro concreto
  /// ("itinerante" si no hay ubicación resuelta en el turno) — así cada aparición nueva en un
  /// sitio distinto empieza fresca, sin memoria de otras plantillas del mismo arquetipo.
  scope                       String          @default("")
  condicionFisica             CondicionFisica @default(ILESO)
  /// Sistema de fatiga simétrico (2026-07-30, deuda técnica: "los NPC siguen eligiendo habilidad
  /// sin restricción de energía" — ver energy.ts) — null = tope completo, mismo criterio lazy que
  /// `condicionFisica` antes de que exista fila: un NPC nunca tocado no necesita fila propia. El
  /// tope real (energiaMaxFor(constitución)) nunca se persiste aquí, se deriva en caliente igual
  /// que en Save.
  energia                     Int?
  /// Rediseño 2026-07-31 (petición explícita: "si no saqueas todo el botón sigue para poder
  /// saquear lo que dejaste") — true = ya se copió TODO su loadout conocido al inventario del
  /// jugador (comparado contra `lootedItemNames`), bloquea "Registrar"/"Saquear todo" de nuevo
  /// sobre el mismo NPC hasta que la partida se reinicie. Antes se marcaba en cuanto se tocaba
  /// CUALQUIER objeto suyo (saqueo parcial perdía el resto para siempre); ahora depende de
  /// `lootedItemNames` cubrir el 100% de `Npc`/`ItemCatalog` asociados.
  saqueado                    Boolean         @default(false)
  /// Nombres de objeto YA copiados al inventario del jugador de este NPC, en esta partida
  /// (2026-07-31) — permite un saqueo parcial real: dejar algo sin marcar en el modal no lo
  /// pierde, una visita posterior solo ofrece lo que falta y nunca duplica lo ya tomado.
  lootedItemNames             String[]        @default([])
  /// Objetos entregados A MANO por el jugador a esta instancia concreta de NPC, en esta partida
  /// (2026-08-31, mecánica real de "dar objeto a NPC" — antes solo existía la mitigación de
  /// coherencia `hasFalseItemGivenAway`, sin ningún camino mecánico real). Array de
  /// `NpcItemInScene` ya aplanado/congelado en el momento de la entrega (mismo shape que
  /// `NpcItem` de catálogo tras pasar por `buildNpcInScene`) — así el loot entregado sobrevive
  /// aunque el `InventoryItem`/`ItemCatalog` original cambie después, y se suma a `npc.items`
  /// (buildNpcInScene, npcScene.ts) exactamente igual que el loadout fijo del catálogo: mismo
  /// pipeline de saqueo/decapitar, sin lógica paralela. Nunca se limpia — mismo criterio que
  /// `lootedItemNames`, es historial de esta instancia concreta.
  givenItems                  Json            @default("[]")
  /// Captura (Grupo 3 § Compañeros y supervivencia, 2026-08-25, ver
  /// docs/rpgtarkor/companeros-y-supervivencia.md § 1-3) — mismo patrón de claim-atómico que
  /// `saqueado`: true en cuanto se ata con éxito (trampa-de-lazo + GRAVE/CONVALECIENTE), bloquea
  /// volver a intentar atar a esta misma instancia. `capturaFelicidad` acumula el resultado de
  /// cada intento de alimentar (fauna, en jaula)/persuadir (NPC) — SOLO durante el proceso, antes
  /// de convertirse en `Companion` real (que tiene su propia `felicidad`, independiente). Al
  /// completar el tameo/persuasión con éxito y crear el `Companion`, estos 3 campos NO se limpian
  /// — quedan como registro de que esta instancia concreta ya se procesó, mismo criterio que
  /// `saqueado` nunca se resetea.
  capturado                   Boolean         @default(false)
  capturaFelicidad            Int             @default(0)
  /// Solo fauna — qué Jaula la aloja durante el tameo. Null para NPC (no necesita jaula, solo
  /// atado+persuasión) y para fauna todavía sin jaula asignada (recién atada).
  capturaJaulaBuildingId      String?
  /// Rediseño de combate (2026-08-09, "Analizar rival") — true en cuanto el jugador analiza con
  /// éxito a ESTE npc/scope concreto una vez, para siempre en esta partida (no hace falta
  /// repetirlo en el siguiente combate: el atributo recomendado es un dato fijo de sus
  /// `attributes`, no cambia entre encuentros). Gatea qué muestra la ficha del rival en combate
  /// (CombatPanel.tsx § EnemyFicha) — sin analizar, ni estadísticas ni habilidades.
  analizado                   Boolean         @default(false)
  /// Tope de usos por combate (2026-08-15, AbilityEffect.LIMITADA/maxUsesPerCombat) — mapa `nombre
  /// de habilidad → veces usada`, cuenta tanto lo que el JUGADOR ha usado contra este NPC como lo
  /// que este NPC ha usado contra el jugador en el encuentro actual (un solo contador compartido:
  /// hoy solo hay un jugador). No existe un concepto propio de "sesión de combate" persistido —
  /// se reutiliza la vuelta a `condicionFisica: ILESO` (descanso/curación entre combates, nunca
  /// durante uno) como frontera real para resetear a `{}`, mismo punto donde ya se limpian
  /// `saqueado`/`analizado`.
  abilityUsesThisEncounter    Json            @default("{}")
  /// Fase 2 de efectos de clase (2026-08-26) — ver comentario completo en `Save.activeEffects`,
  /// mismo shape (`ActiveEffect[]`), mismo criterio de reset (vuelta a `condicionFisica: ILESO`).
  activeEffects               Json            @default("[]")
  /// docs/19-post-combate-y-recompensas-mision.md pieza 2 (2026-08-13) — `fictionalMinutes` (no
  /// tiempo real, el reloj del mundo se pausa cuando el backend está parado) del momento en que
  /// `condicionFisica` pasó a su valor ACTUAL. Solo se usa cuando el valor actual es CONVALECIENTE
  /// (recupera a HERIDO a las 6h) o MUERTO (el cadáver desaparece a las 48h) — se rellena siempre
  /// que cambia por simplicidad, aunque para ILESO/HERIDO/GRAVE no se lea nunca.
  condicionFisicaSinceMinutes Int?
  /// Punto del jugador en el mapa (2026-09-04) — posición asignada a este NPC/fauna DINÁMICO (sin
  /// `ZonePoint` real sembrado) la primera vez que aparece en escena determinista
  /// (`detectNpcsInScene`) en una Location dada. Null = todavía sin posición. `zonaLocationId` es
  /// en qué Location se asignó (para saber si sigue vigente o toca reasignar al reaparecer en otro
  /// sitio) — redundante con `scope` para PLANTILLA pero explícito y correcto para los 2 `kind`.
  zonaPosX                    Float?
  zonaPosY                    Float?
  zonaLocationId              String?
  /// Combate ganado por el jugador (2026-09-04) — minuto de ficción (mismo criterio que
  /// `condicionFisicaSinceMinutes`, nunca tiempo real) hasta el cual este NPC/fauna deja de
  /// listarse/pintarse en Zona, aunque siga vivo. Null = no está marcado ausente.
  zonaAusenteHastaMinutes     Int?
  /// Caza en grupo (2026-08-13, petición explícita: "el jugador primero debe marcar contra
  /// cuantos quiere combatir... con un calculo determinista puede darse que salgan menos o más
  /// de los que marcaste... y que el narrador no prometa nada que no se realice por acción").
  /// Contador en la MISMA fila en vez de una fila por individuo (decisión explícita: no tocar el
  /// `@@unique([saveId, npcId, scope])` de arriba) — esta fila sigue representando UN individuo
  /// "activo" de combate a la vez; cuando cae, si `groupDefeated + 1 < groupSize` todavía quedan
  /// más, así que `condicionFisica` "resucita" a ILESO para el siguiente en vez de quedarse en
  /// MUERTO (ver `applyCombatExchangeToNpcState`/`applyExecuteTargets`, turnResolution.ts). null
  /// = encuentro solitario de siempre, sin cambio de comportamiento (todo el código que ya existía
  /// antes de este campo sigue funcionando igual, `groupSize` nunca se pone fuera de cazar.ts).
  groupSize                   Int?
  /// Cuántos individuos del grupo han caído (MUERTO) hasta ahora — sube en cada kill dentro del
  /// grupo, tope real en `groupSize`. Ver `corpsesLooted` para cuántos de esos cadáveres ya se
  /// despiezaron (recolectar.ts).
  groupDefeated               Int             @default(0)
  /// Cadáveres del grupo YA despiezados — sustituye a `saqueado` (booleano, solo tiene sentido
  /// para 1 individuo) cuando `groupSize` no es null. Disponibles para despiece ahora mismo =
  /// `groupDefeated - corpsesLooted`, nunca negativo.
  corpsesLooted               Int             @default(0)
  /// "Matar" pulsado sobre un CONVALECIENTE (2026-09-05, bug real jugando en vivo: el desbloqueo
  /// del composer tras pulsar "Matar" solo vivía en `combatNpcStates` de React —
  /// `useCombatFlow.ts`, `handleDecapitarSeleccion` — y no sobrevivía a una recarga de página: la
  /// tarjeta MATAR/CLEMENTE reaparecía de cero y el composer volvía a bloquearse hasta pulsar
  /// Matar de nuevo). Mismo criterio de reset que `analizado`/`saqueado`: se resetea cuando
  /// `condicionFisica` vuelve a ILESO (curación entre combates), nunca durante el mismo encuentro.
  /// El propio golpe de gracia sigue siendo un intercambio real (`explicitTarget`/habilidad
  /// elegida) — esto solo recuerda la DECISIÓN de intentarlo, no resuelve nada por sí mismo.
  targetedForKill             Boolean         @default(false)
  updatedAt                   DateTime        @updatedAt

  @@unique([saveId, npcId, scope])
}

/// Catálogo cerrado de objetos del mundo (armas, herramientas, materiales, consumibles,
/// documentos, objetos de valor narrativo). Sin bonificadores ni stats (decisión de
/// mecánicas 6): description es contexto para el Narrador. Sembrado desde worldCatalog.ts.
model ItemCatalog {
  id                    String           @id @default(cuid())
  worldId               String
  world                 World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  slug                  String
  name                  String
  /// Categoría libre ("arma", "herramienta", "ropa", "material", "consumible",
  /// "medicinal", "documento", "valor") — organiza el catálogo, no es mecánica
  category              String
  /// Categorización mecánica real (2026-07-29) — ver comentario del enum ItemTipo. `category`
  /// (arriba) sigue siendo el subtipo fino DENTRO de este tipo, no se sustituye.
  tipo                  ItemTipo
  /// Oficios (prefijo sin raza/región, p.ej. "curtidor", "desollador" — mismo criterio de prefijo
  /// que `matchesOficioPrefix`, harvestAbilities.ts) para los que este objeto cuenta como
  /// herramienta requerida (2026-08-17, petición explícita: "cada profesión dependerá de tener la
  /// herramienta para poder usar esa profesión"). Un objeto puede servir para varios oficios a la
  /// vez (p.ej. un cuchillo vale como arma Y como herramienta de peletería/desuello). Solo bloquea
  /// de verdad los oficios que de hecho tienen algún objeto dado de alta aquí — ver
  /// OFICIOS_CON_HERRAMIENTA_REQUERIDA en crafting.ts: un oficio sin ninguna herramienta
  /// registrada en todo el catálogo se queda sin gate, igual que siempre.
  herramientaParaOficio String[]         @default([])
  /// Solo en armas/escudos (2026-07-29, sistema de habilidades por arma) — decide qué habilidad
  /// de ataque/defensa genera este objeto al equiparlo, ver weaponAbilities.ts. Null en el resto
  /// del catálogo (herramientas, ropa, consumibles...).
  tipoArma              WeaponCategory?
  description           String
  /// Formas reales de referirse al objeto ("hacha", "el cuchillo"...) — mismo campo y mismo
  /// propósito que Npc.aliases/Location.aliases: sin esto, tanto la Enciclopedia progresiva
  /// (entityDiscovery.ts) como el texto clicable de narración (enciclopediaIndex.ts, frontend)
  /// solo reconocían el nombre EXACTO y completo de catálogo — "mi hacha" nunca enganchaba con
  /// "Hacha de guerra rota" (auditoría 2026-07-30, "revisar partida"). Default `[]` en vez de
  /// obligatorio: la inmensa mayoría de objetos no necesita ninguno (su nombre ya es corto y
  /// único, o no se presta a sinónimos seguros sin colisionar con otro objeto del catálogo).
  aliases               String[]         @default([])
  /// Ranura de equipo real (2026-07-30, petición explícita: "hay que categorizarlos por las
  /// partes equipables, para que no pueda poner un casco en los pies") — solo en objetos
  /// `tipo: EQUIPABLE`, null en el resto (nunca se equipan). Familia, no ranura exacta a rajatabla:
  /// ARMA_PRINCIPAL vale también para ARMA_SECUNDARIA y viceversa (cualquier arma va en cualquier
  /// mano), ANILLO_1 vale también para ANILLO_2 (ver `equipSlotFamily`, equipment.ts) — el resto
  /// de ranuras son 1:1 exactas.
  equipSlot             EquipSlot?
  /// Restricción de armadura por peso (2026-08-31, ver enum `PesoArmadura` arriba) — null salvo en
  /// objetos de armadura real (las 6 ranuras `CASCO`/`ARMADURA_SUPERIOR`/`ARMADURA_INFERIOR`/
  /// `GUANTES`/`BOTAS`/`CINTURON`). Determina qué clases pueden equiparlo, mismo criterio que
  /// `tipoArma`/`weaponPoolFor` para armas — ver `pesoArmaduraPermitidoFor` (weaponAbilities.ts).
  pesoArmadura          PesoArmadura?
  /// Bonificadores mecánicos reales al equipar (2026-07-19, mismo mecanismo que InventoryItem;
  /// mapa múltiple desde 2026-08-03 — sustituye a statBonusAttribute/statBonusAmount, un solo par
  /// no dejaba a un objeto sumar, p.ej., fuerza Y defensa a la vez) — hoy sobre todo en armas
  /// (categoría "arma") y armadura; el resto del catálogo sigue siendo puramente narrativo.
  /// Partial<Record<Attribute | 'defensa', number>> (ver StatBonusMap, equipment.ts). Se copia a
  /// InventoryItem.statBonuses al materializarse por saqueo/despiece.
  statBonuses           Json?
  /// Medidas físicas aproximadas en texto libre (2026-07-22, "para los objetos sus medidas y su
  /// lugar de origen... que eso se refleje en los prompts") — p.ej. "hoja de 45 cm, mango de 15
  /// cm". Texto libre porque la forma de medir varía demasiado entre categorías (arma, ropa,
  /// consumible...) para forzar un único campo numérico.
  dimensiones           String?
  /// Lugar/pueblo/región de origen o fabricación, cuando aporta algo al lore (p.ej. "manufactura
  /// goirnte, Meseta del Orden"). Null en objetos sin origen especial (p.ej. un cuchillo genérico).
  lugarOrigen           String?
  /// Nivel de rareza/dificultad (1-5, sesión de diseño 2026-07-23) — "Craftable", mismo concepto
  /// que ConstructionRecipe.tier (construction.ts). Default 1 = objeto común, sin requisito real.
  tier                  Int              @default(1)
  /// Requisitos mínimos de atributo del PJ para EQUIPAR este objeto (Partial<Record<Attribute |
  /// SecondaryAttribute, number>>, ver requisitos.ts) — comprobación de UMBRAL pura en
  /// PATCH /saves/:id/inventario/:itemId, nunca una tirada. Null = sin requisito.
  requisitos            Json?
  /// Tope real de curación al usar este objeto (2026-07-29, "si sales de un combate Incapacitado,
  /// tendrás que usar objetos específicos para volver a Herido o pasar directo a Ileso"): solo
  /// tiene sentido en objetos `category: "medicinal"` — descansar/comer SIN objeto solo llega a
  /// HERIDO y no hace nada si ya estás CONVALECIENTE (ver death.ts § healCeilingFor); un objeto
  /// médico con este campo puesto rompe ese tope, incluso desde CONVALECIENTE. Null = el objeto no
  /// cura condición física (la inmensa mayoría del catálogo, incluido el resto de "medicinal" que
  /// no cura de verdad, como el contraveneno).
  curaHasta             CondicionFisica?
  /// Primeros auxilios (2026-08-13, petición explícita: objetos "básicos" que solo mejoran UN
  /// escalón de condición desde donde estés, nunca de golpe hasta `curaHasta` como los objetos
  /// normales) — con esto en `true`, `curaHasta` deja de ser un tope absoluto y pasa a ser el
  /// MEJOR resultado posible con este objeto (nunca peor que un escalón por encima de la
  /// condición actual). Ver `healCeilingFor` (death.ts) para la fórmula real. `false`/`null` =
  /// comportamiento de siempre (rompe el tope de golpe, incluso desde CONVALECIENTE) — el resto
  /// del catálogo (alquimista y superiores) sigue así a propósito.
  curaUnPaso            Boolean          @default(false)
  /// Cantidad de energía que restaura al usarlo (2026-07-29, sistema de fatiga) — mismo criterio
  /// que `curaHasta` pero numérico (la energía es un pool 0..max, no un enum con pasos fijos).
  /// Null = el objeto no restaura energía.
  curaEnergia           Int?
  /// Puntos porcentuales de Hambre que restaura al usarlo (2026-09-04, habilidad "Comer/Beber") —
  /// mismo criterio que `curaEnergia` pero sobre el pool derivado de `Save.lastAteAtMinutes` (ver
  /// `comidaPct`/`lastAtMinutesForGanancia`, companionSupervivencia.ts). Null = el objeto no sacia
  /// hambre.
  curaHambre            Int?
  /// Puntos porcentuales de Sed que restaura al usarlo (hallazgo 13, revisar-partida-hallazgos.md
  /// 2026-09-06, "el consumo de agua pasa a depender de un ítem odre") — mismo criterio que
  /// `curaHambre` pero sobre el pool derivado de `Save.lastDrankAtMinutes` (ver
  /// `aguaPct`/`lastAtMinutesForGanancia`, companionSupervivencia.ts). Null = el objeto no sacia
  /// sed. Sustituye al viejo botón fijo "Beber agua" (sin ítem, repone 100% en cualquier sitio,
  /// retirado con este hallazgo) — el odre de agua lleno usa 100 (repone del todo), el resto de
  /// ítems narrativos de agua usan un valor proporcional.
  curaAgua              Int?
  /// Slug de ItemCatalog que se inserta en el inventario al consumir ESTE ítem (hallazgo 13) —
  /// caso único hoy: el odre de agua lleno, al beberse, devuelve el odre vacío (`odre-agua`) en
  /// vez de desaparecer del todo, como cualquier otro consumible. Null = comportamiento de
  /// siempre (el ítem se borra/reduce sin más al consumirse, sin dejar nada a cambio).
  emptyContainerCatalogSlug String?
  /// Clave estable del efecto especial (2026-08-03, `tipo: ESPECIAL`) — un identificador que un
  /// sistema concreto del juego consulta para activar su propio comportamiento (p.ej.
  /// `'reveal-map-llanuras'` para MapaPanel.tsx). Texto libre a propósito, como `sourceSlug` en
  /// HarvestYield: no hay (ni tiene sentido crear) un enum cerrado de "todos los efectos
  /// especiales posibles" — cada sistema que consuma una clave nueva la define y la documenta
  /// donde vive ese sistema, no aquí. Null en el resto del catálogo (tipo != ESPECIAL).
  effectKey             String?
  /// Texto explicando el efecto en español llano, para mostrar en un sitio propio y diferenciado
  /// de `description` (inventario/detalle) — nunca en la narración del Narrador. Null si
  /// `effectKey` también lo es.
  effectDescription     String?
  /// Valor económico en Goirnos, moneda única de Berig (2026-08-31, sistema de economía) — ver
  /// comentario del campo homónimo en ItemCatalogInput (worldCatalog.ts) para la fórmula base
  /// (`valorGoirnosBaseFor`, services/economia.ts) y los ajustes de lore aplicados a mano. Default
  /// bajo (1) como red de seguridad estándar del proyecto, nunca debería usarse en la práctica: el
  /// seed siempre manda un valor explícito para las 184 filas del catálogo.
  valorGoirnos          Int              @default(1)
  createdAt             DateTime         @default(now())

  npcItems NpcItem[]
  yields   HarvestYield[]

  @@unique([worldId, slug])
}

/// Lo que un NPC lleva encima — la ÚNICA fuente de loot al derrotarlo/registrarlo/comerciar.
model NpcItem {
  id       String      @id @default(cuid())
  npcId    String
  npc      Npc         @relation(fields: [npcId], references: [id], onDelete: Cascade)
  itemId   String
  item     ItemCatalog @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cantidad Int         @default(1)
  /// Personalización de ESTA pieza ("con la marca del Clan Serhu grabada", "mellada") —
  /// el mismo objeto de catálogo puede ser genérico en un NPC y significativo en otro
  notas    String?

  @@unique([npcId, itemId])
}

/// Qué recurso concreto da cada especie/planta al despiezarla o recolectarla — catálogo de
/// mundo. El "loot" de la naturaleza sigue la misma regla que el de los NPCs: es una lista
/// fija que se lee, nunca una tirada ni una invención del modelo. Las especies NO tienen
/// tabla propia: su prosa vive en areas.md/lore chunks; aquí solo la clave textual estable.
model HarvestYield {
  id                  String          @id @default(cuid())
  worldId             String
  world               World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// Clave de la especie ("corredor-de-cauce", "salvia-del-polvo") — string, no FK
  sourceSlug          String
  /// Categoría amplia de la fuente (2026-08-15, sustituye a sourceName — ver comentario de
  /// HarvestYieldInput en worldCatalog.ts): agrupa varias fuentes bajo el mismo bucket en el front.
  /// Clave de SOURCE_CATEGORY_NAMES (worldCatalog.ts) — el nombre legible se resuelve ahí
  /// (sourceCategoryNameFor), no se guarda repetido en cada fila.
  sourceCategory      String
  itemId              String
  item                ItemCatalog     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Cantidad FIJA por pieza/planta — la variación ya la puso la tirada de caza previa
  cantidad            Int             @default(1)
  /// Condición narrativa o de tirada ("cuchillo de deshuello", "extracción cuidadosa:
  /// destreza 15", "solo cadáver ya muerto") — null = sin condición
  condicion           String?
  /// Qué verbo/acción exige harvest.ts para dar este recurso (2026-07-29) — ver comentario del
  /// enum MetodoObtencion. Invariante: todas las filas de un mismo sourceSlug comparten método
  /// (validado en seed-catalog.ts).
  metodoObtencion     MetodoObtencion
  /// Bypass real de `rollGathering` (2026-08-23, ver comentario de HarvestYieldInput.sinTirada en
  /// worldCatalog.ts) — recursos de reconocimiento trivial que la propia `condicion` ya describía
  /// como "no requiere tirada" sin que el motor lo respetara. `false` = tira igual que el resto.
  sinTirada           Boolean         @default(false)
  /// Gate real de herramienta POR YIELD (2026-08-23, ver comentario de
  /// HarvestYieldInput.requiereHerramienta en worldCatalog.ts) — a diferencia de
  /// OFICIOS_CON_HERRAMIENTA_REQUERIDA (crafting.ts, bloquea un oficio entero), esto bloquea solo
  /// ESTE yield concreto sin herramienta. `false` = no exige nada, igual que el resto.
  requiereHerramienta Boolean         @default(false)
  /// Gate real de estación POR YIELD (2026-08-24, Grupo 3 § Sistema de estaciones, ver
  /// docs/rpgtarkor/estaciones.md) — a diferencia de `sinTirada`/`requiereHerramienta`, la
  /// mayoría del catálogo no tiene ninguna restricción de estación: null = disponible todo el
  /// año, igual que hoy. Hoy solo `boungo` ("crece en otoño") la usa, con `OTONO`. Comparado
  /// contra `estacionFor(fictionalMinutes)` (worldClock.ts), nunca contra el nombre narrado
  /// (que cambia según la raza del personaje jugable).
  estacionRequerida   Estacion?
  /// Gate real de clima POR YIELD (2026-08-24, Grupo 3 § Eventos de clima puntuales, ver
  /// docs/rpgtarkor/clima-tormentas.md) — a diferencia de `estacionRequerida` (igualdad exacta),
  /// esto es un umbral de severidad MÍNIMA: `climaFor(...) >= climaRequerido` (orden de
  /// `EstadoClima`, `climaSeveridadAlMenos` en worldClock.ts). Null = no exige clima concreto,
  /// igual que hoy la mayoría del catálogo. Hoy solo `punado-arena-iman` (TORMENTA_GRANDE) y
  /// `esquirla-celeste-caida` (TORMENTA_EXTREMA) la usan.
  climaRequerido      EstadoClima?

  @@index([worldId, sourceSlug])
}

/// Las 4 estaciones del calendario único y global de Tarkor (2026-08-24, Grupo 3 § Sistema de
/// estaciones, diseño completo en docs/rpgtarkor/estaciones.md) — 120 días de ficción por año,
/// 30 días por estación. El nombre mostrado al narrar cambia según la raza del personaje jugable
/// (`estacionNombreFor`, worldClock.ts); estos 4 valores son la clave mecánica interna, estable.
enum Estacion {
  PRIMAVERA
  VERANO
  OTONO
  INVIERNO
}

/// Clima real de Las Llanuras del Viento Rojo (2026-08-24, Grupo 3 § Eventos de clima puntuales,
/// diseño completo en docs/rpgtarkor/clima-tormentas.md) — eje de tiempo DISTINTO de `Estacion`,
/// calculado por región (`climaFor`, worldClock.ts; hoy solo Las Llanuras tiene números reales,
/// cualquier otra región da `null`, nunca bloquea). Orden de severidad estable, de menos a más:
/// CLIMA_LLEVABLE < VIENTO_FUERTE < TORMENTA_GRANDE < TORMENTA_EXTREMA — `HarvestYield.climaRequerido`
/// compara "al menos", nunca por igualdad exacta.
enum EstadoClima {
  CLIMA_LLEVABLE
  VIENTO_FUERTE
  TORMENTA_GRANDE
  TORMENTA_EXTREMA
}

/// Control de vida del mundo (2026-07-29, petición explícita: "establecer la población para
/// limitar e ir haciendo un control de la vida en el mundo") — nunca visible para la jugadora,
/// puro control interno. Base para zonas de aparición por probabilidad, extinción, sobrepoblación
/// y migraciones futuras (esta sesión solo sienta los datos, la simulación dinámica es aparte).
enum PopulationTargetType {
  RAZA
  /// Nombre engañoso a propósito de evitar una migración (auditoría de catálogo, 2026-08-13):
  /// cubre CUALQUIER Npc que se trackea como individuo suelto, no solo animales — incluye
  /// arquetipos humanoides itinerantes sin raza propia trackeada (`orco-rezagado`,
  /// `mercader-de-paso`, `peregrino-de-los-tumulos`). `RAZA` es la excepción, reservada a las
  /// razas jugables con población de clan entera (orcos/goirntes/nabieus/faerus); todo lo demás
  /// que vive y muere como individuo cae aquí. Invisible para el modelo/jugadora en cualquier
  /// caso — puro filtro interno de consulta, nunca se serializa en ningún prompt ni en la UI.
  FAUNA
  /// Rediseño de profesiones (2026-08-07) — fuentes de recolección NO-fauna (MINERIA/TALA/
  /// EXTRACCION de HarvestYield: vetas de mineral, matorrales, etc.). `targetSlug` =
  /// `HarvestYield.sourceSlug`. Permite saber determinísticamente qué hay disponible en la región
  /// del jugador al pulsar "Explorar" en una habilidad de recolección, sin pasar por el Narrador.
  RECURSO
  FLORA
  FACCION
}

/// Dos ejes DELIBERADAMENTE separados (decisión de diseño explícita de la usuaria, 2026-07-29):
/// `poblacion`/`poblacionMax` es la salud demográfica (sube/baja por nacimientos, muertes,
/// extinción, sobrepoblación — un único número global, nunca partido por región). `distribucion`
/// es dónde está repartida AHORA MISMO esa misma población (pesos relativos por región, no un
/// conteo fijo) — migrar no resta de un cubo y suma a otro, solo desplaza estos pesos, dejando
/// intacto el número global. Los 3 clanes orcos (Llanuras/Cristal Helado/Ciénaga) son 3 filas
/// realmente separadas a propósito (confirmado por la usuaria: son sub-razas ya adaptadas a su
/// región, biología distinta entre ellas — no fluyen entre sí salvo guerra o evento de mundo muy
/// concreto), cada una con su propia `distribucion` de un solo peso 100%.
model WorldPopulation {
  id      String @id @default(cuid())
  worldId String
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  targetType PopulationTargetType
  /// Slug de raza (berigLore.ts) o de fauna (Npc.slug) — string suelto, mismo criterio laxo que
  /// professionId en ProfessionProgress, sin FK real (razas no son fila de BD). Los 3 clanes
  /// orcos usan slugs propios (`orcos-llanuras`/`orcos-cristal-helado`/`orcos-cienaga`), no
  /// `orcos` a secas, precisamente porque son 3 filas distintas.
  targetSlug String
  /// Etiqueta legible para logs/debug — nunca la ve la jugadora, esto es control interno puro.
  label      String

  poblacion    Int
  /// Techo real de `poblacion` — `growAllPopulations` (population.ts) nunca crece una fila por
  /// encima de esto (auditoría de elementos desconectados, 2026-08-23: hasta entonces se leía y
  /// sembraba pero jamás se aplicaba, crecimiento sin límite real).
  poblacionMax Int

  /// Pesos relativos por región ({ "Llanuras del Viento Rojo": 0.7, "Cristal Helado": 0.3, ... },
  /// suman ~1.0) — de aquí saldrá la probabilidad de aparición por zona cuando exista esa
  /// mecánica. Migrar un día solo reescribe este Json, nunca `poblacion`.
  distribucion Json

  updatedAt DateTime @updatedAt

  /// Cooldown de recolección (bug real jugando en vivo, 2026-08-07: "puedo darle a minar
  /// indefinidamente sin moverme de la zona") — solo se rellena para `targetType: RECURSO`, cuándo
  /// se recolectó esta fuente por última vez de verdad (`recolectar.ts`). `null` = nunca
  /// recolectada, o fuera de cooldown desde hace tiempo. No afecta a FAUNA/RAZA (esas no pasan por
  /// `recolectar.ts`, se depliezan al morir, no al "recolectar" repetidamente en el sitio).
  lastHarvestedAt         DateTime?
  /// Dónde se recolectó por última vez (bug real jugando en vivo, 2026-08-13: "avanzo por la
  /// hondonada buscando más elementos... ahí sí que debería poder volver a usarla" — el cooldown
  /// de arriba era puramente de reloj, sin memoria de sitio, así que moverte a otra Location no
  /// servía de nada). El guard de `recolectar.ts` ahora pasa si CUALQUIERA de las dos condiciones
  /// se cumple: pasaron los 30 min, O el jugador está en una Location distinta a esta. Compartido
  /// entre partidas igual que `poblacion`/`lastHarvestedAt` (mismo criterio ya aceptado para esta
  /// fila) — en la práctica solo importa para la partida real de la jugadora.
  lastHarvestedLocationId String?

  /// Cooldown de dispersión tras caza en grupo fallida (2026-09-02, `rollGroupEngagement` puede
  /// devolver 0 desde el commit d6e8afc: "el grupo se dispersa antes de comprometerse") — CAMPOS
  /// NUEVOS a propósito, NUNCA reutilizar `lastHarvestedAt`/`lastHarvestedLocationId` de arriba:
  /// esos son de otro sistema (recolección de RECURSO, reloj de PARED real) con semántica de
  /// tiempo distinta. Este cooldown es en MINUTOS DE FICCIÓN (mismo patrón exacto que
  /// `NpcState.condicionFisicaSinceMinutes` + `RECOVERY_CONVALECIENTE_MINUTES`, death.ts), no
  /// reloj real — cazar.ts compara contra `WorldState.fictionalMinutes` del turno actual, nunca
  /// contra `Date.now()`. `null`/`null` = nunca se dispersó, o el cooldown ya expiró de sobra (no
  /// se limpia activamente, `cazar.ts` solo comprueba si ya pasó el tiempo).
  dispersadoEnLocationId String?
  dispersadoDesdeMinutes Int?

  @@unique([worldId, targetType, targetSlug])
}

/// Resúmenes por capítulos — memoria de partida para no perder coherencia en partidas largas (riesgo 1 del análisis).
model SessionSummary {
  id               String   @id @default(cuid())
  saveId           String
  save             Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  chapterNumber    Int
  summary          String
  createdAt        DateTime @default(now())
  /// Minuto de ficción real en que se generó este capítulo (2026-09-04, Diario en pestañas
  /// Año/Estación/Día) — nullable porque los capítulos ya existentes antes de este campo no lo
  /// tienen; el Diario los trata como "sin fecha" en vez de inventarles una. Ver `calendarioFor`
  /// (worldClock.ts) para derivar Año/Estación/Día relativo a partir de este valor.
  fictionalMinutes Int?

  @@index([saveId, chapterNumber])
}

/// Prompt de generación de imagen (en inglés, listo para pegar en cualquier generador externo)
/// para una entrada del catálogo del mundo — roadmap de API de imágenes (2026-07-21/22, checklist
/// punto 7). Primera pasada: solo TEXTO del prompt, sin renderizar nada todavía (decisión
/// explícita de la usuaria) — tabla genérica por (worldId, entityType, entitySlug, sizeProfile) en
/// vez de una columna por modelo (Npc/ItemCatalog/etc.) porque fauna/flora no tiene tabla propia
/// (vive como sourceSlug repetido en HarvestYield) y las habilidades de clase son
/// contenido estático en código (classAbilities.ts/startingAbilities.ts, sin fila de BD) — una
/// tabla aparte cubre los cuatro tipos sin tocar cada modelo.
model ImagePrompt {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// 'npc' | 'item' | 'fauna' | 'ability' — qué catálogo referencia entitySlug
  entityType  String
  /// slug real (Npc.slug/ItemCatalog.slug/HarvestYield.sourceSlug) o nombre slugificado
  /// (habilidades, que no tienen slug propio en código)
  entitySlug  String
  /// 'thumbnail' (miniatura cuadrada de EntryCard, cuadrícula de la Enciclopedia) | 'banner'
  /// (MediaSlot ancho de DetailModal, ~3:1 — medido en la UI real, no una talla inventada). Cada
  /// perfil tiene su propia instrucción de encuadre en imagePromptGenerator.ts y se genera/cachea
  /// por separado (petición explícita de la usuaria, 2026-07-22: "1 a 1", nunca las dos de golpe).
  sizeProfile String
  prompt      String
  /// Qué proveedor lo generó ("cerebras:gpt-oss-120b", "ollama:qwen2.5:1.5b-instruct"...) — para
  /// poder distinguir calidad si hace falta regenerar solo lo que cayó al fallback local.
  provider    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([worldId, entityType, entitySlug, sizeProfile])
}

/// Captura en vivo de turnos reales para el pipeline DPO (plan "IA local propia", fase 2 — pares
/// de preferencia chosen/rejected para DPOTrainer, en paralelo al pipeline SFT existente de
/// generate-distillation-dataset.ts). Por cada turno narrado en vivo por el modelo local
/// (narrador.ts), se dispara en segundo plano una llamada al MISMO prompt contra un profesor cloud
/// (completeCloudOnly) — si la respuesta cloud pasa los mismos detectores/validación que protegen
/// producción, queda marcada como candidata a exportación junto con la salida local YA calculada
/// (nunca se vuelve a llamar a Ollama solo para comparar). Sin relación FK a Save/World a
/// propósito: los datos de entrenamiento deben sobrevivir a que la partida se borre/reinicie.
model LiveTeacherCapture {
  id      String @id @default(cuid())
  /// Sin @relation a propósito (ver comentario de arriba) — dato de solo referencia/auditoría,
  /// nunca un JOIN real; así borrar/reiniciar un Save no arrastra ni bloquea estas filas.
  saveId  String
  worldId String

  /// Texto EXACTO enviado como "system" a completeCloudOnly (mismo bloque SYSTEM del Modelfile
  /// que usa producción/generate-distillation-dataset.ts) — guardado tal cual para que el export
  /// DPO no dependa de que el Modelfile no haya cambiado entre la captura y la exportación.
  systemPrompt String
  /// Texto EXACTO enviado como "user" — prompt de buildNarrationPrompt + el bloque de formato
  /// JSON Schema (mismo patrón que buildTeacherUserContent en modelfileSystemPrompt.ts).
  userContent  String

  /// Salida cruda del profesor cloud (puede incluir fences markdown sin limpiar todavía).
  cloudRawText      String
  /// Proveedor real que respondió ("gemini:gemini-flash-latest", "groq:llama-3.3-70b-versatile"...).
  cloudProvider     String
  /// true si cloudRawText, tras extractJsonPayload + JSON.parse, pasó validateSchema + runDetectors
  /// (los MISMOS detectores que protegen producción). Solo las filas con true son candidatas de
  /// exportación DPO — se guardan también los rechazos (false) para poder auditar cuánto alucina
  /// cada proveedor sin descartar la fila entera de la tabla.
  cloudValid        Boolean
  /// Motivo de rechazo si cloudValid es false (mismo string que devuelven validateSchema/
  /// runDetectors) — null si cloudValid es true. Solo diagnóstico, nunca se exporta.
  cloudRejectReason String?

  /// Salida local YA calculada por narrateAction para este turno real — "for free", nunca una
  /// segunda llamada a Ollama solo para esta captura.
  localNarrationJson Json
  /// Modelo local que produjo localNarrationJson (env.ollamaModelNarrador en el momento de la
  /// captura) — útil para descartar/filtrar filas si el narrador local cambia de versión entre
  /// capturas (p. ej. tras promocionar tarkor-narrador-v2).
  localModel         String

  /// Export/consumo (para que re-ejecutar el script de export no duplique filas).
  exportedAt DateTime?

  createdAt DateTime @default(now())

  @@index([saveId])
  @@index([cloudValid, exportedAt])
}
