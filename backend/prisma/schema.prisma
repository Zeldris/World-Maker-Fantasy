generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Pooler de transacciones de Supabase (puerto 6543, IPv4) — la usa la app en tiempo de ejecución.
  // No usamos la conexión directa (db.xxxxx.supabase.co): esa solo tiene IPv6 en el tier
  // gratuito y no era alcanzable desde esta red.
  url       = env("DATABASE_URL")
  // Pooler de sesión (puerto 5432, IPv4) — el que necesitan las migraciones de Prisma.
  directUrl = env("DIRECT_URL")
  // NOTA: la extensión `vector` se habilitó a mano con `prisma db execute` (ver decisión RAG,
  // 2026-07-17), no vía `extensions = [...]` aquí — Supabase ya trae varias extensiones propias
  // preinstaladas (pgcrypto, uuid-ossp, pg_stat_statements, supabase_vault) que Prisma no gestiona;
  // declarar `extensions` activa el preview feature postgresqlExtensions y hace que Prisma detecte
  // esas extensiones ajenas como "drift" y pida resetear la base de datos entera. Mejor no declararla.
}

enum Lethality {
  BAJA
  MEDIA
  ALTA
}

/// docs/14-combate-y-muerte.md § 1. INCAPACITADO != MUERTO: incapacitado es "fuera de la acción
/// actual" (inconsciente, inmovilizado) pero recuperable sin la Entidad; MUERTO dispara § 4.
enum CondicionFisica {
  ILESO
  HERIDO
  GRAVE
  INCAPACITADO
  MUERTO
}

/// docs/14-combate-y-muerte.md § 4.2 — elegida al crear la partida, determina el límite de
/// muertes antes del fin de partida real (ver limiteMuertes() en services/death.ts).
enum Dificultad {
  NOVATO
  MEDIO
  AVANZADO
}

enum LogChannel {
  CHARACTER
  WORLD
}

/// Decisión de producto 2 (02-decisiones.md): sin login real por ahora,
/// pero la tabla existe desde ya para no remodelar `Save` cuando se añada auth de verdad.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  saves Save[]
}

/// Plantilla de mundo del catálogo (distinta de la instancia jugada — ver WorldState).
model World {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  tagline    String
  synopsis   String
  tone       String
  lethality  Lethality
  factions   String[]
  /// Tema de color por mundo (accent300-600, accent2 300-600) — mismo shape que WorldTheme en el frontend.
  theme      Json
  createdAt  DateTime  @default(now())

  pregeneratedCharacters PregeneratedCharacter[]
  saves                  Save[]
  loreChunks             LoreChunk[]
  locations              Location[]
  npcs                   Npc[]
  itemCatalog            ItemCatalog[]
  harvestYields          HarvestYield[]
  imagePrompts           ImagePrompt[]
  worldPopulations       WorldPopulation[]
  factionCatalog         Faction[]
  historiaEntries        HistoriaEntry[]
}

/// Personajes preseleccionables asociados a un mundo (plantilla, no instancia jugada).
model PregeneratedCharacter {
  id              String @id @default(cuid())
  worldId         String
  world           World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name            String
  archetype       String
  origin          String
  motivation      String
  /// AttributeBlock: { fuerza, destreza, sigilo, voluntad, carisma, arcano }
  attributes      Json
  portraitInitial String
}

/// Una partida: mundo elegido + personaje (copia editable, no referencia viva a la plantilla) + su WorldState.
model Save {
  id                       String    @id @default(cuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldId                  String
  world                    World     @relation(fields: [worldId], references: [id])
  pregeneratedCharacterId  String?

  characterName       String
  characterArchetype  String
  characterOrigin     String
  characterMotivation String
  /// AttributeBlock, copiado al crear la partida (independiente de la plantilla a partir de aquí)
  attributes          Json
  /// SecondaryAttributeBlock (sesión de diseño 2026-07-23) — Inteligencia/Magia/Poder de Semilla/
  /// Moral/4 Resistencias, ya existían como columnas narrativas en personajes.md pero el motor no
  /// las usaba. Nunca se pasan a rollCheck (dice.ts) — solo alimentan comprobaciones de UMBRAL
  /// (requisitos de objetos/construcciones), nunca una tirada nueva. Default "{}" para no romper
  /// partidas ya creadas antes de esta migración; el código trata las claves ausentes como 0.
  secondaryAttributes Json      @default("{}")
  portraitInitial     String

  /// Niveles/XP (docs/10-niveles-xp-reino.md, reversión 2026-07-18 de la decisión de mecánicas 4).
  level                  Int @default(1)
  xp                     Int @default(0)
  pendingAttributePoints Int @default(0)

  /// Nombre del reino/dominio si el jugador lo bautiza — null = aún sin reino (docs/10 § 5.1).
  kingdomName String?

  /// Slug de BERIG_RAZAS (berigLore.ts) — igual que `Npc.raza`, string libre sin FK (contenido
  /// de diseño estático, no una tabla). 2026-07-29, sistema de habilidades por arma/raza: hasta
  /// ahora el personaje jugable no tenía raza estructurada en ningún sitio — su habilidad racial
  /// nunca se le mostraba, solo se calculaba para NPCs. Null = personaje sin raza asignada
  /// todavía (partidas previas a este campo).
  raza String?

  createdAt    DateTime @default(now())
  lastPlayedAt DateTime @default(now())

  /// Ubicación actual en el grafo (null = partidas antiguas sin posición todavía; se
  /// rellena con la ubicación inicial al migrar). Durante un viaje NO cambia: sigue
  /// siendo el origen hasta que worldTick resuelve el CharacterTransit — "dónde estoy"
  /// nunca es ambiguo, y "hacia dónde voy" vive en el tránsito.
  currentLocationId String?
  currentLocation   Location? @relation("CurrentLocation", fields: [currentLocationId], references: [id])
  locationVisits    LocationVisit[]

  /// Condición física (docs/14-combate-y-muerte.md § 1, decisión de mecánicas 3 nunca
  /// implementada hasta ahora). La narración de combate es la vía principal para cambiarla;
  /// descansar/curar la vía principal para mejorarla — el modelo nunca la baja fuera de combate.
  condicionFisica CondicionFisica @default(ILESO)
  /// Salud/PV visible (0-100), instrucción explícita de la usuaria 2026-07-19 — v1 conservador:
  /// se DERIVA de `condicionFisica` (ILESO=100, HERIDO=75, GRAVE=50, INCAPACITADO=25, MUERTO=0,
  /// ver saludForCondicion en death.ts), no cambia el motor de combate ya calibrado, solo lo
  /// expone como número/barra en vez de solo una etiqueta. Sin daño variable todavía (v2).
  salud           Int             @default(100)
  /// Fatiga/energía (2026-07-29, "que las habilidades no sean de uso ilimitado") — valor ACTUAL,
  /// topado a `energiaMaxFor(constitucion)` (energy.ts) en cada turno, nunca al tope fijo de aquí:
  /// el máximo real escala con Constitución, no es una constante persistida. Se inicializa al
  /// máximo real en POST /saves (mismo criterio que condicionFisica arranca en ILESO).
  energia         Int             @default(100)

  /// Último `Location` de kind refugio/asentamiento donde se descansó con éxito — punto de
  /// reaparición al morir (§ 4.1). Null = todavía no ha descansado en un sitio válido; el
  /// flujo de muerte cae entonces al `Location` inicial del personaje, nunca deja al jugador
  /// sin dónde aparecer.
  lastRestLocationId String?
  lastRestLocation   Location? @relation("LastRestLocation", fields: [lastRestLocationId], references: [id])

  /// Nº de veces que ha muerto esta partida — determina cuándo se dispara el fin de partida
  /// según `dificultad` (§ 4.2). No se resetea salvo por `/saves/:id/restart`.
  deathCount Int @default(0)
  /// Elegida al crear la partida (§ 4.2): determina el límite de muertes antes del fin de
  /// partida real. NOVATO = sin límite; MEDIO = 4; AVANZADO = 2.
  dificultad Dificultad @default(MEDIO)
  /// No nulo = partida cerrada por muerte definitiva (§ 4.4): bloquea `/turn/classify` (409,
  /// mismo patrón que CharacterTransit) hasta que se reinicia. No es lo mismo que borrar.
  endedAt DateTime?
  /// No nulo = la jugadora salió de la vista de juego con un tránsito en curso (roadmap
  /// 2026-07-20, petición explícita: "quiero que la partida se pause si salgo de ella"). Mientras
  /// esté puesto, `resolveDueTransits` (worldTick.ts) se salta esta partida aunque su
  /// `CharacterTransit.busyUntil` ya haya vencido — al volver (`POST /saves/:id/resume`),
  /// `busyUntil` se alarga exactamente lo que ha durado la pausa, así que ni se pierde tiempo de
  /// espera ni se resuelve de golpe por haber estado fuera. Nulo = partida activa (comportamiento
  /// de siempre).
  pausedAt DateTime?

  /// Slugs de Npc en combate detectado por el último turno resuelto (bug real, 2026-07-23,
  /// "revisar partida" — este campo transitorio SOLO viajaba en la respuesta directa de
  /// `/turn/narrate`, nunca se guardaba: si el turno tardaba tanto que el sondeo de reconexión
  /// del cliente tenía que recuperar la partida vía `GET /saves/:id`, el combate se calculaba
  /// bien en el backend pero se perdía en la recuperación — el jugador nunca veía el botón de
  /// "Combatir"). Se sobrescribe en cada turno (vacío si no hay combate ese turno), para que
  /// `GET /saves/:id` pueda reconstruir el mismo aviso de combate tras cualquier resincronización.
  pendingCombatNpcSlugs Json @default("[]")

  /// Rediseño del turno de combate (2026-07-28, petición explícita: "se tiran dados y se ve
  /// quien ataca primero... el otro entra en un turno de defensa"). Cuando la iniciativa de un
  /// intercambio favorece al NPC, aquí se guarda su ataque YA decidido (oculto al frontend) —
  /// qué habilidad/atributo usa y contra qué NPC — a la espera de que el jugador elija su
  /// defensa a ciegas en su próxima sumisión. Null = le toca atacar al jugador (caso normal de
  /// siempre). Se limpia dentro de la misma transacción que resuelve ese intercambio — nunca
  /// sobrevive más de un turno sin resolverse.
  pendingNpcAttack Json?

  worldState       WorldState?
  logEntries       LogEntry[]
  characterTransit CharacterTransit?
  sessionSummaries SessionSummary[]
  inventoryItems   InventoryItem[]
  companions       Companion[]
  territories      Territory[]
  buildings        Building[]
  subjects         Subject[]
  savedActions     SavedAction[]
  quests           Quest[]
  npcStates        NpcState[]
  professionProgress ProfessionProgress[]
  kingdomStats     KingdomStats?
  discoveredEntities DiscoveredEntity[]
  sessionFacts     SessionFact[]
  foundedFactions  Faction[]

  @@index([userId])
}

/// Ubicación conocida del mundo (catálogo, no estado de partida). Se siembra desde
/// backend/src/scripts/worldCatalog.ts (mismo patrón que loreChunks.ts + reindex-lore):
/// la fuente de verdad editorial sigue siendo docs/rpgtarkor/areas.md.
model Location {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// Clave estable para seeds, aliases y referencias cruzadas ("hondonada-del-eco")
  slug        String
  name        String
  /// Nombre de región del lore — string libre, no FK (misma razón que Territory.region:
  /// el lore vive en .md)
  region      String
  /// Tipo libre ("refugio", "hito", "punto de agua", "cruce", "ruinas", "asentamiento") —
  /// no enum cerrado, misma razón que Companion.role
  kind        String
  /// Descripción de LLEGADA: lo que se inyecta al Narrador cuando el personaje llega aquí
  /// o está aquí — redactada con vocabulario de jugador (lección RAG 2026-07-18)
  description String
  /// Nombres con los que un jugador se refiere de verdad al sitio ("los pilares", "el pozo") —
  /// para que el matcher DETERMINISTA de destinos resuelva sin pasar por el modelo
  aliases     String[]
  createdAt   DateTime @default(now())

  linksFrom LocationLink[] @relation("linkFrom")
  linksTo   LocationLink[] @relation("linkTo")
  visits    LocationVisit[]
  saves         Save[] @relation("CurrentLocation")
  restingSaves  Save[] @relation("LastRestLocation")
  buildings     Building[]

  @@unique([worldId, slug])
}

/// Ruta directa entre dos ubicaciones. Se guarda UNA fila por pareja y el grafo se trata
/// como bidireccional (ir y volver cuestan lo mismo en v1 — si algún día una ruta es
/// asimétrica, se añade la fila inversa con otro coste y gana la específica).
model LocationLink {
  id     String   @id @default(cuid())
  fromId String
  from   Location @relation("linkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Location @relation("linkTo", fields: [toId], references: [id], onDelete: Cascade)

  /// Minutos de viaje BASE (a pie, sin modificador). Es exactamente el `base` de la fórmula
  /// YA existente en timedActions.ts — minutos = base / (1 + destreza/20). No se toca la
  /// fórmula: solo se le da un `base` determinista sacado del grafo en vez de la estimación
  /// libre del clasificador.
  minutosBase Int
  /// Terreno libre ("llanura abierta", "arcilla agrietada", "senda de pastoreo") — color
  /// concreto para narrar el trayecto sin inventar
  terreno     String
  /// Riesgo conocido de la ruta ("nidos de Espina del Viento", "paso de patrullas de la
  /// Concordia") — material para el Narrador; null = sin riesgo señalado
  riesgo      String?

  @@unique([fromId, toId])
}

/// Primera visita de una partida a una ubicación — habilita el hito "descubrimiento"
/// (50 XP, tabla de docs/10 § 3.2) de forma DETERMINISTA: lo emite el backend al llegar
/// por primera vez, sin que el modelo tenga que proponerlo.
model LocationVisit {
  id             String   @id @default(cuid())
  saveId         String
  save           Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  firstVisitedAt DateTime @default(now())

  @@unique([saveId, locationId])
}

/// Enciclopedia progresiva (sesión de diseño 2026-07-23, petición explícita de la usuaria a
/// partir de la "niebla de guerra" del mapa: "en vez de tener todo descubierto desde el inicio...
/// solo se verá una vez la AI lo mencione por primera vez en la narración, o sean objetos que ya
/// tenemos"). Una fila = esta partida ya conoce esta entidad — NPC/fauna/objeto mencionado en
/// narración o `new_facts` (o, para objetos, presente en el inventario), detectado en
/// `services/discovery.ts` tras persistir cada turno. Lugares NO usan esta tabla: se gatean con
/// `LocationVisit` (ya existía, visita física real). Razas/clases/personajes/atributos/
/// construcciones quedan siempre visibles a propósito — son "cómo funciona el juego", no lore
/// narrativo que se descubre jugando.
model DiscoveredEntity {
  id           String   @id @default(cuid())
  saveId       String
  save         Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  /// 'npc' | 'fauna' | 'item' | 'faction' | 'historia' (2026-08-06) — mismo vocabulario que
  /// ImagePromptEntityType, pero sin los tipos siempre-visibles de arriba.
  entityType   String
  entitySlug   String
  discoveredAt DateTime @default(now())

  @@unique([saveId, entityType, entitySlug])
  @@index([saveId])
}

/// La fuente de verdad de una partida — no es prosa, son hechos estructurados.
/// Se lee/escribe en cada llamada al Narrador/Cronista para que nunca se contradigan (ver 01-analisis-producto.md § 4).
model WorldState {
  id      String @id @default(cuid())
  saveId  String @unique
  save    Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)

  fictionalDateLabel String   @default("Día 1, mañana")
  /// Minutos ficticios totales transcurridos desde Día 1, 00:00 (480 = 08:00, el mismo origen que
  /// ya asumía `fictionalDateLabel` como placeholder). Avanza en narrateAndPersistTurn() según los
  /// minutos reales que cuesta cada turno (computeDuration/travel.minutos) — nunca lo decide el
  /// modelo. `fictionalDateLabel` se regenera a partir de este número cada vez que avanza, para no
  /// tener que tocar los muchos sitios que ya lo leen como string. Año todavía sin implementar
  /// (pendiente de que el flujo día/hora se demuestre estable jugando).
  fictionalMinutes    Int     @default(480)
  /// Eventos pendientes de la agenda del mundo (facciones, NPCs) que el Cronista puede hacer "vencer"
  agenda              Json    @default("[]")
  factionsStatus      Json    @default("{}")

  updatedAt DateTime @updatedAt
}

/// Hechos establecidos de la partida (2026-07-30, mejora de cohesión — "recuperación por
/// relevancia para sessionFacts, misma infraestructura que el RAG de lore"). Antes vivían en
/// `WorldState.facts` (Json, ventana rodante de los últimos 10 — ver worldFacts.ts/mergeFacts):
/// un hecho genuinamente importante de hace 15 turnos se perdía para siempre solo por antigüedad,
/// mientras uno reciente pero ya irrelevante seguía ocupando hueco en cada prompt. Ahora se
/// almacenan TODOS (con un tope generoso, ver `MAX_STORED_FACTS` en worldFacts.ts) con su propio
/// embedding — igual que `LoreChunk` — y la selección de qué mandar al Narrador cada turno mezcla
/// los más recientes (continuidad inmediata) con los más relevantes por similitud a la acción
/// actual (cohesión con hechos antiguos que vuelven a importar), sin aumentar el tamaño del
/// prompt frente a antes (mismo tope de 10 que se manda realmente).
model SessionFact {
  id        String   @id @default(cuid())
  saveId    String
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  text      String
  /// Mismo patrón que LoreChunk.embedding — habilitado a mano vía `CREATE EXTENSION vector`, no
  /// gestionado por Prisma (preview feature postgresqlExtensions), ver comentario del datasource.
  embedding Unsupported("vector(768)")?
  createdAt DateTime @default(now())

  @@index([saveId, createdAt])
}

/// Entrada de log append-only. `roll` solo presente en entradas del canal CHARACTER que resuelven una tirada.
model LogEntry {
  id             String     @id @default(cuid())
  saveId         String
  save           Save       @relation(fields: [saveId], references: [id], onDelete: Cascade)
  channel        LogChannel
  text           String
  /// RollInfo: { attribute, value, difficulty, result, success } — null si la entrada no es una tirada
  roll           Json?
  isPlayerAction Boolean    @default(false)
  timeLabel      String
  /// XP ganada en esta entrada, si alguna (docs/10-niveles-xp-reino.md § 6) — permite mostrar
  /// "+50 XP" en el Diario y auditar el nivel sumando el log.
  xpDelta        Int?
  /// Minuto de ficción real en el momento de crear esta entrada (WorldState.fictionalMinutes,
  /// petición explícita de la usuaria, 2026-07-24: "el log de personaje solo muestre 24h del
  /// mundo... el diario clasificado por días") — antes solo existía `timeLabel` (texto ya
  /// formateado, "Día 3, 14:20"), sin número real que permita filtrar por ventana de tiempo de
  /// juego ni agrupar por día sin parsear el string. `@default(0)` es solo para filas anteriores
  /// a esta migración (se leerán como "Día 1"), nunca se usa para filas nuevas.
  fictionalMinutes Int      @default(0)
  /// Qué entidad de la Enciclopedia se mostró como banner bajo esta narración (rework 2026-07-24,
  /// "las imágenes que se muestran en la narración deben persistir de alguna forma") — el frontend
  /// ya decide cuál mostrar (mentionedEntityBanner.ts, con su propia deduplicación); esto solo
  /// guarda esa decisión para que sobreviva a una recarga dentro de la ventana de 24h. Se resuelve
  /// la imagen real en cada lectura (nunca se guarda la URL), igual que el resto de imágenes de la
  /// Enciclopedia — así una imagen subida más tarde para la misma entidad también se ve aquí.
  entityBannerType String?
  entityBannerSlug String?
  /// Rediseño de la vista de combate (2026-07-28): marca si esta entrada se generó durante un
  /// turno de combate (`enCombate: true` en turnResolution.ts) — el frontend la pinta con fondo
  /// rojo en el log de "Tu personaje". No se puede inferir esto de forma fiable a partir de otros
  /// campos ya existentes (`roll` también aparece en tiradas fuera de combate), así que necesita
  /// su propia columna para sobrevivir a una recarga de partida.
  combate        Boolean    @default(false)
  /// Eventos de viaje interactivos (2026-08-05): marca la entrada determinista (nunca narrada por
  /// el LLM) que avisa de que un viaje largo se interrumpió antes de llegar al destino pedido —
  /// el frontend la pinta con fondo ámbar en el log, igual que `combate` con el rojo. Sin esto, el
  /// jugador podía terminar en una ubicación distinta a la pedida sin ninguna señal visible más
  /// allá de la narración de llegada, que no sabe (ni debe saber) cuál era el destino original.
  travelInterrupted Boolean @default(false)
  createdAt      DateTime   @default(now())

  @@index([saveId, createdAt])
  @@index([saveId, fictionalMinutes])
}

/// Personaje "ocupado/en tránsito" durante una acción larga (viajar, descansar varios días...).
/// Como mucho una fila activa por partida — el personaje solo puede estar haciendo una cosa larga a la vez.
model CharacterTransit {
  id          String   @id @default(cuid())
  saveId      String   @unique
  save        Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  activity    String
  busyUntil   DateTime
  zoneContext Json?
  createdAt   DateTime @default(now())
}

/// Los 13 huecos de equipo fijos que pidió la usuaria — puramente organizativo/narrativo, sin
/// bonificadores propios (mismo espíritu que el resto de InventoryItem). Como máximo un objeto
/// por hueco y por partida (@@unique en InventoryItem más abajo); Postgres trata cada NULL como
/// distinto, así que varios objetos sin equipar (slot = null) conviven sin problema.
enum EquipSlot {
  CASCO
  CAMISA
  ARMADURA_SUPERIOR
  GUANTES
  ARMADURA_INFERIOR
  ACCESORIO
  BOTAS
  ARMA_PRINCIPAL
  ARMA_SECUNDARIA
  ANILLO_1
  ANILLO_2
  CINTURON
  /// 6 ranuras de consumible (2026-07-30, petición explícita: "raciones y cataplasma catalogalo
  /// como Consumible que tendrá 6 slots en equipo donde podrás añadir los consumibles que quieres
  /// usar en el combate") — familia intercambiable entre sí (ver `equipSlotFamily`, equipment.ts),
  /// igual que ARMA_PRINCIPAL/ARMA_SECUNDARIA o ANILLO_1/ANILLO_2. `combatItems` (GameView.tsx)
  /// ahora sale de estas ranuras, no de "cualquier objeto sin ranura" — hay que EQUIPAR un
  /// consumible aquí a propósito para poder usarlo en combate.
  CONSUMIBLE_1
  CONSUMIBLE_2
  CONSUMIBLE_3
  CONSUMIBLE_4
  CONSUMIBLE_5
  CONSUMIBLE_6
  /// 3 ranuras de cosmético puro (2026-08-03, petición explícita: "crear dentro de los items
  /// equipables una categoría que es cosméticos... Espalda, Cabeza y Cintura") — sustituyen a
  /// ABALORIO (demasiado genérico, sin sitio anatómico propio). 1:1 exactas, sin familia
  /// compartida (a diferencia de ARMA_*/ANILLO_*/CONSUMIBLE_*): un cosmético de espalda nunca vale
  /// en el hueco de cintura. `category: 'cosmetico'` en ItemCatalog es la convención de catálogo
  /// que las acompaña (campo libre, no enum — ver comentario de `category`).
  COSMETICO_ESPALDA
  COSMETICO_CABEZA
  COSMETICO_CINTURA
}

/// Objeto que el personaje lleva encima o ha conseguido. Origen/descripción siguen siendo puro
/// contexto narrativo (decisión de mecánicas 6), pero desde 2026-07-19 (instrucción explícita de
/// la usuaria, reabriendo esa decisión — Gorhorn es guerrero primero, sin nada mágico todavía)
/// un objeto puede llevar un bonificador mecánico real a uno de los 6 atributos jugables,
/// aplicado solo mientras está EQUIPADO (ver effectiveAttributes en services/equipment.ts).
model InventoryItem {
  id          String     @id @default(cuid())
  saveId      String
  save        Save       @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name        String
  description String
  /// De dónde salió (botín, inicial, regalo de un NPC...) — contexto narrativo, no categoría mecánica.
  origin      String?
  /// Hueco de equipo asignado (null = en la mochila, sin equipar). La jugadora lo asigna a mano
  /// desde el panel "Equipo" — el modelo nunca lo decide.
  slot        EquipSlot?
  /// Bonificadores mecánicos reales (solo cuentan mientras `slot` no es null) — mapa múltiple
  /// (2026-08-03, sustituye a statBonusAttribute/statBonusAmount) de cero o más de los 7
  /// atributos jugables más 'defensa' — nunca mágico por ahora (arcano incluido en la lista pero
  /// sin usarlo todavía en objetos reales — Gorhorn es guerrero, sin nada mágico hasta que se
  /// decida introducirlo). Null = objeto puramente narrativo, como antes.
  /// Partial<Record<Attribute | 'defensa', number>> (ver StatBonusMap, equipment.ts).
  statBonuses Json?
  /// Slug de ItemCatalog de origen (sesión de diseño 2026-07-23) — no es FK real (mismo criterio
  /// laxo que Quest.targetItemName): un objeto narrativo suelto (newItem del modelo) nunca tiene
  /// uno. Se rellena cuando se sabe el origen (saqueo/despiece/crafteo, ver turnResolution.ts) —
  /// permite mirar ItemCatalog.requisitos al equipar sin comparar por nombre (frágil, el nombre
  /// final puede personalizarse en el saqueo/crafteo).
  catalogSlug String?
  createdAt   DateTime   @default(now())

  @@unique([saveId, slot])

  @@index([saveId])
}

/// Aliado, súbdito o acompañante del personaje. Igual que InventoryItem: estado narrativo
/// persistido para que el Narrador no lo olvide entre turnos, sin capa mecánica propia todavía.
model Companion {
  id        String   @id @default(cuid())
  saveId    String
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name      String
  /// p. ej. "aliado", "súbdito", "compañero de viaje" — libre, no un enum cerrado todavía.
  role      String
  notes     String
  createdAt DateTime @default(now())

  @@index([saveId])
}

enum LoreChunkType {
  FAUNA
  FLORA
  NPC
  CLAN
  REGION
  LOOT
  CULTURA
  PERSONAJE
  CONTRATO
  /// Gancho de aventura — material concreto para que el Narrador/entorno introduzcan un
  /// suceso o encuentro, no un hecho fijo del mundo (docs/rpgtarkor/personajes.md § Ganchos).
  GANCHO
}

/// Fragmento de lore indexado para recuperación semántica (RAG, decisión 2026-07-17: en vez de
/// que el frontend mande una lista fija de "hechos del mundo" o que un humano los cure a mano por
/// región, el backend embebe la acción del jugador + el resumen del personaje y recupera los
/// fragmentos más relevantes de esta tabla — así el tamaño del contexto que se manda a Ollama no
/// crece con el tamaño total del lore, solo con lo relevante a la situación actual.
/// Fuente de verdad editorial: sigue siendo `docs/rpgtarkor/*.md` (para humanos); estos fragmentos
/// se curan a partir de ahí y se reindexan con `npm run reindex-lore` cada vez que el lore cambia.
model LoreChunk {
  id        String        @id @default(cuid())
  worldId   String
  world     World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  type      LoreChunkType
  title     String
  text      String
  /// Palabras clave sueltas (raza, región, clan...) — no se usan para filtrar la búsqueda semántica,
  /// solo como metadato de depuración/trazabilidad hacia el .md de origen.
  tags      String[]
  sourceDoc String
  /// nomic-embed-text produce vectores de 768 dimensiones. Tipo no soportado nativamente por
  /// Prisma Client — se escribe/lee con SQL crudo ($executeRaw/$queryRaw) en lib/embeddings.ts.
  embedding Unsupported("vector(768)")?
  createdAt DateTime      @default(now())

  @@index([worldId])
}

/// Habilidad guardada: un prompt reutilizable que el jugador puede lanzar directo al chat.
/// Efecto mecánico de una habilidad de COMBATE (roadmap habilidades de clase, checklist
/// 2026-07-21/22 puntos 1-2) — enum cerrado en vez de leer la intención por regex sobre el
/// `promptText` (mismo error ya pagado con matchNpcAliases/erratas): el motor necesita un switch
/// determinista para decidir REMATE/ATURDIMIENTO/INTIMIDACION/AGUANTE, no adivinarlo del texto.
enum AbilityEffect {
  ATAQUE
  ATURDIMIENTO
  REMATE
  INTIMIDACION
  AGUANTE
  /// Rediseño de combate (2026-08-09, "Analizar rival"/"Lectura de Presa" reconvertida): revela
  /// el atributo recomendado contra el rival analizado — nunca hace daño, nunca reutiliza ATAQUE
  /// (eso haría que una tirada de análisis con éxito bajara condicionFisica vía
  /// nextCondicionForAttack, justo lo que este rediseño evita para cualquier rol distinto de
  /// 'ataque').
  ANALISIS
}

/// Rol mecánico de una habilidad (rediseño de combate, 2026-08-09, petición explícita: "una
/// habilidad defensiva o de utilidad nunca hará daño directo... las de ataque sí") — distinto de
/// `AbilityEffect` (que sigue describiendo el efecto narrativo/mecánico concreto: qué pasa si
/// conecta). `rol` decide DOS cosas: (1) si puede hacer daño incondicional al conectar (solo
/// 'ataque' — cierra el hueco de hoy donde una habilidad AGUANTE elegida para atacar igual hacía
/// daño), y (2) cómo se resuelve el intercambio (`combatExchange.ts`): ataque-vs-defensa cruza
/// una tabla de resultados conjunta; en cuanto CUALQUIER lado es 'utilidad', cada lado tira
/// independiente y su propio éxito/fallo decide solo su propio efecto, nunca el del rival.
/// Mismo shape que el `categoria` que YA existía (sin usarse en combate real) para las
/// habilidades raciales de fauna en `Npc.habilidadesRaciales` (worldCatalog.ts) — este enum lo
/// generaliza a TODA habilidad de combate (arma, clase, racial humanoide, genérica).
enum AbilityRol {
  ataque
  defensa
  utilidad
}

/// Categorización mecánica de objetos (2026-07-29, petición explícita: "separar los items por
/// categorías... recursos... materiales... equipables... consumibles"). Bucket amplio y estable
/// — `ItemCatalog.category` (String, sin cambios) sigue existiendo como subtipo FINO dentro de
/// cada tipo (p.ej. tipo=RECURSO, category='piel'/'madera'/'piedra'/'mena'; tipo=EQUIPABLE,
/// category='arma'/'herramienta'/'ropa', igual que siempre).
enum ItemTipo {
  /// Se obtiene directo de la naturaleza (caza/tala/minería/extracción) — nunca se fabrica.
  RECURSO
  /// Sale de un proceso de crafteo/profesión (ver CraftingRecipe) — nunca se encuentra suelto.
  MATERIAL
  EQUIPABLE
  CONSUMIBLE
  /// Documentos, objetos de valor/trueque — sin mecánica de combate/equipo/consumo.
  NARRATIVO
  /// Efecto real, pero ni de combate ni de equipo (2026-08-03, petición explícita: "los items de
  /// tipo Especial... tendrán un efecto que será más complejo o útil para la narración o las
  /// posibilidades de juego" — p.ej. el Mapa de las Llanuras, o un futuro diario que desbloquea
  /// flora de una zona). Ver `effectKey`/`effectDescription` más abajo — sustituye el patrón de
  /// mirar `item.name === '...'` a mano en el frontend (así vivía el Mapa hasta ahora) por una
  /// clave real que cualquier sistema puede consultar.
  ESPECIAL
}

/// Categoría de arma (2026-07-29, sistema de habilidades por arma — "dependiendo el arma que
/// lleves las habilidades se adapten... hacer un cuchillo con una lanza es imposible"): decide
/// QUÉ atributo usa la habilidad de ataque/defensa que ese hueco de equipo genera — ver
/// WEAPON_CATEGORY_ATTRIBUTE en weaponAbilities.ts. Solo con sentido en objetos `category: 'arma'`.
enum WeaponCategory {
  HACHA
  MAZA
  GARROTE
  PICA
  LANZA
  CUCHILLO
  DAGA
  ESPADA
  /// Objeto defensivo de mano secundaria (escudo) — en vez de generar una 2ª habilidad de
  /// ataque, genera la habilidad de defensa del hueco.
  ESCUDO
}

/// Qué acción/verbo exige `harvest.ts` para dar este recurso concreto (2026-07-29, petición
/// explícita: "para conseguir estos recursos debes cazar... o talar... o picar... a veces al
/// explorar la zona me saca recursos que no tiene sentido obtener directamente"). `discovery.ts`
/// (revelado al explorar genérico) solo sortea `PASIVO` — el resto exige nombrar la fuente y usar
/// el verbo correspondiente (`CAZA` además sigue exigiendo presa ya derrotada, ver harvest.ts).
enum MetodoObtencion {
  /// De verdad ambiental (hierba/piedra ya suelta) — el único que puede salir en "Explorar la zona".
  PASIVO
  CAZA
  TALA
  MINERIA
  /// Recolección deliberada de algo delicado (raíces, venenos) — verbo propio, pero no caza/tala/mina.
  EXTRACCION
}

/// Nivel de oficio (sesión de diseño 2026-07-23) — eje independiente del nivel de personaje, uno
/// por profesión practicada alguna vez (professionProgress.ts). `professionId` es el id de
/// professions.ts (frontend), no FK real — mismo criterio laxo que Save.profession. Sube al
/// craftear/construir con éxito una receta que declara ese `oficio` (crafting.ts/construction.ts);
/// su nivel alivia SOLO los requisitos de recetas de ese mismo oficio (requisitos.ts).
model ProfessionProgress {
  id           String   @id @default(cuid())
  saveId       String
  save         Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  professionId String
  nivel        Int      @default(1)
  xp           Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([saveId, professionId])
}

/// Economía de Reino (sesión de diseño 2026-07-23, kingdomTick.ts) — 1:1 con Save, se crea al
/// fundar el primer Territory (turnResolution.ts) — "el vacío es un estado válido"
/// (docs/10-niveles-xp-reino.md § 5.1): sin fila, no hay reino todavía, nada que tiquear.
model KingdomStats {
  id           String   @id @default(cuid())
  saveId       String   @unique
  save         Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  poblacion    Int      @default(0)
  felicidad    Int      @default(50)
  comida       Int      @default(0)
  bebida       Int      @default(0)
  riqueza      Int      @default(0)
  soldados     Int      @default(0)
  trabajadores Int      @default(0)
  visitantes   Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// El cupo lo da el nivel (docs/10-niveles-xp-reino.md § 4.3): 3 + floor(nivel/2).
model SavedAction {
  id          String   @id @default(cuid())
  saveId      String
  save        Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name        String
  promptText  String
  /// Un emoji — icono del botón en el panel de Habilidades.
  icon        String   @default("✨")
  /// Texto corto para el tooltip al pasar el ratón — qué hace la habilidad, de cara al jugador.
  description String   @default("")
  /// Habilidades "de serie" (creadas al iniciar la partida, ej. las de Gorhorn) no cuentan
  /// contra el cupo por nivel (habilidadSlotsForLevel) — ese cupo es solo para las que el
  /// jugador va creando él mismo. Ver docs/10-niveles-xp-reino.md § 4.3.
  isStarting  Boolean  @default(false)
  /// Libre, no enum cerrado (misma razón que Companion.role): "combate", "exploracion",
  /// "social" son las sugeridas en la UI, pero no hay lista cerrada de categorías posibles.
  /// Como en cualquier RPG: la barra de fuera de combate no es la misma que la de dentro.
  category    String   @default("general")
  /// Solo relevante para category:'combate' (nunca en habilidades creadas a mano por la
  /// jugadora — esas siguen siendo 'general', ver POST /saves/:id/abilities). Null en partidas
  /// ya en curso hasta que se reinicien o suba de nivel de nuevo (mismo patrón aditivo/nullable
  /// que el resto del proyecto).
  effect             AbilityEffect?
  /// Rediseño de combate (2026-08-09) — ver comentario completo en `enum AbilityRol`. Mismo
  /// criterio nullable/aditivo que `effect`: solo relevante para category:'combate', null hasta
  /// que la partida se resincronice.
  rol                AbilityRol?
  /// Atributo con el que se resuelve la tirada de esta habilidad — gana sobre la heurística de
  /// palabra clave de npcScene.ts (tabulatedAttackAttribute) cuando el turno manda `savedActionId`.
  preferredAttribute String?
  /// Habilidad racial/de arma recalculada automáticamente (2026-07-29, sistema de habilidades por
  /// arma) — a diferencia de `isStarting` (fija de por vida), estas se BORRAN y se vuelven a crear
  /// cada vez que cambia el equipo o el nivel, para reflejar siempre el arma que llevas puesta
  /// ahora mismo. Nunca editable/borrable por la jugadora (mismo criterio visual que isStarting).
  isDynamic   Boolean  @default(false)
  /// Sistema de fatiga (2026-07-29) — coste fijo por tramo (energy.ts § ENERGY_COST_BASICA/
  /// AVANZADA/ATAQUE_BASICO). 'general' se queda en 0.
  energyCost  Int      @default(0)
  /// Rediseño 2026-07-31 (petición explícita: "ataque básico no es una habilidad como las demás,
  /// ni defenderse ni esquivar... son acciones que tienen todos los personajes") — marca los 3
  /// genéricos (Ataque Básico, Defenderse, Esquivar) para separarlos en su propio bloque en la UI
  /// y excluirlos del cupo de 10 habilidades (antes se usaba `energyCost === 0` para esto último,
  /// una heurística que dejó de servir en cuanto Ataque Básico pasó a costar 5 en vez de 0).
  isGeneric   Boolean  @default(false)
  /// Energía que RECUPERA usar esta habilidad en un intercambio de combate real (2026-07-31) —
  /// Defenderse=10/Esquivar=5, 0 en el resto (incluido Ataque Básico, que solo cuesta). Sustituye
  /// al viejo mecanismo de regen por ROL (¿el jugador atacó o se defendió este turno?) — ahora
  /// depende de LA HABILIDAD usada, no del rol, ver energy.ts § nextEnergia.
  energyRegen Int      @default(0)
  /// Habilidad real por categoría exacta de arma (2026-07-31, petición explícita: "cada arma
  /// equipada te dará una habilidad de su tipo... si llevas 2 armas del mismo tipo tendrás solo 1
  /// habilidad de arma con doble efecto") — true cuando esta habilidad colapsó porque ARMA_
  /// PRINCIPAL y ARMA_SECUNDARIA llevan la MISMA categoría (ver weaponAbilities.ts §
  /// weaponAbilitiesFor). Se traduce en un bonus de dificultad al usarla (turnResolution.ts §
  /// DUAL_WIELD_DIFFICULTY_BONUS) — nunca en una segunda tirada real, decisión explícita para no
  /// duplicar el intercambio de combate en un mismo turno.
  dualWield   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([saveId])
}

enum QuestStatus {
  ACTIVA
  COMPLETADA
  FALLIDA
}

/// Misión/objetivo narrativo (docs/09-panel-personaje.md § pestaña "Misiones", única pestaña
/// pendiente desde el diseño original). Mismo patrón que Territory/Building/Subject: el modelo
/// propone (newQuest/questProgress en narrador.ts), el backend valida y materializa — sin
/// bonificadores mecánicos propios, coherente con la decisión de mecánicas 6.
model Quest {
  id          String      @id @default(cuid())
  saveId      String
  save        Save        @relation(fields: [saveId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      QuestStatus @default(ACTIVA)
  /// Condición de cierre detectable por el backend (roadmap 2026-07-19, mecánicas): si esta
  /// misión se detecta como "derrotar a X" al crearse (match contra los NPCs del mundo, mismo
  /// matcher de npcScene.ts), aquí queda el id del Npc objetivo — sin FK real a propósito (mismo
  /// patrón laxo que CharacterTransit.zoneContext), porque un Npc de catálogo no pertenece a
  /// ninguna partida. En cuanto su NpcState pase a INCAPACITADO/MUERTO en ESTA partida, el
  /// backend cierra la misión solo, sin depender de que el modelo repita el título EXACTO en
  /// "questProgress".
  targetNpcId String?
  /// Mismo patrón que `targetNpcId` (roadmap 2026-07-20, P1 de Fable): si el título/descripción
  /// menciona una Location conocida del mundo (mismo `matchDestination` que usa `travel.ts` para
  /// resolver destinos), aquí queda su id — cierra sola la misión "llegar a Y" en cuanto se
  /// registra una `LocationVisit` nueva a este destino, sin que el modelo tenga que acertar el
  /// título EXACTO vía "questProgress".
  targetLocationId String?
  /// Mismo patrón: si el título/descripción menciona un objeto del catálogo (`ItemCatalog`), aquí
  /// queda su nombre (no id — se compara contra `InventoryItem.name`, que no siempre coincide con
  /// una fila de catálogo exacta: botín/despiece/crafteo pueden personalizar el nombre). Cierra
  /// sola la misión "conseguir Z" en cuanto se materializa un `InventoryItem` cuyo nombre lo
  /// menciona (loot, despiece, crafteo o "newItem" de la narración).
  targetItemName String?
  /// Frase corta y accionable de qué hay que hacer (2026-07-25, petición explícita: "Objetivo"
  /// separado de `description`, que es texto narrativo/de trasfondo) — se muestra en el panel de
  /// Misiones. Nullable: las misiones ya existentes antes de este campo no tienen uno todavía.
  objetivo String?
  /// Recompensa estática de la misión (petición explícita, 2026-07-25) — nunca decidida por el
  /// modelo, siempre fijada a mano al crear la misión (mismo criterio que loot de NpcItem: la
  /// única fuente de verdad es lo que el propio código define, nunca una invención libre). null =
  /// sin recompensa de XP definida todavía.
  rewardXp Int?
  /// Nombres de objetos ya definidos como recompensa (solo texto para mostrar en el panel — la
  /// entrega real de esos objetos concretos sigue pasando por el mecanismo de loot/crafteo normal
  /// que ya exista; este campo no crea InventoryItem por sí solo, ver comentario de rewardXp).
  rewardItems String[] @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([saveId])
}

enum TerritoryControl {
  RECLAMADO
  DISPUTADO
  CONSOLIDADO
  PERDIDO
}

/// Zona/territorio bajo control (o reclamación) del personaje (docs/10-niveles-xp-reino.md § 5.2).
model Territory {
  id          String           @id @default(cuid())
  saveId      String
  save        Save             @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name        String
  /// Nombre de región del lore (docs/rpgtarkor/areas.md) — string libre, no FK: el lore vive en .md
  region      String?
  description String
  control     TerritoryControl @default(RECLAMADO)
  /// Población anónima estimada — los súbditos SIN nombre son un número, no filas (ver Subject)
  population  Int              @default(0)
  acquiredAt  DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  buildings Building[]
  subjects  Subject[]

  @@index([saveId])
}

enum BuildingStatus {
  EN_CONSTRUCCION
  ACTIVO
  DANADO
  ABANDONADO
}

/// Edificio/estructura construida o tomada por el personaje (docs/10-niveles-xp-reino.md § 5.2).
model Building {
  id          String         @id @default(cuid())
  saveId      String
  save        Save           @relation(fields: [saveId], references: [id], onDelete: Cascade)
  /// Opcional: un refugio levantado en mitad del viaje no pertenece a ningún territorio
  territoryId String?
  territory   Territory?     @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  /// Dónde se plantó de verdad (2026-08-04, primera construcción anclada al mapa: "el campamento")
  /// — opcional porque las construcciones libres del modelo (newBuilding, sin receta fija) no
  /// siempre tienen una Location real donde anclarse. Reutiliza el mismo nodo/Location que ya
  /// dibuja el mapa en vez de inventar coordenadas propias (el backend nunca las ha guardado).
  locationId  String?
  location    Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Clave de ConstructionRecipe (construction.ts: 'campamento'/'choza'/'ayuntamiento'...) si esta
  /// fila vino de una receta fija — null para construcciones libres que el modelo propuso vía
  /// `newBuilding` sin pasar por ninguna receta. Sirve para elegir el icono en el mapa y para
  /// enlazar con la ficha genérica de la Enciclopedia (misma `key` que ya usa esa ficha). El
  /// Ayuntamiento SIEMPRE guarda `'ayuntamiento'` aquí sin importar el tier — mejorarlo actualiza
  /// esta misma fila, nunca crea una nueva (docs/17-reglas-construcciones-reino.md).
  recipeKey   String?
  /// Nivel del Ayuntamiento (1=pequeño/2=mediano/3=grande) — null para el resto de construcciones,
  /// que no tienen niveles. Decide cuántos edificios de reino (choza...) puedes tener a la vez.
  /// OJO: NO es lo mismo que `ConstructionRecipe.tier` (construction.ts, dificultad "Craftable"
  /// 1-5 de la receta) — ese nunca se copia aquí, este campo solo lo rellena
  /// `ConstructionRecipe.ayuntamientoNivel` (docs/17-reglas-construcciones-reino.md).
  tier        Int?
  name        String
  /// Tipo libre ("refugio", "granja", "taller", "muralla", "monumento"...) — no enum cerrado,
  /// misma razón que Companion.role: no sabemos aún qué construirán los jugadores
  kind        String
  status      BuildingStatus @default(EN_CONSTRUCCION)
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([saveId])
}

/// Súbdito CON NOMBRE — alguien que sigue/sirve al personaje ligado a su reino, no a su persona
/// (eso es Companion). Ver docs/10-niveles-xp-reino.md § 5.2/§ 5.3.
model Subject {
  id          String     @id @default(cuid())
  saveId      String
  save        Save       @relation(fields: [saveId], references: [id], onDelete: Cascade)
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  name        String
  /// "capataz", "guerrera", "consejera", "granjero"... — libre
  role        String
  notes       String
  createdAt   DateTime   @default(now())

  @@index([saveId])
}

enum NpcKind {
  PRINCIPAL // individuo con nombre propio: stats y equipo FIJOS, nunca los inventa el modelo
  PLANTILLA // arquetipo instanciable ("guerrero orco rezagado"): statline canónica + rango de nivel
}

/// Disposición hacia el combate (2026-07-29, "si me encuentro un NPC 'Agresivo' me va a ser
/// imposible no acabar peleando"): hoy `shouldForceCombat` (turnResolution.ts) solo mira el VERBO
/// del jugador — un Aullador Rojo y un Corredor de Cauce reaccionan exactamente igual a "me
/// acerco y saludo".
///
/// Valor de CATÁLOGO fijo (orden de menos a más hostil, usado también como índice en
/// reputation.ts) — NO es lo que decide el motor en combate: la reputación de facción
/// (WorldState.factionsStatus) lo desplaza en caliente hacia un extremo u otro para calcular el
/// "temperamento efectivo" de esa partida concreta (effectiveTemperamento en reputation.ts). Un
/// NPC con `faction: null` (fauna, independientes) no tiene de qué reputación desplazarse —
/// se queda siempre en este valor de catálogo tal cual.
enum Temperamento {
  AMIGABLE // reputación excelente con su facción — nunca inicia combate, el más receptivo
  INOFENSIVO // nunca inicia combate — protegido de la red de seguridad de shouldForceCombat
  CAUTELOSO // depende de la acción del jugador — comportamiento actual, sin cambios
  AGRESIVO // casi cualquier interacción deriva en combate — fuerza combate en shouldForceCombat
  ENEMIGO // reputación pésima — fuerza combate igual que AGRESIVO; casi irrecuperable (ver reputation.ts)
}

/// NPC del catálogo de mundo (no estado de partida — qué ha hecho un NPC en UNA partida
/// sigue viviendo en WorldState.facts, igual que hasta ahora). Sembrado desde
/// worldCatalog.ts; la prosa larga vive en docs/rpgtarkor/npcs.md y en lore chunks SIN números.
model Npc {
  id      String  @id @default(cuid())
  worldId String
  world   World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  kind    NpcKind
  slug    String
  name    String
  /// Formas reales de referirse a él/ella ("torgash", "el jefe de guerra serhu", "la terk'ikar")
  /// — para la detección determinista de "NPC en escena" (§ 2.5)
  aliases String[]
  /// Clan o facción, libre ("Clan Serhu", "Concordia de Hierro") — null para independientes
  faction String?
  /// Rol corto ("Kort'ikar del Clan Serhu", "soldado de patrulla") — libre
  role    String
  /// Artículo determinado ("el"/"la") que necesita `name` al presentarse en el contexto del
  /// Narrador — null si es un nombre propio que no lleva artículo (2026-07-31, bug real jugando:
  /// "se gira hacia la orca enfurecida... el Orco Enfurecido salta hacia él" — el modelo confunde
  /// el género de nombres descriptivos/de rol en la MISMA frase, nunca en nombres propios como
  /// "Gorhorn" o "Gistera Koh"). Curado a mano en worldCatalog.ts, nunca derivado del string del
  /// nombre — adivinar género gramatical por heurística es el mismo tipo de detector de texto
  /// libre que ya ha dado falsos positivos en este proyecto (ver npcScene.ts § matchNpcAliases).
  /// Se usa para REFORZAR el nombre en el propio contexto ("el Orco Enfurecido"), no para corregir
  /// la prosa después — más seguro que un reemplazo de texto a ciegas, que podría corromper una
  /// mención legítima en femenino de otro NPC real (p.ej. Gistera Koh) en la misma escena.
  articulo String?
  /// Género gramatical ("M"/"F"), distinto de `articulo` (2026-08-07, bug real jugando,
  /// 2026-07-30: Gistera Koh — orca, femenino, ya explícito como primera palabra de su `bio` —
  /// narrada como "el orco"). `articulo` solo ayuda cuando el NOMBRE del NPC es un rol/descripción
  /// ("Orco Enfurecido"); esto cubre el caso contrario, un nombre propio ("Gistera Koh") al que el
  /// modelo se refiere de forma genérica en prosa libre en vez de por su nombre, ignorando el
  /// género ya establecido en `bio`. Null = no reforzado explícitamente (el modelo usa `bio` tal
  /// cual, como siempre) — se puebla solo donde ya se ha visto el fallo en vivo, no en todo el
  /// catálogo de golpe.
  genero String?
  /// Nivel en la MISMA escala de docs/10-niveles-xp-reino.md. Para PRINCIPAL es fijo; para
  /// PLANTILLA es el nivel canónico (levelMax acota el rango típico). Hoy el motor no hace
  /// tiradas opuestas: este nivel sirve para que el clasificador calibre la dificultad y el
  /// Narrador el tono (§ 2.5), no para un sistema de combate simétrico.
  level    Int
  levelMax Int?
  /// AttributeBlock { fuerza, destreza, sigilo, voluntad, carisma, arcano }, rango 4-18 —
  /// mismo shape que Save.attributes para poder reutilizar tipos y validaciones
  attributes Json
  /// Biografía/descripción corta + personalidad: el resumen que se inyecta en el prompt.
  /// La versión larga y los ganchos viven en los .md y en lore chunks.
  bio         String
  personality String
  /// Dónde se le encuentra normalmente — slug de Location, string (no FK: una plantilla
  /// puede aparecer "en cualquier ruta"), null = itinerante
  homeLocationSlug String?
  /// Rediseño de la vista de combate (2026-07-28, petición explícita: "usa habilidades de la
  /// enciclopedia... si vas a añadir nuevas reflejalas con el resto de habilidades bajo su
  /// clase") — las habilidades que se ven en la ficha de un NPC NO son un campo suelto por NPC
  /// (esa fue la primera iteración, descartada): salen de los mismos catálogos que ya sirve la
  /// Enciclopedia (`classAbilities.ts`, `berigLore.ts`/`BERIG_RAZAS`), enganchados aquí solo por
  /// referencia (`raza`/`clase`).
  ///
  /// - `raza`: slug de `BERIG_RAZAS` (goirntes/orcos/nabieus/faerus) — solo humanoides. Un NPC
  ///   humanoide tiene como mucho 1 habilidad racial, la de `BERIG_RAZAS[raza].habilidadRacial`
  ///   (compartida por toda su raza, no duplicada por fila).
  /// - `clase`: 'Guerrero' | 'Cazador' (mismo `Clase` de classAbilities.ts) — solo "seres
  ///   inteligentes que pueden portar equipo". Sus habilidades salen de
  ///   `classAbilityUnlocksForClase(clase)` filtradas por `level`.
  ///
  /// Nota: se descartó a propósito una tercera taxonomía de "habilidades de profesión" en la
  /// ficha de combate — resultó ser un concepto distinto (recetas de crafteo tipo "Crear cuchillo
  /// de hielo sílice" que se desbloquean subiendo de nivel de oficio, categoría 'general' del
  /// panel de Habilidades, no 'combate'), aplazado a otra sesión. `Npc` no necesita ningún campo
  /// para eso.
  raza  String?
  clase String?
  /// Fauna/monstruos (sin `raza` — cada fila de fauna en worldCatalog.ts YA es una especie
  /// entera, no un individuo, así que su racial vive aquí en vez de en un catálogo aparte):
  /// hasta 6 habilidades raciales propias, `{ icon, name, description, categoria:
  /// 'ataque'|'defensa'|'utilidad' }` (2 de cada). Vacío en NPCs humanoides (su racial sale de
  /// `raza` en vez de este campo).
  habilidadesRaciales Json @default("[]")
  /// Frase corta del ataque natural (solo fauna, sin arma en su `loadout`) — alimenta el
  /// "Ataque base" calculado (baseAttack.ts) cuando no hay arma que describir. Null en NPCs
  /// humanoides (su Ataque base describe el arma de su `loadout` en su lugar).
  ataqueNatural String?
  /// Disposición al combate, ver enum `Temperamento`. Default CAUTELOSO = comportamiento actual
  /// (depende del verbo del jugador), así que sembrar sin asignar esto explícitamente no cambia
  /// nada del comportamiento existente.
  temperamento Temperamento @default(CAUTELOSO)
  /// Capacidades de interacción (2026-07-29, "no siempre puedes domesticar a un animal de la misma
  /// raza... quiero que sea dinámico"): % (0-100) de que ESTA especie/individuo tenga la capacidad
  /// en absoluto, no un booleano fijo — un Aullador Rojo hambriento no siempre es domesticable.
  /// Deliberadamente solo datos de catálogo por ahora: la resolución real (tirada única por
  /// instancia de partida, persistida en NpcState, con el mismo rollCheck de dice.ts) se monta
  /// cuando exista una mecánica real de comerciar/reclutar/domesticar/capturar/cortejar que la
  /// consuma — hasta entonces sería estado sin ningún caller.
  comerciablePct   Int @default(0)
  reclutablePct    Int @default(0)
  domesticablePct  Int @default(0)
  capturablePct    Int @default(0)
  cortejablePct    Int @default(0)

  items     NpcItem[]
  npcStates NpcState[]

  @@unique([worldId, slug])
}

/// Facción/clan que el jugador puede descubrir (sección "Facciones" de la Enciclopedia,
/// 2026-08-06) — formaliza en tabla lo que hasta ahora era solo `Npc.faction` (string libre, sin
/// FK) y el catálogo suelto `World.factions` (String[], sin relación con esto). `raza` es también
/// texto libre (uno de BERIG_RAZAS, berigLore.ts — NO es una tabla, igual que `Npc.raza`), no una
/// FK real. El enganche con `Npc.faction` es por IGUALDAD EXACTA de `name` (ver
/// entityDiscovery.ts) — no hay FK entre Npc y Faction a propósito, mismo criterio que el resto
/// del catálogo (Npc.raza tampoco referencia BERIG_RAZAS con FK).
///
/// `saveId` (2026-08-06, "fundar tu reino ya fundaba tu facción, solo faltaba conectarlo" — ver
/// reino.ts): null = fila de catálogo de mundo (las sembradas en worldCatalog.ts, compartidas por
/// cualquier partida). Relleno = facción fundada DENTRO de esa partida al fundar el reino
/// (Ayuntamiento tier 1) — invisible para el resto de partidas del mismo mundo. El `@@unique`
/// sigue siendo `[worldId, slug]` sin cambios: el `slug` de una facción fundada incluye el
/// `save.id`, así que nunca choca ni con el catálogo ni con la de otra partida.
model Faction {
  id          String  @id @default(cuid())
  worldId     String
  world       World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  saveId      String?
  save        Save?   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  raza        String
  description String

  @@unique([worldId, slug])
}

/// Entrada de lore descubrible como objeto físico (libro/diario/nota) — sección "Historia" de la
/// Enciclopedia (2026-08-06). Dos eras: 'comun' (desde el año 0, `year` relleno, se agrupa en la
/// Enciclopedia por bloques de 500 años) y 'semillas' (mítica, anterior al año 0 — `year` siempre
/// null, lista plana sin bloques por lo disperso e impreciso del periodo). `documentoItemSlug` es
/// el objeto físico (`ItemCatalog.slug`, normalmente `category: 'documento'`) que desbloquea esta
/// entrada al descubrirse — mismo eje que el resto de `DiscoveredEntity`. `requiresTranslation` +
/// `translatorNpcSlug` (mecanismo "escrito en el idioma de las Semillas", petición explícita de la
/// usuaria): cuando es true, el TEXTO real (`text`) solo se sirve al frontend si el NPC traductor
/// referenciado también está descubierto — ver `/world/:slug/enciclopedia` (routes/world.ts) para
/// el cómputo real de `unlocked`, siempre en tiempo de lectura, nunca almacenado.
model HistoriaEntry {
  id                  String  @id @default(cuid())
  worldId             String
  world               World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  slug                String
  title               String
  era                 String
  year                Int?
  text                String
  requiresTranslation Boolean @default(false)
  documentoItemSlug   String
  translatorNpcSlug   String?

  @@unique([worldId, slug])
}

/// Estado de un NPC EN UNA PARTIDA CONCRETA (roadmap 2026-07-19 "roadmap 3", hallazgo de Fable):
/// antes no existía — cada escena leía siempre el Npc estático (nivel/atributos de catálogo), así
/// que "Torgash resucita" cada vez que aparece en escena, y el saqueo en combate se podía repetir
/// pulsando "Registrar" tantas veces como se quisiera. Determinista, sin IA — el modelo nunca
/// decide si un NPC está derrotado ni si ya se le saqueó.
model NpcState {
  id              String          @id @default(cuid())
  saveId          String
  save            Save            @relation(fields: [saveId], references: [id], onDelete: Cascade)
  npcId           String
  npc             Npc             @relation(fields: [npcId], references: [id], onDelete: Cascade)
  /// Ámbito del estado (roadmap 2026-07-20, bug real P0): un Npc `PLANTILLA` es una única fila
  /// de catálogo compartida por TODAS sus apariciones en el mundo ("rezagado", "corredor de
  /// cauce"...) — sin esto, derrotar/saquear UNA aparición marcaba la plantilla entera como
  /// derrotada para siempre en la partida, rompiendo el combate contra la misma clase de NPC una
  /// segunda vez y reabriendo el farmeo infinito (el despiece exige presa previa, pero la presa
  /// nunca volvía a "no estar ya derrotada"). Para `PRINCIPAL` siempre "" (una sola fila global,
  /// mismo comportamiento que antes de este cambio — Torgash sigue siendo el mismo Torgash en
  /// cualquier escena). Para `PLANTILLA`, el `Location.id` donde ocurre ESTE encuentro concreto
  /// ("itinerante" si no hay ubicación resuelta en el turno) — así cada aparición nueva en un
  /// sitio distinto empieza fresca, sin memoria de otras plantillas del mismo arquetipo.
  scope           String          @default("")
  condicionFisica CondicionFisica @default(ILESO)
  /// Sistema de fatiga simétrico (2026-07-30, deuda técnica: "los NPC siguen eligiendo habilidad
  /// sin restricción de energía" — ver energy.ts) — null = tope completo, mismo criterio lazy que
  /// `condicionFisica` antes de que exista fila: un NPC nunca tocado no necesita fila propia. El
  /// tope real (energiaMaxFor(constitución)) nunca se persiste aquí, se deriva en caliente igual
  /// que en Save.
  energia         Int?
  /// Rediseño 2026-07-31 (petición explícita: "si no saqueas todo el botón sigue para poder
  /// saquear lo que dejaste") — true = ya se copió TODO su loadout conocido al inventario del
  /// jugador (comparado contra `lootedItemNames`), bloquea "Registrar"/"Saquear todo" de nuevo
  /// sobre el mismo NPC hasta que la partida se reinicie. Antes se marcaba en cuanto se tocaba
  /// CUALQUIER objeto suyo (saqueo parcial perdía el resto para siempre); ahora depende de
  /// `lootedItemNames` cubrir el 100% de `Npc`/`ItemCatalog` asociados.
  saqueado        Boolean         @default(false)
  /// Nombres de objeto YA copiados al inventario del jugador de este NPC, en esta partida
  /// (2026-07-31) — permite un saqueo parcial real: dejar algo sin marcar en el modal no lo
  /// pierde, una visita posterior solo ofrece lo que falta y nunca duplica lo ya tomado.
  lootedItemNames String[]        @default([])
  /// Rediseño de combate (2026-08-09, "Analizar rival") — true en cuanto el jugador analiza con
  /// éxito a ESTE npc/scope concreto una vez, para siempre en esta partida (no hace falta
  /// repetirlo en el siguiente combate: el atributo recomendado es un dato fijo de sus
  /// `attributes`, no cambia entre encuentros). Gatea qué muestra la ficha del rival en combate
  /// (CombatPanel.tsx § EnemyFicha) — sin analizar, ni estadísticas ni habilidades.
  analizado       Boolean         @default(false)
  /// docs/19-post-combate-y-recompensas-mision.md pieza 2 (2026-08-13) — `fictionalMinutes` (no
  /// tiempo real, el reloj del mundo se pausa cuando el backend está parado) del momento en que
  /// `condicionFisica` pasó a su valor ACTUAL. Solo se usa cuando el valor actual es INCAPACITADO
  /// (recupera a HERIDO a las 6h) o MUERTO (el cadáver desaparece a las 48h) — se rellena siempre
  /// que cambia por simplicidad, aunque para ILESO/HERIDO/GRAVE no se lea nunca.
  condicionFisicaSinceMinutes Int?
  updatedAt       DateTime        @updatedAt

  @@unique([saveId, npcId, scope])
}

/// Catálogo cerrado de objetos del mundo (armas, herramientas, materiales, consumibles,
/// documentos, objetos de valor narrativo). Sin bonificadores ni stats (decisión de
/// mecánicas 6): description es contexto para el Narrador. Sembrado desde worldCatalog.ts.
model ItemCatalog {
  id          String  @id @default(cuid())
  worldId     String
  world       World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  /// Categoría libre ("arma", "herramienta", "ropa", "material", "consumible",
  /// "medicinal", "documento", "valor") — organiza el catálogo, no es mecánica
  category    String
  /// Categorización mecánica real (2026-07-29) — ver comentario del enum ItemTipo. `category`
  /// (arriba) sigue siendo el subtipo fino DENTRO de este tipo, no se sustituye.
  tipo        ItemTipo
  /// Solo en armas/escudos (2026-07-29, sistema de habilidades por arma) — decide qué habilidad
  /// de ataque/defensa genera este objeto al equiparlo, ver weaponAbilities.ts. Null en el resto
  /// del catálogo (herramientas, ropa, consumibles...).
  tipoArma    WeaponCategory?
  description String
  /// Formas reales de referirse al objeto ("hacha", "el cuchillo"...) — mismo campo y mismo
  /// propósito que Npc.aliases/Location.aliases: sin esto, tanto la Enciclopedia progresiva
  /// (entityDiscovery.ts) como el texto clicable de narración (enciclopediaIndex.ts, frontend)
  /// solo reconocían el nombre EXACTO y completo de catálogo — "mi hacha" nunca enganchaba con
  /// "Hacha de guerra rota" (auditoría 2026-07-30, "revisar partida"). Default `[]` en vez de
  /// obligatorio: la inmensa mayoría de objetos no necesita ninguno (su nombre ya es corto y
  /// único, o no se presta a sinónimos seguros sin colisionar con otro objeto del catálogo).
  aliases     String[] @default([])
  /// Ranura de equipo real (2026-07-30, petición explícita: "hay que categorizarlos por las
  /// partes equipables, para que no pueda poner un casco en los pies") — solo en objetos
  /// `tipo: EQUIPABLE`, null en el resto (nunca se equipan). Familia, no ranura exacta a rajatabla:
  /// ARMA_PRINCIPAL vale también para ARMA_SECUNDARIA y viceversa (cualquier arma va en cualquier
  /// mano), ANILLO_1 vale también para ANILLO_2 (ver `equipSlotFamily`, equipment.ts) — el resto
  /// de ranuras son 1:1 exactas.
  equipSlot   EquipSlot?
  /// Bonificadores mecánicos reales al equipar (2026-07-19, mismo mecanismo que InventoryItem;
  /// mapa múltiple desde 2026-08-03 — sustituye a statBonusAttribute/statBonusAmount, un solo par
  /// no dejaba a un objeto sumar, p.ej., fuerza Y defensa a la vez) — hoy sobre todo en armas
  /// (categoría "arma") y armadura; el resto del catálogo sigue siendo puramente narrativo.
  /// Partial<Record<Attribute | 'defensa', number>> (ver StatBonusMap, equipment.ts). Se copia a
  /// InventoryItem.statBonuses al materializarse por saqueo/despiece.
  statBonuses Json?
  /// Medidas físicas aproximadas en texto libre (2026-07-22, "para los objetos sus medidas y su
  /// lugar de origen... que eso se refleje en los prompts") — p.ej. "hoja de 45 cm, mango de 15
  /// cm". Texto libre porque la forma de medir varía demasiado entre categorías (arma, ropa,
  /// consumible...) para forzar un único campo numérico.
  dimensiones String?
  /// Lugar/pueblo/región de origen o fabricación, cuando aporta algo al lore (p.ej. "manufactura
  /// goirnte, Meseta del Orden"). Null en objetos sin origen especial (p.ej. un cuchillo genérico).
  lugarOrigen String?
  /// Nivel de rareza/dificultad (1-5, sesión de diseño 2026-07-23) — "Craftable", mismo concepto
  /// que ConstructionRecipe.tier (construction.ts). Default 1 = objeto común, sin requisito real.
  tier        Int      @default(1)
  /// Requisitos mínimos de atributo del PJ para EQUIPAR este objeto (Partial<Record<Attribute |
  /// SecondaryAttribute, number>>, ver requisitos.ts) — comprobación de UMBRAL pura en
  /// PATCH /saves/:id/inventario/:itemId, nunca una tirada. Null = sin requisito.
  requisitos  Json?
  /// Tope real de curación al usar este objeto (2026-07-29, "si sales de un combate Incapacitado,
  /// tendrás que usar objetos específicos para volver a Herido o pasar directo a Ileso"): solo
  /// tiene sentido en objetos `category: "medicinal"` — descansar/comer SIN objeto solo llega a
  /// HERIDO y no hace nada si ya estás INCAPACITADO (ver death.ts § healCeilingFor); un objeto
  /// médico con este campo puesto rompe ese tope, incluso desde INCAPACITADO. Null = el objeto no
  /// cura condición física (la inmensa mayoría del catálogo, incluido el resto de "medicinal" que
  /// no cura de verdad, como el contraveneno).
  curaHasta   CondicionFisica?
  /// Primeros auxilios (2026-08-13, petición explícita: objetos "básicos" que solo mejoran UN
  /// escalón de condición desde donde estés, nunca de golpe hasta `curaHasta` como los objetos
  /// normales) — con esto en `true`, `curaHasta` deja de ser un tope absoluto y pasa a ser el
  /// MEJOR resultado posible con este objeto (nunca peor que un escalón por encima de la
  /// condición actual). Ver `healCeilingFor` (death.ts) para la fórmula real. `false`/`null` =
  /// comportamiento de siempre (rompe el tope de golpe, incluso desde INCAPACITADO) — el resto
  /// del catálogo (alquimista y superiores) sigue así a propósito.
  curaUnPaso  Boolean          @default(false)
  /// Cantidad de energía que restaura al usarlo (2026-07-29, sistema de fatiga) — mismo criterio
  /// que `curaHasta` pero numérico (la energía es un pool 0..max, no un enum con pasos fijos).
  /// Null = el objeto no restaura energía.
  curaEnergia Int?
  /// Clave estable del efecto especial (2026-08-03, `tipo: ESPECIAL`) — un identificador que un
  /// sistema concreto del juego consulta para activar su propio comportamiento (p.ej.
  /// `'reveal-map-llanuras'` para MapaPanel.tsx). Texto libre a propósito, como `sourceSlug` en
  /// HarvestYield: no hay (ni tiene sentido crear) un enum cerrado de "todos los efectos
  /// especiales posibles" — cada sistema que consuma una clave nueva la define y la documenta
  /// donde vive ese sistema, no aquí. Null en el resto del catálogo (tipo != ESPECIAL).
  effectKey         String?
  /// Texto explicando el efecto en español llano, para mostrar en un sitio propio y diferenciado
  /// de `description` (inventario/detalle) — nunca en la narración del Narrador. Null si
  /// `effectKey` también lo es.
  effectDescription String?
  createdAt   DateTime @default(now())

  npcItems NpcItem[]
  yields   HarvestYield[]

  @@unique([worldId, slug])
}

/// Lo que un NPC lleva encima — la ÚNICA fuente de loot al derrotarlo/registrarlo/comerciar.
model NpcItem {
  id       String      @id @default(cuid())
  npcId    String
  npc      Npc         @relation(fields: [npcId], references: [id], onDelete: Cascade)
  itemId   String
  item     ItemCatalog @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cantidad Int         @default(1)
  /// Personalización de ESTA pieza ("con la marca del Clan Serhu grabada", "mellada") —
  /// el mismo objeto de catálogo puede ser genérico en un NPC y significativo en otro
  notas    String?

  @@unique([npcId, itemId])
}

/// Qué recurso concreto da cada especie/planta al despiezarla o recolectarla — catálogo de
/// mundo. El "loot" de la naturaleza sigue la misma regla que el de los NPCs: es una lista
/// fija que se lee, nunca una tirada ni una invención del modelo. Las especies NO tienen
/// tabla propia: su prosa vive en areas.md/lore chunks; aquí solo la clave textual estable.
model HarvestYield {
  id         String      @id @default(cuid())
  worldId    String
  world      World       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// Clave de la especie ("corredor-de-cauce", "salvia-del-polvo") — string, no FK
  sourceSlug String
  sourceName String
  itemId     String
  item       ItemCatalog @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Cantidad FIJA por pieza/planta — la variación ya la puso la tirada de caza previa
  cantidad   Int         @default(1)
  /// Condición narrativa o de tirada ("cuchillo de deshuello", "extracción cuidadosa:
  /// destreza 15", "solo cadáver ya muerto") — null = sin condición
  condicion  String?
  /// Qué verbo/acción exige harvest.ts para dar este recurso (2026-07-29) — ver comentario del
  /// enum MetodoObtencion. Invariante: todas las filas de un mismo sourceSlug comparten método
  /// (validado en seed-catalog.ts).
  metodoObtencion MetodoObtencion

  @@index([worldId, sourceSlug])
}

/// Control de vida del mundo (2026-07-29, petición explícita: "establecer la población para
/// limitar e ir haciendo un control de la vida en el mundo") — nunca visible para la jugadora,
/// puro control interno. Base para zonas de aparición por probabilidad, extinción, sobrepoblación
/// y migraciones futuras (esta sesión solo sienta los datos, la simulación dinámica es aparte).
enum PopulationTargetType {
  RAZA
  FAUNA
  /// Rediseño de profesiones (2026-08-07) — fuentes de recolección NO-fauna (MINERIA/TALA/
  /// EXTRACCION de HarvestYield: vetas de mineral, matorrales, etc.). `targetSlug` =
  /// `HarvestYield.sourceSlug`. Permite saber determinísticamente qué hay disponible en la región
  /// del jugador al pulsar "Explorar" en una habilidad de recolección, sin pasar por el Narrador.
  RECURSO
}

/// Dos ejes DELIBERADAMENTE separados (decisión de diseño explícita de la usuaria, 2026-07-29):
/// `poblacion`/`poblacionMax` es la salud demográfica (sube/baja por nacimientos, muertes,
/// extinción, sobrepoblación — un único número global, nunca partido por región). `distribucion`
/// es dónde está repartida AHORA MISMO esa misma población (pesos relativos por región, no un
/// conteo fijo) — migrar no resta de un cubo y suma a otro, solo desplaza estos pesos, dejando
/// intacto el número global. Los 3 clanes orcos (Llanuras/Cristal Helado/Ciénaga) son 3 filas
/// realmente separadas a propósito (confirmado por la usuaria: son sub-razas ya adaptadas a su
/// región, biología distinta entre ellas — no fluyen entre sí salvo guerra o evento de mundo muy
/// concreto), cada una con su propia `distribucion` de un solo peso 100%.
model WorldPopulation {
  id      String @id @default(cuid())
  worldId String
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  targetType PopulationTargetType
  /// Slug de raza (berigLore.ts) o de fauna (Npc.slug) — string suelto, mismo criterio laxo que
  /// professionId en ProfessionProgress, sin FK real (razas no son fila de BD). Los 3 clanes
  /// orcos usan slugs propios (`orcos-llanuras`/`orcos-cristal-helado`/`orcos-cienaga`), no
  /// `orcos` a secas, precisamente porque son 3 filas distintas.
  targetSlug String
  /// Etiqueta legible para logs/debug — nunca la ve la jugadora, esto es control interno puro.
  label String

  poblacion    Int
  /// Techo de referencia para cálculos futuros de crecimiento/sobrepoblación — no es un límite
  /// duro hoy, solo el punto contra el que comparar `poblacion`.
  poblacionMax Int

  /// Pesos relativos por región ({ "Llanuras del Viento Rojo": 0.7, "Cristal Helado": 0.3, ... },
  /// suman ~1.0) — de aquí saldrá la probabilidad de aparición por zona cuando exista esa
  /// mecánica. Migrar un día solo reescribe este Json, nunca `poblacion`.
  distribucion Json

  updatedAt DateTime @updatedAt

  /// Cooldown de recolección (bug real jugando en vivo, 2026-08-07: "puedo darle a minar
  /// indefinidamente sin moverme de la zona") — solo se rellena para `targetType: RECURSO`, cuándo
  /// se recolectó esta fuente por última vez de verdad (`recolectar.ts`). `null` = nunca
  /// recolectada, o fuera de cooldown desde hace tiempo. No afecta a FAUNA/RAZA (esas no pasan por
  /// `recolectar.ts`, se depliezan al morir, no al "recolectar" repetidamente en el sitio).
  lastHarvestedAt DateTime?
  /// Dónde se recolectó por última vez (bug real jugando en vivo, 2026-08-13: "avanzo por la
  /// hondonada buscando más elementos... ahí sí que debería poder volver a usarla" — el cooldown
  /// de arriba era puramente de reloj, sin memoria de sitio, así que moverte a otra Location no
  /// servía de nada). El guard de `recolectar.ts` ahora pasa si CUALQUIERA de las dos condiciones
  /// se cumple: pasaron los 30 min, O el jugador está en una Location distinta a esta. Compartido
  /// entre partidas igual que `poblacion`/`lastHarvestedAt` (mismo criterio ya aceptado para esta
  /// fila) — en la práctica solo importa para la partida real de la jugadora.
  lastHarvestedLocationId String?

  @@unique([worldId, targetType, targetSlug])
}

/// Resúmenes por capítulos — memoria de partida para no perder coherencia en partidas largas (riesgo 1 del análisis).
model SessionSummary {
  id             String   @id @default(cuid())
  saveId         String
  save           Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  chapterNumber  Int
  summary        String
  createdAt      DateTime @default(now())

  @@index([saveId, chapterNumber])
}

/// Prompt de generación de imagen (en inglés, listo para pegar en cualquier generador externo)
/// para una entrada del catálogo del mundo — roadmap de API de imágenes (2026-07-21/22, checklist
/// punto 7). Primera pasada: solo TEXTO del prompt, sin renderizar nada todavía (decisión
/// explícita de la usuaria) — tabla genérica por (worldId, entityType, entitySlug, sizeProfile) en
/// vez de una columna por modelo (Npc/ItemCatalog/etc.) porque fauna/flora no tiene tabla propia
/// (vive como sourceSlug/sourceName repetido en HarvestYield) y las habilidades de clase son
/// contenido estático en código (classAbilities.ts/startingAbilities.ts, sin fila de BD) — una
/// tabla aparte cubre los cuatro tipos sin tocar cada modelo.
model ImagePrompt {
  id         String   @id @default(cuid())
  worldId    String
  world      World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// 'npc' | 'item' | 'fauna' | 'ability' — qué catálogo referencia entitySlug
  entityType String
  /// slug real (Npc.slug/ItemCatalog.slug/HarvestYield.sourceSlug) o nombre slugificado
  /// (habilidades, que no tienen slug propio en código)
  entitySlug String
  /// 'thumbnail' (miniatura cuadrada de EntryCard, cuadrícula de la Enciclopedia) | 'banner'
  /// (MediaSlot ancho de DetailModal, ~3:1 — medido en la UI real, no una talla inventada). Cada
  /// perfil tiene su propia instrucción de encuadre en imagePromptGenerator.ts y se genera/cachea
  /// por separado (petición explícita de la usuaria, 2026-07-22: "1 a 1", nunca las dos de golpe).
  sizeProfile String
  prompt     String
  /// Qué proveedor lo generó ("cerebras:gpt-oss-120b", "ollama:qwen2.5:1.5b-instruct"...) — para
  /// poder distinguir calidad si hace falta regenerar solo lo que cayó al fallback local.
  provider   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([worldId, entityType, entitySlug, sizeProfile])
}

/// Captura en vivo de turnos reales para el pipeline DPO (plan "IA local propia", fase 2 — pares
/// de preferencia chosen/rejected para DPOTrainer, en paralelo al pipeline SFT existente de
/// generate-distillation-dataset.ts). Por cada turno narrado en vivo por el modelo local
/// (narrador.ts), se dispara en segundo plano una llamada al MISMO prompt contra un profesor cloud
/// (completeCloudOnly) — si la respuesta cloud pasa los mismos detectores/validación que protegen
/// producción, queda marcada como candidata a exportación junto con la salida local YA calculada
/// (nunca se vuelve a llamar a Ollama solo para comparar). Sin relación FK a Save/World a
/// propósito: los datos de entrenamiento deben sobrevivir a que la partida se borre/reinicie.
model LiveTeacherCapture {
  id      String @id @default(cuid())
  /// Sin @relation a propósito (ver comentario de arriba) — dato de solo referencia/auditoría,
  /// nunca un JOIN real; así borrar/reiniciar un Save no arrastra ni bloquea estas filas.
  saveId  String
  worldId String

  /// Texto EXACTO enviado como "system" a completeCloudOnly (mismo bloque SYSTEM del Modelfile
  /// que usa producción/generate-distillation-dataset.ts) — guardado tal cual para que el export
  /// DPO no dependa de que el Modelfile no haya cambiado entre la captura y la exportación.
  systemPrompt String
  /// Texto EXACTO enviado como "user" — prompt de buildNarrationPrompt + el bloque de formato
  /// JSON Schema (mismo patrón que buildTeacherUserContent en modelfileSystemPrompt.ts).
  userContent String

  /// Salida cruda del profesor cloud (puede incluir fences markdown sin limpiar todavía).
  cloudRawText String
  /// Proveedor real que respondió ("gemini:gemini-flash-latest", "groq:llama-3.3-70b-versatile"...).
  cloudProvider String
  /// true si cloudRawText, tras extractJsonPayload + JSON.parse, pasó validateSchema + runDetectors
  /// (los MISMOS detectores que protegen producción). Solo las filas con true son candidatas de
  /// exportación DPO — se guardan también los rechazos (false) para poder auditar cuánto alucina
  /// cada proveedor sin descartar la fila entera de la tabla.
  cloudValid Boolean
  /// Motivo de rechazo si cloudValid es false (mismo string que devuelven validateSchema/
  /// runDetectors) — null si cloudValid es true. Solo diagnóstico, nunca se exporta.
  cloudRejectReason String?

  /// Salida local YA calculada por narrateAction para este turno real — "for free", nunca una
  /// segunda llamada a Ollama solo para esta captura.
  localNarrationJson Json
  /// Modelo local que produjo localNarrationJson (env.ollamaModelNarrador en el momento de la
  /// captura) — útil para descartar/filtrar filas si el narrador local cambia de versión entre
  /// capturas (p. ej. tras promocionar tarkor-narrador-v2).
  localModel String

  /// Export/consumo (para que re-ejecutar el script de export no duplique filas).
  exportedAt DateTime?

  createdAt DateTime @default(now())

  @@index([saveId])
  @@index([cloudValid, exportedAt])
}
