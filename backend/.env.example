# Copia este archivo a .env y rellena los valores reales. .env nunca se sube al repo.

# Postgres LOCAL vía podman (migración local-first 2026-07-30, ver docs/15-instalacion.md) — juego
# de un solo jugador en un solo dispositivo, sin motivo para depender de una DB remota. Contenedor
# `tarkor-postgres` (imagen pgvector/pgvector:pg16, necesaria por el embedding vector(768) del RAG
# de lore), volumen `tarkor-postgres-data`. Sin pooler: DATABASE_URL y DIRECT_URL son la misma URL.
DATABASE_URL="postgresql://tarkor:tarkor@localhost:5432/tarkor"
DIRECT_URL="postgresql://tarkor:tarkor@localhost:5432/tarkor"

# Alternativa: Supabase remoto (solo si de verdad hace falta jugar desde varios dispositivos a la
# vez con la misma partida — si no, prefiere siempre el Postgres local de arriba).
# DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

PORT=3001

# Ollama local
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL_NARRADOR="tarkor-narrador"
OLLAMA_MODEL_CRONISTA="qwen2.5:1.5b-instruct"
OLLAMA_MODEL_SUGERENCIAS="qwen3.5:4b"
OLLAMA_KEEP_ALIVE="5m"

# Ritmo de generación en sesión activa (decisión técnica 5) — ver docs/03-arquitectura.md § 7bis.
# Bajado de 3000/10000 a 1000/5000 (2026-08-07, a petición explícita de la usuaria).
PACING_MIN_MS=1000
PACING_MAX_MS=5000

# Frecuencia del worker de fondo (minutos) — decisión técnica 3. Bajado de 20 a 2 (roadmap
# 2026-07-20/21) y de 2 a 1 (2026-08-07, a petición explícita de la usuaria, con
# TRANSIT_MAX_REAL_MINUTES ya bajado también): con 20 min, un tránsito corto podía quedarse
# esperando de más sin motivo real.
WORLD_TICK_INTERVAL_MINUTES=1

# Techo duro de espera real para una acción extendida/larga SIN desplazamiento (descansar,
# construir, crafteo largo) — roadmap 2026-07-20/21, bajado de 30 a 10 y de 10 a 5 el 2026-08-07.
# Desde 2026-08-31 ya NO gobierna viajes (ver TRAVEL_SEGUNDOS_* abajo).
TRANSIT_MAX_REAL_MINUTES=5

# Espera real de un VIAJE por número de tramos cruzados, no por duración de ficción acumulada
# (2026-08-31, petición explícita: "minimo tiempo de viaje 1 min... cada punto suma segundos...
# hasta un maximo de 5mins"). 1er tramo = TRAVEL_SEGUNDOS_PRIMER_TRAMO, cada tramo extra suma
# TRAVEL_SEGUNDOS_POR_TRAMO_EXTRA, con techo TRAVEL_SEGUNDOS_MAXIMOS.
TRAVEL_SEGUNDOS_PRIMER_TRAMO=60
TRAVEL_SEGUNDOS_POR_TRAMO_EXTRA=30
TRAVEL_SEGUNDOS_MAXIMOS=300

# Eventos de viaje interactivos (2026-08-05) — probabilidad por CADA nodo intermedio de un viaje
# largo de que ese tramo interrumpa el viaje con un encuentro real (combate/mercader/misión)
TRAVEL_INTERRUPTION_PROBABILITY_PER_SEGMENT=0.18

# API de prompts de imagen (checklist 2026-07-21/22, punto 7) — rotación con failover entre
# proveedores cloud gratuitos, mismo patrón que VeriNews_AI. Todas opcionales: el proveedor sin
# clave se salta solo, y si fallan todos (o no hay ninguna configurada) cae a Ollama local, así
# que la función nunca deja de funcionar. IMPORTANTE: genera claves NUEVAS y propias de este
# proyecto — nunca reutilices las de VeriNews_AI, esa cuota está reservada para esa app.
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-large-latest"
SAMBANOVA_API_KEY=""
SAMBANOVA_MODEL="DeepSeek-V3.1"
CLOUDFLARE_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# Gemini (2026-08-07) — API propia de Google (no OpenAI-compatible), añadida a la misma rotación.
# Genera tu clave en https://aistudio.google.com/apikey — igual que el resto, opcional.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Groq (2026-08-07) — OpenAI-compatible, aloja modelos open-weight a velocidad muy alta con tier
# gratuito generoso. Genera tu clave en https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Captura en vivo para el pipeline DPO (plan "IA local propia", fase 2) — apagado por defecto.
# Activar solo cuando quieras recolectar pares chosen/rejected jugando partidas reales; consume
# la MISMA cuota gratuita cloud que generate-distillation-dataset.ts.
LIVE_TEACHER_CAPTURE_ENABLED="false"
LIVE_TEACHER_CAPTURE_SAMPLE_RATE=0.3
