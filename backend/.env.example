# Copia este archivo a .env y rellena los valores reales. .env nunca se sube al repo.

# Conexión a Supabase vía poolers (IPv4) — pestaña "Get Connected" > "ORM" > Prisma en el dashboard.
# DATABASE_URL: pooler de transacciones (6543) — la usa la app en tiempo de ejecución.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: pooler de sesión (5432) — el que necesitan las migraciones de Prisma.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

PORT=3001

# Ollama local
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL_NARRADOR="tarkor-narrador"
OLLAMA_MODEL_CRONISTA="llama3.2:latest"
OLLAMA_KEEP_ALIVE="5m"

# Ritmo de generación en sesión activa (decisión técnica 5) — ver docs/03-arquitectura.md § 7bis
PACING_MIN_MS=3000
PACING_MAX_MS=10000

# Frecuencia del worker de fondo (minutos) — decisión técnica 3
WORLD_TICK_INTERVAL_MINUTES=20
