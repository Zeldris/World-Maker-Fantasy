# Lo pesado y lo que depende de esta máquina no se sube: se descarga siguiendo
# docs/arquitectura/reutilizables/01-generacion-imagenes-local.md (pasos 0 y 3).
bin/
descargas/
modelos/
# Salidas de las pruebas (imágenes, logs, prompts): se regeneran con scripts/probar.sh.
pruebas/
# Imágenes elegidas en la interfaz (CFG-43), con la estructura de backend/uploads/images/: se copian a mano al juego.
salida/
referencias/
# Todo lo generado por elemento (CFG-43): generated/<tipo>/<slug>/ con intentos/, prompts/, logs/, registro.tsv, notas.md y la elegida
# (<slug>-<perfil>.png, el nombre del juego: se copia a backend/uploads/images/<tipo>/ a mano).
generated/
# IMG-18: rasterizados de los bocetos SVG (pequeños y deterministas); se regeneran con bocetos/rasterizar.sh.
bocetos/*.png
