#!/bin/bash
# Envoltorio para la Deck: pg_restore dentro del contenedor. Formas admitidas: sin argumentos o con `< dump` (el stdin pasa
# tal cual), y `pg_restore [opciones] <archivo>` o `--list <archivo>`: si el último argumento es un archivo que existe, se
# quita de la orden y entra por stdin (el contenedor no ve el disco del host). Con `-d`/`-f` a un archivo, usar stdin.
if [ $# -gt 0 ] && [ -f "${@: -1}" ]; then
  f="${@: -1}"
  exec podman exec -i tarkor-postgres pg_restore "${@:1:$#-1}" < "$f"
fi
exec podman exec -i tarkor-postgres pg_restore "$@"
