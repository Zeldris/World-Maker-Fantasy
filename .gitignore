# backend/ y frontend/ tienen su propio .gitignore (node_modules, dist, .env).
# Este cubre solo lo que podría aparecer a nivel raíz.
.DS_Store
Thumbs.db

# Logs de arranque de dev-server lanzado desde la raíz — artefacto local, no fuente.
logs/

# node_modules suelto a nivel raíz (no hay package.json aquí — artefacto de alguna herramienta
# lanzada desde la raíz, no del proyecto en sí; backend/frontend tienen el suyo propio arriba).
/node_modules/

# Configuración local de Claude Code (permisos de sesión, locks) — específica de esta máquina,
# no del proyecto. Las skills del proyecto (`.claude/skills/`) sí se versionan (2026-10-04).
.claude/*
!.claude/skills/

# Playwright que usa Claude para jugar el frontend real y hacer pruebas en vivo — herramienta de
# Claude, no dependencia del juego. node_modules/browsers propios, scripts .mjs sueltos y capturas
# se quedan fuera de control de versiones; persiste entre sesiones para no reinstalar cada vez.
tools/playwright-e2e/

# Comprobador de enlaces de lore — herramienta de Claude, no del juego.
tools/lore-links/
