# backend/ y frontend/ tienen su propio .gitignore (node_modules, dist, .env).
# Este cubre solo lo que podría aparecer a nivel raíz.
.DS_Store
Thumbs.db

# Logs de arranque de dev-server lanzado desde la raíz — artefacto local, no fuente.
logs/

# node_modules suelto a nivel raíz (no hay package.json aquí — artefacto de alguna herramienta
# lanzada desde la raíz, no del proyecto en sí; backend/frontend tienen el suyo propio arriba).
/node_modules/

# Configuración local de Claude Code (permisos de sesión, locks) — específica de esta máquina,
# no del proyecto. Lo compartido entre las dos cuentas sí se versiona (QA-112): un archivo nuevo de una skill
# o un gancho se añade con `git add` normal, sin `-f` (que arrastraba también los `__pycache__`).
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/

# Playwright que usa Claude para jugar el frontend real y hacer pruebas en vivo (QA-30, retro del
# 2026-10-09): los scripts se versionan para que las dos cuentas los compartan; se quedan fuera lo
# pesado y lo que se regenera (dependencias, navegadores, capturas y registros).
tools/playwright-e2e/node_modules/
tools/playwright-e2e/browsers/
tools/playwright-e2e/**/*.png
tools/playwright-e2e/**/*.jpg
tools/playwright-e2e/**/*.jpeg
tools/playwright-e2e/**/*.webm
tools/playwright-e2e/**/*.log

# Comprobador de enlaces de lore — herramienta de Claude, no del juego.
tools/lore-links/

# Salida del MCP de Playwright (capturas y registros de las rondas de pruebas).
.playwright-mcp/
tools/playwright-e2e/driver.token
tools/playwright-e2e/shots/
.claude/revision-main.sha

# Bytecode de Python (los tests de tools/qa los regeneran)
__pycache__/
*.pyc

# Registro por llamada de la IA (opt-ai): datos de la máquina, no se suben
backend/ia/registro-*.jsonl
