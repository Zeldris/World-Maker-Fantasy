{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lore",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 6000
  },
  "agent": {
    "lore": {
      "mode": "primary",
      "model": "lmstudio/qwen2.5-coder-7b-instruct",
      "prompt": "{file:./.opencode/prompts/narrador-lore.txt}",
      "permission": {
        "edit": {
          "*": "deny"
        },
        "bash": "deny",
        "webfetch": "deny",
        "task": {
          "*": "deny",
          "escritor": "allow"
        }
      },
      "tools": {
        "bash": false,
        "task": true,
        "todowrite": false,
        "todoread": false,
        "webfetch": false,
        "patch": false,
        "skill": false,
        "write": false
      }
    },
    "escritor": {
      "mode": "all",
      "model": "lmstudio/qwen2.5-coder-7b-instruct",
      "prompt": "{file:./.opencode/prompts/escritor-lore.txt}",
      "permission": {
        "edit": {
          "*": "deny",
          "docs/borradores-opencode/propuestas-lore.md": "allow"
        },
        "bash": "deny",
        "webfetch": "deny"
      },
      "tools": {
        "bash": false,
        "task": false,
        "todowrite": false,
        "todoread": false,
        "webfetch": false,
        "patch": false,
        "skill": false,
        "glob": false,
        "grep": false
      }
    }
  }
}
