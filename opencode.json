{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lore",
  "agent": {
    "lore": {
      "mode": "primary",
      "model": "lmstudio/qwen3-8b",
      "prompt": "{file:./.opencode/prompts/narrador-lore.txt}",
      "permission": {
        "edit": {
          "*": "deny",
          "docs/borradores-opencode/propuestas-lore.md": "allow"
        },
        "bash": "deny",
        "webfetch": "deny"
      }
    }
  }
}
