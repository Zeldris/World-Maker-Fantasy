{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "narrador-lore",
  "plugin": [
    "opencode-ollama-toolcall-proxy"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 1800000,
        "chunkTimeout": 1800000,
        "headerTimeout": 1800000
      },
      "models": {
        "qwen35-9b-32k:latest": {
          "name": "Qwen3.5 9B (32k)",
          "tools": true,
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "options": {
            "keep_alive": -1
          }
        }
      }
    }
  },
  "agent": {
    "narrador-lore": {
      "mode": "primary",
      "model": "ollama/qwen35-9b-32k:latest",
      "temperature": 0.15,
      "maxSteps": 7,
      "prompt": "{file:./.opencode/prompts/narrador-lore.txt}",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny"
      },
      "tools": {
        "read": true,
        "glob": false,
        "grep": false,
        "edit": false,
        "write": false,
        "bash": false,
        "task": false,
        "webfetch": false,
        "patch": false,
        "skill": false
      }
    }
  }
}
