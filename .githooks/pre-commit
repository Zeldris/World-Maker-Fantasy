#!/bin/bash
# QA-144 (retro del 2026-10-20, §5): un `git add docs/` de Claude Code metió los borradores sin commitear de
# Álvaro (`docs/borradores-opencode/`). Con CLAUDECODE=1 no se commitea nada de ahí; fuera de Claude Code
# (Álvaro) este gancho no hace nada. Lo activa core.hooksPath=.githooks.
set -euo pipefail
[ "${CLAUDECODE:-}" = "1" ] || exit 0
# Cerrar un merge, un cherry-pick o un rebase: el borrador ya viene commiteado de la otra rama, y eso pasa. Pero un
# `git add docs/` al resolver un conflicto también puede meter un borrador sin commitear: se rechazan los archivos
# cuyo contenido preparado difiere a la vez de HEAD y del *_HEAD (los que vienen tal cual de la otra rama pasan).
otras=()
for f in MERGE_HEAD CHERRY_PICK_HEAD REBASE_HEAD; do
  [ -e "$(git rev-parse --git-path "$f")" ] && otras+=("$f")
done
# --no-renames: un archivo movido fuera de la carpeta sale como borrado en la ruta de origen y también se para.
preparados=$(git diff --cached --no-renames --name-only -- docs/borradores-opencode/)
if [ -n "$preparados" ] && [ "${#otras[@]}" -gt 0 ]; then
  blob() { git rev-parse -q --verify "$1" 2>/dev/null || echo ausente; }
  filtrados=""
  while IFS= read -r ruta; do
    [ -n "$ruta" ] || continue
    staged=$(blob ":$ruta"); cabeza=$(blob "HEAD:$ruta"); propio=""
    [ "$staged" = "$cabeza" ] && continue
    for o in "${otras[@]}"; do
      [ "$staged" = "$(blob "$o:$ruta")" ] && propio=1
    done
    [ -n "$propio" ] || filtrados+="$ruta"$'\n'
  done <<< "$preparados"
  preparados=${filtrados%$'\n'}
fi
if [ -n "$preparados" ]; then
  echo "pre-commit: hay archivos preparados de docs/borradores-opencode/ (son borradores de Álvaro, no se commitean desde Claude Code):" >&2
  echo "$preparados" | sed 's/^/  /' >&2
  echo "Sácalos con: git restore --staged docs/borradores-opencode/" >&2
  exit 1
fi
