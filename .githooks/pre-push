#!/bin/bash
# QA-13 (retro de la Fase D del 0.3): no se sube nada que no tipa o no pasa el lint. La CI solo corre
# en el PR, al final de un tramo de varias tareas; esto lo para en el push. Lo activa
# `.claude/hooks/session-start.sh` (core.hooksPath). Saltarlo solo para un `WIP:` con tests en rojo:
# `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Los mismos comandos que la CI (ci.yml), con el oxlint que fija cada paquete.
echo "pre-push: tsc y lint de backend y frontend, cobertura del roadmap…"
# El cliente de Prisma se regenera antes de tipar: tras traer un cambio de esquema (p. ej. una columna
# nueva) el cliente viejo da errores de tipos que no son del código (pasó el 2026-10-09).
(cd backend && npx prisma generate > /tmp/pre-push-prisma.log 2>&1 && npx tsc --noEmit -p . && npm run --silent lint > /tmp/pre-push-lint-backend.log 2>&1) || { tail -20 /tmp/pre-push-lint-backend.log 2>/dev/null; echo "pre-push: backend en rojo"; exit 1; }
(cd frontend && npx tsc -b && npm run --silent lint > /tmp/pre-push-lint-frontend.log 2>&1) || { tail -20 /tmp/pre-push-lint-frontend.log 2>/dev/null; echo "pre-push: frontend en rojo"; exit 1; }
python3 tools/roadmap/cobertura.py > /tmp/pre-push-cobertura.log || { grep -v "^EN VARIOS HITOS\|^ASIGNADAS PERO" /tmp/pre-push-cobertura.log; exit 1; }
# QA-35 (retro del 2026-10-10): si el push trae imágenes, que cada una lleve el slug de su lugar
# (`imagenesZona.test.ts`, menos de un segundo). Git pasa por la entrada «ref local, sha local, ref
# remota, sha remota» de cada rama que se sube.
cambiados=""
# QA-66 (retro del 2026-10-13): qué commits sube el push. Un commit que no se hizo (una cadena `&&`
# cortada) dejaba un push vacío que también decía «todo en verde».
subidos=""
while read -r _ sha_local _ sha_remoto; do
  [ "$sha_local" = "0000000000000000000000000000000000000000" ] && continue
  # Desde dónde mirar los cambios: lo que ya tiene la rama remota si ese commit está aquí; si no (rama
  # nueva, o la otra cuenta subió y no se ha traído), desde donde se separó de main.
  if [ "$sha_remoto" != "0000000000000000000000000000000000000000" ] && git cat-file -e "$sha_remoto^{commit}" 2>/dev/null; then
    base="$sha_remoto"
  else
    base=$(git merge-base "$sha_local" origin/main 2>/dev/null || echo "")
  fi
  [ -n "$base" ] && cambiados+="$(git diff --name-only "$base" "$sha_local" 2>/dev/null)"$'\n'
  # Commits nuevos de verdad: los que no están en ninguna rama remota conocida.
  subidos+="$(git log --format='  %h %s' "$sha_local" --not --remotes 2>/dev/null)"$'\n'
  # QA-69: la bitácora tal como va en el commit que se sube, no la del directorio de trabajo.
  if git cat-file -e "$sha_local:docs/registros/traspaso.md" 2>/dev/null; then
    git show "$sha_local:docs/registros/traspaso.md" > /tmp/pre-push-bitacora.md
    python3 tools/qa/bitacora.py /tmp/pre-push-bitacora.md || exit 1
  fi
done
if grep -q "^backend/uploads/images/" <<< "$cambiados"; then
  (cd backend && npx vitest run src/scripts/imagenesZona.test.ts > /tmp/pre-push-imagenes.log 2>&1) \
    || { grep -E "Expected|\+ |archivo|mapa" /tmp/pre-push-imagenes.log | head -20; echo "pre-push: hay imágenes con un nombre que no es el de ningún lugar"; exit 1; }
fi
subidos=$(grep -v '^$' <<< "$subidos" || true)
if [ -z "$subidos" ]; then
  echo "pre-push: todo en verde, pero este push no sube ningún commit nuevo (¿se hizo el commit?)."
else
  echo "pre-push: todo en verde. Sube $(wc -l <<< "$subidos") commit(s):"
  echo "$subidos"
fi
