#!/bin/bash
# QA-13 (retro de la Fase D del 0.3): no se sube nada que no tipa o no pasa el lint. La CI solo corre
# en el PR, al final de un tramo de varias tareas; esto lo para en el push. Lo activa
# `.claude/hooks/session-start.sh` (core.hooksPath). Saltarlo solo para un `WIP:` con tests en rojo:
# `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: tsc backend, tsc frontend, oxlint, cobertura del roadmap…"
(cd backend && npx tsc --noEmit -p .)
(cd frontend && npx tsc -p tsconfig.app.json --noEmit)
npx oxlint backend/src frontend/src > /tmp/pre-push-oxlint.log 2>&1 || { tail -20 /tmp/pre-push-oxlint.log; echo "pre-push: oxlint con errores"; exit 1; }
python3 tools/roadmap/cobertura.py > /tmp/pre-push-cobertura.log || { grep -E "SIN HITO|NUEVAS|RETRO" /tmp/pre-push-cobertura.log; exit 1; }
echo "pre-push: todo en verde."
