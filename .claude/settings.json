{
  "permissions": {
    "allow": [
      "Bash(bash tools/qa/escenario.sh:*)",
      "Bash(tools/qa/escenario.sh:*)",
      "Bash(bash tools/qa/host.sh bash tools/qa/escenario.sh:*)",
      "Bash(tools/qa/host.sh bash tools/qa/escenario.sh:*)",
      "Bash(bash tools/qa/host.sh tools/qa/escenario.sh:*)",
      "Bash(tools/qa/host.sh tools/qa/escenario.sh:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/gw/scripts/session-start.sh"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/qa/recuperar.py\" --estado"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/qa/recuperar.py\" --estado"
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/gw/scripts/recuperar.py --estado"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/revision-antes-de-main.sh"
          }
        ]
      },
      {
        "matcher": "^mcp__github__(create_pull_request|merge_pull_request|enable_pr_auto_merge|update_pull_request)$|^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/gw/scripts/revision-antes-de-main.sh"
          }
        ]
      }
    ]
  }
}
